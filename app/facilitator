def style(code, text):
    """ANSI styling only on a terminal, so pipes and logs stay plain."""
    return f"\033[{code}m{text}\033[0m" if sys.stdout.isatty() else text


_after_intro = False


def ok(text):
    global _after_intro
    _after_intro = False
    print(f"{style('38;2;0;114;0', '✓')} {text}")


def skipped(text):
    global _after_intro
    _after_intro = False
    print(f"{style('2', '⊘')} {text}")


def section(title):
    """A bold title, a rule as long as the title, then a blank line."""
    global _after_intro
    _after_intro = True
    print()
    print(style("1", title))
    print("─" * len(title))
    print()


def problem(headline, *next_steps, blank=None):
    """The text for sys.exit: the problem, then each next step indented two
    spaces. A blank line comes first, unless the step intro just before it
    already ended with one; blank=True forces it."""
    lead = "\n" if (not _after_intro if blank is None else blank) else ""
    return lead + "⚠ " + headline + "".join("\n  " + line for line in next_steps)


def cmd_password(args, *, installer=False):
    """Create or replace the password with hidden terminal input only."""
    if not installer and args != ["password", "set"]:
        sys.exit("usage: facilitator password set")
    if not sys.stdin.isatty():
        if installer:
            skipped("No app password was set: there is no interactive terminal.")
            print("Run `facilitator password set` before enabling the phone bridge.")
            return
        sys.exit("password: run this command in an interactive terminal")
    import bridge_auth
    if installer and bridge_auth.configured():
        ok("Existing app password kept. Use it to sign in on your phone.")
        return
    import getpass
    print("Choose a strong password to log into your Facilitator phone app.")
    print("Use at least 11 characters, with a letter, a number and a symbol.")
    # every group after the intro opens with one blank line, so the prompt pair
    # stays together and nothing doubles up or trails at the end
    while True:
        print()
        first = getpass.getpass("App password (input hidden): ")
        try:
            bridge_auth.validate_password(first)
        except ValueError as error:
            print()
            print(error)
            continue
        second = getpass.getpass("Confirm app password (input hidden): ")
        if first != second:
            print()
            print("The passwords did not match. Try both entries again.")
            continue
        bridge_auth.set_password(first)
        print()
        if installer:
            ok("App password confirmed.")
        else:
            print("App password confirmed. Existing phone sessions were signed out.")
        return


def bridge_log(kind, level="info", **fields):
    """One line about the share going up or coming down, in the same shape the
    server writes: a UTC stamp with the date in it, a level, a kind, then that
    kind's own fields. Written here rather than through the server's logger
    because the bridge command is its own process and importing the server
    would open the server's file as a side effect. It never raises: changing
    the sharing is the job and the note about it is not worth failing over.

    The tailnet name is deliberately not among the fields. It is encoded in the
    code the phone scans, where it is needed; in a file that outlives the run it
    is a machine's name and nothing needs it."""
    try:
        named = os.environ.get("FACILITATOR_LOG_LEVEL")
        if not named:
            try:
                named = json.loads(CONFIG.read_text()).get("log_level")
            except Exception:
                named = None
        if str(named or "").strip().lower() == "error" and level != "error":
            return   # the same rule as the server's: errors only writes only errors
        LOG_DIR.mkdir(parents=True, exist_ok=True)
        now = time.time()
        line = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(now))
                      + f".{int(now % 1 * 1000):03d}Z",
                "level": level, "kind": kind}
        line.update({name: value for name, value in fields.items() if value is not None})
        fd = os.open(LOG_DIR / f"bridge-{time.strftime('%Y%m%d')}.log",
                     os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a") as f:
            os.fchmod(fd, 0o600)
            f.write(json.dumps(line) + "\n")
        for old in sorted(LOG_DIR.glob("bridge-*.log"))[:-LOG_KEEP]:
            old.unlink(missing_ok=True)
    except OSError:
        pass


def load_config():
    """The parsed run.config.json; a broken one ends the command with one plain line."""
    if not CONFIG.exists():
        sys.exit(f"no {CONFIG.name} in {DATA}; run ./install.sh, or copy app/run.config.example.json "
                 "there and fill in real lanes")
    try:
        text = CONFIG.read_text()
    except UnicodeDecodeError:
        sys.exit(f"{CONFIG.name} is not UTF-8 text; it should be JSON")
    except OSError as error:
        sys.exit(f"{CONFIG.name} cannot be read: {error.strerror or error}")
    if not text.strip():
        sys.exit(f"{CONFIG.name} is empty; copy run.config.example.json and fill in real lanes")
    try:
        cfg = json.loads(text)
    except ValueError as error:
        sys.exit(f"{CONFIG.name} is not valid JSON: {error}")
    if not isinstance(cfg, dict):
        sys.exit(f"{CONFIG.name} must hold one JSON object, not {json_kind(cfg)}")
    if "port" not in cfg:
        sys.exit(f'{CONFIG.name} has no "port"')
    port = cfg["port"]
    if isinstance(port, bool) or not isinstance(port, (int, str)) or not str(port).isdigit():
        sys.exit(f'{CONFIG.name}: "port" must be a whole number, not {json.dumps(port)}')
    if not 1 <= int(port) <= 65534:
        sys.exit(f'{CONFIG.name}: "port" must be from 1 to 65534, the board using it and the one above, not {port}')
    if "lanes" in cfg and not isinstance(cfg["lanes"], list):
        sys.exit(f'{CONFIG.name}: "lanes" must be a list, not {json_kind(cfg["lanes"])}')
    retired = sorted({lane.get("owner") for lane in cfg.get("lanes", [])
                      if isinstance(lane, dict) and lane.get("owner") in RETIRED_OWNERS})
    if retired:
        names = ", ".join(repr(owner) for owner in retired)
        sys.exit(f"{CONFIG.name} requires owner migration: retired owner {names} is not allowed")
    return cfg


def json_kind(value):
    if isinstance(value, list):
        return "a list"
    if isinstance(value, dict):
        return "an object"
    if isinstance(value, str):
        return "a string"
    if isinstance(value, bool):
        return "true or false"
    if value is None:
        return "null"
    return "a number"


def check_lanes(cfg):
    """Lanes must be objects with an owner; other keys are read where used."""
    if "lanes" not in cfg:
        sys.exit(f'{CONFIG.name} has no "lanes"; copy run.config.example.json and fill in real lanes')
    for index, lane in enumerate(cfg["lanes"], 1):
        if not isinstance(lane, dict):
            sys.exit(f"{CONFIG.name}: lane {index} must be an object, not {json_kind(lane)}")
        if not isinstance(lane.get("owner"), str) or not lane["owner"]:
            sys.exit(f'{CONFIG.name}: lane {index} has no "owner"')


def lane_value(lane, key):
    if key not in lane:
        sys.exit(f'{CONFIG.name}: lane {lane["owner"]} has no "{key}"')
    return lane[key]


def state(port, timeout=2):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/state", timeout=timeout) as f:
            return json.load(f)
    # no answer, an answer that is not JSON, or something on the port that
    # does not speak HTTP at all
    except (OSError, ValueError, http.client.HTTPException):
        return None


VENV = DATA / ".venv"
VENV_PYTHON = VENV / "bin" / "python3"


def server_python():
    """The interpreter the server runs under: data/.venv, which is where
    requirements.txt is installed, or this process's own when
    there is no such folder (a machine whose interpreter already has the
    server's libraries)."""
    return str(VENV_PYTHON) if os.access(VENV_PYTHON, os.X_OK) else sys.executable


def on_app_env():
    """Carry on in the Python of .venv, by running this same command again
    there, unless this already is it. For the commands that need more than the
    python3 this command may have started on: the app password's hash is
    scrypt, which the python3 macOS ships lacks. The variable marks the second
    run, so it happens once."""
    if (os.environ.get("FACILITATOR_APP_ENV") == "1"
            or os.path.realpath(sys.prefix) == os.path.realpath(VENV)):
        return
    broken = problem("The app's environment in data/.venv is missing or broken.",
                     f"Run ./install.sh in {CLONE} to rebuild it, then try again.")
    if not os.access(VENV_PYTHON, os.X_OK):
        sys.exit(broken)
    sys.stdout.flush()
    try:
        os.execve(str(VENV_PYTHON), [str(VENV_PYTHON), str(HERE / "facilitator"), *sys.argv[1:]],
                  {**os.environ, "FACILITATOR_APP_ENV": "1"})
    except OSError:
        sys.exit(broken)


def start_server():
    """The launch itself, in one place so run and restart cannot drift apart:
    the .venv's interpreter when there is one, a session of its own so the
    server outlives the terminal that started it, and output going nowhere
    because the server writes its own dated file and that file is the only
    place its output belongs. The mark of an update the board started stays
    with that update and is not handed to the board it starts."""
    env = {k: v for k, v in os.environ.items() if k != FROM_BOARD_VARIABLE}
    return subprocess.Popen([server_python(), str(HERE / "server.py")],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            start_new_session=True, env=env)


def ensure_server(port, dry):
    """Start the server, with its output going nowhere.

    The server writes its own dated file and that file is the only place its
    output lands; a copy of the same events caught here would be the same log
    twice, in two shapes, in two places. The one thing the file cannot hold is
    a start that dies before the logger exists, since nothing is open to write
    it: a child that is gone this early gets one sentence saying so and how to
    see it, which is running the server by hand where the terminal shows it."""
    if state(port):
        if dry:
            print(f"server: already up on {port}")
        return
    if dry:
        print(f"server: would start {HERE / 'server.py'}")
        return
    said_why(port, launch_server(port))


def launch_server(port):
    """Start the server and wait for the port to answer: "up", "ended" when the
    child was gone before anything answered, "silent" when nothing did in time."""
    started = start_server()
    for _ in range(40):
        if state(port):
            return "up"
        if started.poll() is not None:
            return "ended"
        time.sleep(0.25)
    return "silent"


def said_why(port, started):
    """The one sentence for a start that did not come up, and the end of the
    command; nothing for one that did."""
    if started == "ended":
        sys.exit(f"the server did not start; run {server_python()} {HERE / 'server.py'} "
                 "by hand to see why")
    if started == "silent":
        sys.exit(f"server failed to come up on {port}; see the day's server file in {LOG_DIR}")


# --- where the board listens: its own pair until something else takes it ------
#
# The board listens on a pair, the port run.config.json names and the one above
# it for the phone. While nothing else holds that pair, run starts the board
# there as it always did. When something else holds it, run moves the board to
# the next free pair above it, writes the new port into run.config.json and
# says so in one line; the board then stays on that pair, even once the old one
# is free again, until that one is taken too. This folder's own board is never
# "something else": it is found wherever it answers, by the folder its /state
# names, and nothing is started beside it. restart never moves the board.
DEFAULT_PORT = 8877
PAIR_TRIES = 100        # pairs above a taken one that are looked at for a free one
MOVE_TRIES = 3          # starts on a new pair before run stops trying
SERVER_LOCK = DATA / "server.lock"


def this_board(st):
    """Whether a board's state is this folder's: the server names its
    checkout as pwd, so a board from another checkout names another. A server
    from before data/ named the checkout too, which is what keeps an old
    board running mid-update from being read as somebody else's."""
    pwd = st.get("pwd") if isinstance(st, dict) else None
    return isinstance(pwd, str) and os.path.realpath(pwd) == os.path.realpath(CLONE)


def other_board(st):
    """Whether an answer is a board that names a folder other than this one.
    A board that names none is not counted as another's: that is a server
    older than the field, and the board this run would have started."""
    return isinstance(st, dict) and isinstance(st.get("pwd"), str) and not this_board(st)


def lock_port():
    """The port this folder's running server wrote into server.lock, or None.
    The file outlives the server it names, so it says only where to look."""
    try:
        port = json.loads(SERVER_LOCK.read_text()).get("port")
    except (OSError, ValueError, AttributeError):
        return None
    if isinstance(port, int) and not isinstance(port, bool) and 1 <= port <= 65534:
        return port
    return None


def board_elsewhere(port):
    """The port this folder's board answers on when it is not the configured
    one, or None. Asked only where the lock points, so a board that is simply
    down costs one file read and no request."""
    found = lock_port()
    if found is None or found == port:
        return None
    return found if this_board(board_state(found)) else None


def pair_taken(port):
    """Whether something holds either port of the pair (port, port + 1): a bind
    of exactly the server's shape fails on one of them. That is the question
    the server itself is about to ask, so a pair this calls free is one it can
    have. Asked only once this folder's own board has been looked for."""
    return not (port_binds(port) and port_binds(port + 1))


def serve_targets():
    """Every loopback port a Tailscale Serve proxy points at, read once and
    read only, or nothing when there is no tailscale or it will not answer.
    A pair whose ports are among them is not picked: the server refuses to
    start under a rule on its own port, and a rule on the phone's port would
    hand somebody else's traffic to this board."""
    ts = find_tailscale()
    if ts is None:
        return set()
    try:
        seen = subprocess.run([ts, "serve", "status", "--json"], capture_output=True, text=True,
                              encoding="utf-8", env=tailscale_env(), timeout=TAILSCALE_STATUS_TIMEOUT)
        config = json.loads(seen.stdout) if seen.returncode == 0 else None
    except (OSError, subprocess.SubprocessError, UnicodeError, ValueError):
        config = None
    found = set()

    def walk(value):
        if isinstance(value, dict):
            proxy = value.get("Proxy")
            if isinstance(proxy, str):
                try:
                    target = urlparse(proxy)
                    if target.hostname in ("127.0.0.1", "localhost") and target.port:
                        found.add(target.port)
                except ValueError:
                    pass
            for inner in value.values():
                walk(inner)
        elif isinstance(value, list):
            for inner in value:
                walk(inner)
    walk(config)
    return found


def pick_pair(first, serve=True):
    """The first free pair from first upward, stepping by two so a pair is
    always (p, p + 1), skipping any pair with a port a Serve proxy points at
    unless serve is False; None when PAIR_TRIES pairs are all taken or the
    ports run out."""
    targets = serve_targets() if serve else set()
    for step in range(PAIR_TRIES):
        candidate = first + 2 * step
        if candidate + 1 > 65535:
            return None
        if {candidate, candidate + 1} & targets:
            continue
        if not pair_taken(candidate):
            return candidate
    return None


def config_with(text, port, moved_from):
    """run.config.json's text with port set and moved_from set (a port) or
    taken away (None). Only the port's own value is replaced in the text, so
    the file keeps its spacing and its order; the result is read back and has
    to be the old config with just those changed, or the whole config is
    written out as JSON instead."""
    cfg = json.loads(text)
    want = {**cfg, "port": port}
    if moved_from is None:
        want.pop("moved_from", None)
    else:
        want["moved_from"] = moved_from
    kept, count = re.subn(r'("port"\s*:\s*)("?\d+"?)', lambda m: m.group(1) + str(port), text, count=1)
    try:
        if count == 1 and json.loads(kept) == want:
            return kept
    except ValueError:
        pass
    return json.dumps(want, indent=2) + "\n"


def write_config_port(port, moved_from=None):
    """The board's port into run.config.json, every other key kept: a temp file
    beside it with the file's own permissions, then one rename."""
    text = CONFIG.read_text()
    mode = os.stat(CONFIG).st_mode & 0o777
    tmp = CONFIG.with_name(CONFIG.name + ".tmp")
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(config_with(text, port, moved_from))
        os.chmod(tmp, mode)
        os.replace(tmp, CONFIG)
    except OSError as error:
        tmp.unlink(missing_ok=True)
        sys.exit(f"could not write the board's port into {CONFIG.name}: {error.strerror or error}")


def place_board(port, dry):
    """Where the board is, starting it when it is not up: (port, moved_from),
    moved_from being the port of the pair the board moved off, or None.

    The first look is the one run has always made, /state on the configured
    port. A board answering there is the board unless it names another folder;
    an answer that is not a board at all is something else. When no board of
    this folder's answers there, it may still be up on another pair (the
    config changed under it): then that is where the board is, the config is
    brought to it, and nothing is started. When nothing holds the pair, the
    board starts there. Otherwise the pair is taken and the board moves."""
    st = board_state(port)
    if st and not other_board(st):
        if dry:
            print(f"server: already up on {port}")
        return port, None
    found = board_elsewhere(port)
    if found is not None:
        if dry:
            print(f"server: already up on {found}; would write {found} into {CONFIG.name}")
        else:
            write_config_port(found)
            print(f"This board was already running on port {found}; {CONFIG.name} now says {found}.")
        return found, None
    if not st and not pair_taken(port):
        if dry:
            print(f"server: would start {HERE / 'server.py'}")
            return port, None
        said_why(port, launch_server(port))
        return port, None
    old = port
    for _ in range(MOVE_TRIES):
        new = pick_pair(port + 2)
        if new is None:
            sys.exit(f"something else is using port {old} or {old + 1}, and no free pair was found "
                     f"in the {PAIR_TRIES} above them; nothing was started")
        if dry:
            print(f"server: something else is using port {old} or {old + 1}; would move the board to "
                  f"{new} and {new + 1}, write {new} into {CONFIG.name} and start {HERE / 'server.py'}")
            return new, None
        write_config_port(new)
        port = new
        started = launch_server(port)
        if started == "up" and this_board(state(port)):
            return port, old
        # a pair can be taken in the moment between the look and the bind, and
        # then the next one is tried; a start that failed on a pair still free,
        # or never answered at all, failed for a reason of its own
        if started == "silent" or not pair_taken(port):
            said_why(port, "silent" if started == "silent" else "ended")
    sys.exit(f"the board could not keep a free pair above {old}: each one it tried was taken "
             "before it could start; nothing else was changed")


def moved_line(old, new, linked, cfg):
    """The one line a move gets."""
    line = (f"Board moved to port {new}: something else is using {old} or {old + 1}. "
            f"It stays on {new}, and {CONFIG.name} now says so.")
    if linked:
        line += " The phone link points there too."
    app_url = cfg.get("app_url") or ""
    if f":{old}" in app_url:
        line += f" app_url in {CONFIG.name} still names {app_url}."
    return line


def window_url(cfg):
    """The page the app window shows: the configured one, or this board's own
    root on loopback. One place, so the window that is opened and the window
    that is looked for can never be two different pages."""
    return cfg.get("app_url") or f"http://127.0.0.1:{cfg['port']}"


def open_app(cfg, dry):
    url = window_url(cfg)
    # a config without the app_fullscreen key launches exactly as it always did
    full = cfg.get("app_fullscreen") is True
    if dry:
        kind = "a chromeless full-screen app window" if full else "a chromeless app window"
        print(f"window: would open {url} as {kind}")
        return
    command = ["open", "-na", "Google Chrome", "--args", f"--app={url}"]
    if full:
        command.append("--start-fullscreen")
    opened = subprocess.run(command, capture_output=True, text=True, check=False)
    if opened.returncode != 0:
        said = (opened.stderr or "").strip().splitlines()
        detail = f" ({said[0]})" if said else ""
        print(f"could not open Chrome{detail}; open {url} yourself")


def lane_covered(st, owner):
    """True when some agent has this lane: attached right now, mid-claim, or
    heard from within 30 min (between long-poll cycles listening reads false)."""
    if st is None:
        return False
    if st["listening"].get(owner) or st["busy"].get(owner):
        return True
    return st["listenerGap"].get(owner, 9e9) < 1800


# --- restart: finding, stopping and starting this board's own server -------
#
# The rule the whole command hangs on: exactly one process is ever signalled,
# the one holding the LISTENING socket on the configured port, and only after
# it has been read back as this folder's server.py twice, the second time in
# the moment before the signal, start time and all. A browser showing the
# board holds a connection to that port, not the listening socket, so it can
# never appear in the answer and can never be signalled; the same goes for any
# agent mid-poll. Anything unclear (no listing, more than one listener, a
# process that is not ours, a port nothing can read) is a refusal that changes
# nothing, never a guess.
STOP_WAIT = 10.0        # seconds the old server gets to let go of the port
START_WAIT = 20.0       # seconds the replacement gets to answer on it
POLL_EVERY = 0.1        # how often both waits look again
LOOPBACK_NAMES = frozenset({"localhost", "::1", "ip6-localhost"})
DEFAULT_PORTS = {"http": 80, "https": 443}


def listener_pids(port):
    """The pids holding a listening socket on this port: a set, empty when
    nobody is there, or None when the question could not be answered at all.
    Only listeners are asked for (-sTCP:LISTEN), which is what keeps a browser
    or an agent with an open connection out of the answer."""
    lsof = shutil.which("lsof")
    if not lsof:
        return None
    try:
        seen = subprocess.run([lsof, "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-t"],
                              capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    # lsof says 1 both for "nothing matched" and for "could not look"; the
    # difference is whether it complained, and a complaint is an unknown
    if seen.returncode not in (0, 1):
        return None
    if seen.returncode == 1 and seen.stderr.strip():
        return None
    pids = set()
    for word in seen.stdout.split():
        if not word.isdigit():
            return None
        pids.add(int(word))
    return pids


# The kernel's own answers about one process, asked through libc. These are
# the numbers sysctl(3) takes. It is the only way on this machine to get an
# argument vector back whole: a line of text from ps has already thrown away
# where each argument began and ended, so a script called "my server.py" and
# two arguments "my" and "server.py" read the same in it, and so does a path
# that merely appears inside some other argument. The vector has no such
# ambiguity, and recognising our own server is exactly a question that cannot
# be answered with a maybe.
CTL_KERN = 1
KERN_PROC = 14
KERN_PROC_PID = 1
KERN_ARGMAX = 8
KERN_PROCARGS2 = 49
KINFO_PROC_SIZE = 1024      # comfortably over sizeof(struct kinfo_proc)
ARGMAX_FALLBACK = 262144


def _libc():
    """libc with sysctl declared, or None where there is no such thing. Every
    identity here rests on this, so anywhere it is None nothing can be
    recognised and nothing will be signalled."""
    if sys.platform != "darwin":
        return None
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        libc.sysctl.restype = ctypes.c_int
        libc.sysctl.argtypes = [ctypes.POINTER(ctypes.c_int), ctypes.c_uint,
                                ctypes.c_void_p, ctypes.POINTER(ctypes.c_size_t),
                                ctypes.c_void_p, ctypes.c_size_t]
        return libc
    except (OSError, AttributeError):
        return None


def _sysctl(names, size):
    """One sysctl read: the bytes it wrote, or None when it would not answer."""
    libc = _libc()
    if libc is None:
        return None
    try:
        mib = (ctypes.c_int * len(names))(*names)
        buf = ctypes.create_string_buffer(size)
        got = ctypes.c_size_t(size)
        if libc.sysctl(mib, len(names), buf, ctypes.byref(got), None, 0) != 0:
            return None
        return buf.raw[:got.value]
    except (OSError, ValueError, ctypes.ArgumentError):
        return None


def _argmax():
    raw = _sysctl((CTL_KERN, KERN_ARGMAX), ctypes.sizeof(ctypes.c_int))
    if raw is None or len(raw) < 4:
        return ARGMAX_FALLBACK
    return int.from_bytes(raw[:4], sys.byteorder) or ARGMAX_FALLBACK


def process_started(pid):
    """When the kernel says that pid started, as (seconds, microseconds), or
    None when it will not say. This is the first field of struct kinfo_proc,
    and it is what tells a number that has been reused from the process that
    used to have it."""
    raw = _sysctl((CTL_KERN, KERN_PROC, KERN_PROC_PID, int(pid)), KINFO_PROC_SIZE)
    if raw is None or len(raw) < 16:
        return None     # no such process, or an answer too short to be one
    return (int.from_bytes(raw[0:8], sys.byteorder, signed=True),
            int.from_bytes(raw[8:12], sys.byteorder, signed=True))


def process_argv(pid):
    """(executable, argv) for one pid, from the kernel: the path it is really
    running and the argument vector as it was handed over, every argument
    whole, spaces and all. None when it cannot be read."""
    raw = _sysctl((CTL_KERN, KERN_PROCARGS2, int(pid)), _argmax())
    if raw is None or len(raw) < 4:
        return None
    argc = int.from_bytes(raw[:4], sys.byteorder)
    if argc < 1:
        return None
    parts = raw[4:].split(b"\0")
    if not parts:
        return None
    executable = parts[0]
    rest = parts[1:]
    while rest and rest[0] == b"":      # the kernel pads for alignment here
        rest.pop(0)
    if len(rest) < argc:
        return None
    return os.fsdecode(executable), [os.fsdecode(arg) for arg in rest[:argc]]


PROBE_TRIES = 20        # how many looks a runtime probe gets before giving up
PROBE_WAIT = 5          # seconds it gets to finish once its input is closed
_runtime_probed = {}    # trusted interpreter -> what the kernel calls it, once


def file_identity(path):
    """(device, inode) for a path, or None. This is what a file is; a name is
    only where it was found."""
    try:
        seen = os.stat(path)
    except (OSError, TypeError, ValueError):
        return None
    return (seen.st_dev, seen.st_ino)


def same_file_as(path, candidates):
    """Whether that path is the same file as one of these, followed through
    every symlink."""
    want = file_identity(path)
    return want is not None and any(file_identity(other) == want for other in candidates)


def server_interpreters():
    """The interpreters this board's server can be started with: the one this
    script would launch it with, this process's own, data/.venv's, and the
    .venv a checkout from before data/ kept at its top, which an old board
    still runs on until the update moves it. These are the only paths this
    file will ever run."""
    return [server_python(), sys.executable, str(VENV_PYTHON),
            str(CLONE / ".venv" / "bin" / "python3")]


def framework_runtime(path):
    """The runtime binary a framework interpreter hands over to, worked out
    from the layout alone, or None.

    An ordinary macOS Python.framework holds two different files:

        <name>.framework/Versions/<v>/bin/python<v>
        <name>.framework/Versions/<v>/Resources/Python.app/Contents/MacOS/Python

    The first execs the second, so everything a person configures names the
    first while the kernel names the second. They are not links to each other
    and comparing them as files says, correctly, that they are different
    files; what is needed is the relationship between them. It is derived here
    by position only: the configured path, once followed through its symlinks,
    must really sit at .../<name>.framework/Versions/<v>/bin/<something>, and
    the file derived from it must exist. Nothing is run, nothing is guessed
    from a name, and nothing outside that exact shape is accepted."""
    if not path:
        return None
    parts = os.path.realpath(path).split(os.sep)
    if len(parts) < 5 or parts[-2] != "bin" or parts[-4] != "Versions":
        return None
    if not parts[-5].endswith(".framework"):
        return None
    runtime = os.sep.join(parts[:-2] + ["Resources", "Python.app", "Contents",
                                        "MacOS", "Python"])
    return runtime if os.path.exists(runtime) else None


def probed_runtime(interpreter):
    """What the kernel calls a process started from one of our own
    interpreters, found by starting it once and reading it back. None when it
    cannot be found out.

    This is the fallback for a layout the rule above does not know. It runs
    only a path this script already trusts and would launch the server with
    anyway, never anything a listener named: the question being asked is what
    our own launcher turns into, and asking an untrusted path would be running
    whatever a stranger put on the port. The child is given nothing to do and
    ends as soon as its input closes, and the answer is remembered, so a
    restart pays for this at most once per interpreter."""
    if interpreter in _runtime_probed:
        return _runtime_probed[interpreter]
    _runtime_probed[interpreter] = None
    if not os.access(interpreter, os.X_OK):
        return None
    read = None
    child = None
    try:
        child = subprocess.Popen([interpreter, "-c", "import sys; sys.stdin.read()"],
                                 stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
        for _ in range(PROBE_TRIES):
            read = process_argv(child.pid)
            if read:
                break
            time.sleep(POLL_EVERY)
    except (OSError, ValueError, AttributeError, subprocess.SubprocessError):
        read = None
    finally:
        try:
            if child is not None:
                child.stdin.close()      # it is waiting on that and nothing else
                child.wait(timeout=PROBE_WAIT)
        except (OSError, ValueError, AttributeError, subprocess.SubprocessError):
            pass
    _runtime_probed[interpreter] = read[0] if read else None
    return _runtime_probed[interpreter]


def trusted_executables():
    """Every file a process of ours may honestly be running: our interpreters
    themselves, and the framework runtime each one hands over to."""
    found = set()
    for interpreter in server_interpreters():
        for candidate in (interpreter, framework_runtime(interpreter)):
            ident = file_identity(candidate)
            if ident is not None:
                found.add(ident)
    return found


def is_trusted_executable(path):
    """Whether that executable is one of this board's own interpreters, or the
    runtime one of them turns into. Compared as files throughout: a name that
    begins with "python" proves nothing about what a file is."""
    ident = file_identity(path)
    if ident is None:
        return False
    if ident in trusted_executables():
        return True
    for interpreter in server_interpreters():
        if file_identity(probed_runtime(interpreter)) == ident:
            return True
    return False


def is_server_argv(executable, argv):
    """Whether that executable and argument vector are this folder's server and
    nothing else: exactly two arguments, the second one exactly our server.py,
    and an executable this board can account for.

    Both halves matter. A foreign script carrying our path as an argument has
    three arguments, not two, and no amount of looking at the end of a line
    will tell you which. An executable that cannot be accounted for is not
    accepted, which means a server started by hand under some other python is
    refused rather than signalled.

    Our server.py is app/server.py, or <checkout>/server.py for a board still
    running the code from before data/, which the update has to stop before
    it can move that board's files."""
    if len(argv) != 2 or argv[1] not in (str(HERE / "server.py"), str(CLONE / "server.py")):
        return False
    return is_trusted_executable(executable)


def process_identity(pid):
    """Everything that says which process a number is at this moment:
    (started, executable, argv). None when any part of it cannot be read.

    Compared whole, this is an identity. The start time separates a reused
    number from the process that had it; the executable and the vector
    separate a process that has become something else from one that has not."""
    started = process_started(pid)
    if started is None:
        return None
    read = process_argv(pid)
    if read is None:
        return None
    return started, read[0], tuple(read[1])


def is_our_server(pid):
    """True when that pid is this folder's server, False when it is plainly
    something else, None when it could not be read."""
    ident = process_identity(pid)
    if ident is None:
        return None
    return is_server_argv(ident[1], list(ident[2]))


def server_identity(pid):
    """(pid, identity) when that pid is this folder's server right now, None
    when it is not, or cannot be read. What is carried is the whole identity,
    start time and executable and vector together, so two reads that come back
    equal are the same process still running the same thing."""
    ident = process_identity(pid)
    if ident is None or not is_server_argv(ident[1], list(ident[2])):
        return None
    return pid, ident


def server_process(port):
    """((pid, started), refusal) for this board's server on this port.

    (None, None) is the one harmless empty answer: nothing is listening, so
    there is nothing to stop. Every other missing identity comes with a
    sentence saying why nothing was touched."""
    pids = listener_pids(port)
    if pids is None:
        return None, f"cannot read what is listening on {port}; nothing was stopped"
    if not pids:
        return None, None
    if len(pids) > 1:
        named = ", ".join(str(p) for p in sorted(pids))
        return None, (f"{len(pids)} processes are listening on {port} ({named}); "
                      "refusing to guess which one is the board")
    pid = pids.pop()
    if pid <= 0:
        return None, f"refusing to signal pid {pid}: that is a process group, not a process"
    ident = process_identity(pid)
    if ident is None:
        return None, (f"cannot read what process {pid} is; refusing to signal it")
    if not is_server_argv(ident[1], list(ident[2])):
        return None, (f"pid {pid} is listening on {port} and it is not "
                      f"{HERE / 'server.py'}; refusing to signal it")
    return (pid, ident), None


def pid_alive(pid):
    """Whether that one process still exists. Signal 0 asks without sending."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except OSError:
        return True     # it is there, this user just may not signal it
    return True


def port_free(port):
    """True when the listening socket is really gone, False when something
    still holds it, None when the listing could not be read.

    Free means two things at once: nobody listed as a listener, and a bind of
    exactly the server's shape succeeding. That is the same question the
    replacement is about to ask, asked the same way, which is why a fixed
    sleep cannot stand in for it: a sleep that guesses short loses the bind
    race and leaves the old server serving while the new one dies.

    Unknown is never free. A bind that happens to succeed while nothing can be
    read about the port says only that this one moment was quiet; it says
    nothing about a listener the listing could not show."""
    pids = listener_pids(port)
    if pids is None:
        return None
    if pids:
        return False
    return port_binds(port)


def port_binds(port):
    """Whether a bind of exactly the server's shape succeeds right now: the
    same question the replacement is about to ask, asked the same way."""
    probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        probe.bind(("127.0.0.1", port))
    except OSError:
        return False
    finally:
        probe.close()
    return True


def stop_timeout_reason(owner, port, wait, restart=True):
    """Why the restart stopped here, in terms of what was actually established
    in this moment: whether the process that was signalled is still that same
    process, whether it is still alive, and what if anything is listening now.

    Nothing here names a number to send a signal to. A pid is not a thing to
    hand out: by now it may belong to something else entirely, and a printed
    'kill 4242' is a reader's invitation to make exactly the mistake this
    command exists to avoid.

    Nothing is claimed that was not read, and that includes the three
    different things 'not our server any more' can mean. The process still
    there and still ours, a different process wearing the same number, and a
    number that could not be read at all are three states, not two, and the
    one thing they must never be called is 'the server'.

    restart=False words the same findings for stop, which has no replacement
    to hold back, so the clauses about starting one are left out."""
    pid = owner[0]
    read = process_identity(pid)
    same = None if read is None else ((pid, read) == owner)
    alive = pid_alive(pid)
    pids = listener_pids(port)
    held = "; nothing was started" if restart else ""
    left = " and nothing was started" if restart else ""
    lead = "nothing was started and " if restart else ""
    because = (", because a restart waits for the old server to finish leaving"
               if restart else "")
    if pids is None:
        return (f"port {port} could not be read {wait:.0f}s after the server was "
                f"asked to stop{held}")
    if pids == {pid}:
        if same is True:
            return (f"the server on {port} had not let go {wait:.0f}s after "
                    "SIGTERM and is still the same process; it was left alone"
                    f"{left}")
        if same is False:
            return (f"port {port} is still held under the same number by a "
                    "different process from the one that was signalled; "
                    f"{lead}nothing else was signalled")
        return (f"port {port} is still held under the same number and what that "
                f"process is now could not be read; {lead}"
                "nothing else was signalled")
    if pids:
        named = ", ".join(str(p) for p in sorted(pids))
        return (f"port {port} is listened on by {named} now, which is not the "
                f"process that was signalled; {lead}nothing else was signalled")
    binds = port_binds(port)
    if not alive:
        if binds:
            return f"port {port} came free as the wait ran out{held}"
        return (f"nothing is listening on {port} and the process that was "
                "signalled is no longer there, but the port still could not be "
                f"bound {wait:.0f}s after SIGTERM{held}")
    # something with that number is still running; say honestly what it is
    who = ("the server" if same is True else
           "a different process with the same number" if same is False else
           "something with the same number, which could not be read")
    if binds:
        return (f"{who} let go of port {port} but was still running {wait:.0f}s "
                f"after SIGTERM{held}{because}")
    return (f"{who} was still running {wait:.0f}s after SIGTERM and port {port} "
            f"still could not be bound{held}")


def stop_server(owner, port, wait=STOP_WAIT):
    """One SIGTERM to one process, then poll until the socket is free. None
    when it is free, a sentence when it is not.

    The identity read when the listener was found is read again here, in the
    moment before the signal: that pid must still be the only listener on the
    port, and must still be the same process, same start time, same command.
    A pid on its own is not an identity, because the number is released the
    moment a process ends and can already belong to something else by the time
    anything is sent to it.

    That narrows the window; it does not close it. This platform offers no way
    to attach a signal to a process identity rather than to a number, so
    between the last read and os.kill there remains a gap in which a pid could
    in principle be reused. It is small and it is real, and nothing here
    pretends otherwise.

    Never a process group, and never SIGKILL from here: the server stops
    gracefully on SIGTERM, and a process that will not go is reported and left
    exactly as it is, because killing something harder without being asked is
    how the wrong thing gets killed quietly. The one firm step, end_server,
    is reached only by stop --force."""
    refusal = signal_server(owner, port)
    if refusal:
        return refusal
    if wait_for_exit(owner[0], port, wait):
        return None
    return stop_timeout_reason(owner, port, wait)


def signal_server(owner, port):
    """The checks before the signal and the one SIGTERM itself: None once it
    is sent, a sentence when nothing was signalled. Split from the wait so a
    caller can tell a refusal, which sent nothing, from a signal that has run
    out its wait."""
    pid = owner[0]
    pids = listener_pids(port)
    if pids is None:
        return (f"cannot read what is listening on {port} any more; "
                "nothing was signalled")
    if pids != {pid}:
        named = ", ".join(str(p) for p in sorted(pids)) or "nothing"
        return (f"pid {pid} is no longer the one listener on {port} ({named} is); "
                "nothing was signalled")
    if server_identity(pid) != owner:
        return (f"pid {pid} is not the process that was read a moment ago, or can "
                "no longer be read at all; nothing was signalled")
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass        # gone between the last read and the signal; still wait for the socket
    except PermissionError:
        return f"not allowed to stop pid {pid}; nothing was changed"
    return None


def wait_for_exit(pid, port, wait):
    """True once that process is gone and the port is really free, False when
    the wait runs out first. Unknown is never free (see port_free)."""
    deadline = time.monotonic() + wait
    while True:
        if not pid_alive(pid) and port_free(port) is True:
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(POLL_EVERY)


def end_server(owner, port, wait=STOP_WAIT):
    """The firm step: one SIGKILL to the process that was asked politely and
    did not go, never a process group. None once it is gone and the port is
    free, else a sentence. Only stop --force reaches this, after the polite
    wait has run out. The identity is read a third time first, and a process
    that is no longer the one asked, or cannot be read, is not signalled."""
    pid = owner[0]
    if server_identity(pid) != owner:
        if not pid_alive(pid) and port_free(port) is True:
            return None     # it went by itself as the wait ran out
        return (f"pid {pid} is no longer the process that was asked to stop, or "
                "can no longer be read; it was not ended")
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    except PermissionError:
        return f"not allowed to end pid {pid}; nothing was changed"
    if wait_for_exit(pid, port, wait):
        return None
    if pid_alive(pid):
        return (f"the server on {port} was still there {wait:.0f}s after it was "
                "ended outright")
    return (f"the server is gone, but port {port} could not be shown free "
            f"{wait:.0f}s after it was ended outright")


def board_state(port):
    """The board's state when what answered is really a board: a JSON object
    with the parts this CLI reads, in the shapes it reads them in. None for no
    answer, an answer that is not JSON, and an answer of the wrong shape
    alike. All three mean the same thing to a restart, which is not ready yet,
    and none of them is a reason to fall over: something else can be on a port
    and answer anything at all."""
    st = state(port)
    if not isinstance(st, dict) or not isinstance(st.get("boxes"), list):
        return None
    for key in ("listening", "busy", "listenerGap"):
        if not isinstance(st.get(key), dict):
            return None
    return st


def confirm_listener(pid, port, ended):
    """Who is actually answering on the port: the child just started, or
    somebody else. ((pid, started), None) only when the one listener is that
    exact child and it still reads back as this folder's server.

    A foreign process found here is refused and never signalled. It is not
    ours to stop, whatever it is doing on the port."""
    pids = listener_pids(port)
    if pids is None:
        return None, (f"something is answering on {port} but what is listening "
                      "could not be read; the restart stopped here and nothing "
                      "was signalled")
    if pids != {pid}:
        named = ", ".join(str(p) for p in sorted(pids)) or "nothing"
        return None, (f"{port} is answered by {named}, not by the replacement "
                      f"(pid {pid}); the restart stopped here and nothing was "
                      "signalled")
    ident = server_identity(pid)
    if ident is None:
        return None, (f"pid {pid} holds {port} but does not read back as "
                      f"{HERE / 'server.py'}; the restart stopped here and "
                      "nothing was signalled")
    if ended:
        return None, (f"the replacement (pid {pid}) has exited even though {port} "
                      "still answers; the restart stopped here")
    return ident, None


def start_and_confirm(port, wait=START_WAIT):
    """Start the replacement and wait until the board is up and it is the
    replacement that is up. ((pid, started), None) when it is, (None,
    sentence) when it is not: a child that died early, a port answered by
    something else, or a start that never answered.

    An answer on the port is not enough on its own, and neither is any old
    answer. Between the stop and now the port was free for anyone, so what
    comes back could be another board, an older copy, or something that serves
    something else entirely on the same number. It has to be a board state
    this CLI can read, and the one listener has to be this exact child, and
    that child has to still read back as this folder's server. Nothing
    downstream, the window above all, happens on a sentence."""
    child = start_server()
    deadline = time.monotonic() + wait
    while True:
        ended = child.poll() is not None
        if board_state(port) is not None:
            return confirm_listener(child.pid, port, ended)
        if ended:
            return None, (f"the replacement did not start; run {server_python()} "
                          f"{HERE / 'server.py'} by hand to see why")
        if time.monotonic() >= deadline:
            return None, (f"the replacement (pid {child.pid}) did not answer on "
                          f"{port} with a board state within {wait:.0f}s; it was "
                          f"left alone, see the day's server file in {LOG_DIR}")
        time.sleep(POLL_EVERY)


def chrome_page_urls():
    """Every URL Chrome is showing right now, ordinary tabs and chromeless app
    windows alike, or None when that could not be established.

    This only reads. Nothing is activated, navigated, reloaded or closed, and
    Chrome is not started either: System Events is asked whether it is running
    first, and when it is not the answer is an empty list, which is a real
    absence. A refusal (no automation permission) comes back as None, which is
    an unknown and not an absence."""
    osascript = shutil.which("osascript")
    if not osascript:
        return None
    script = "\n".join([
        'tell application "System Events"',
        '  if not (exists process "Google Chrome") then return "NOTRUNNING"',
        'end tell',
        'set found to {}',
        'tell application "Google Chrome"',
        '  repeat with w in every window',
        '    repeat with t in every tab of w',
        '      set end of found to (URL of t as text)',
        '    end repeat',
        '  end repeat',
        'end tell',
        "set AppleScript's text item delimiters to linefeed",
        'return found as text',
    ])
    try:
        seen = subprocess.run([osascript, "-e", script],
                              capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    if seen.returncode != 0:
        return None
    out = seen.stdout.strip()
    if out == "NOTRUNNING":
        return []
    return [line.strip() for line in out.splitlines() if line.strip()]


def loopback_host(host):
    """Whether that host name is a spelling of this machine's own loopback."""
    host = host.strip("[]").lower()
    if host in LOOPBACK_NAMES:
        return True
    parts = host.split(".")
    return (len(parts) == 4 and parts[0] == "127"
            and all(p.isdigit() and int(p) < 256 for p in parts))


def page_identity(url):
    """A page reduced to what decides whether it is this board: the scheme,
    the host with every loopback spelling read as one host, the port with a
    missing one read as the scheme's default, and the path with a bare host
    and a trailing slash both read as "/". Query and fragment are dropped on
    purpose: that is where the selected card lives, and the board showing
    another card is still the board. None for anything that is not an http or
    https page, so a file:// or chrome:// page can never match."""
    try:
        bits = urlparse((url or "").strip())
        host = (bits.hostname or "").lower()
        port = bits.port
    except ValueError:
        return None
    if bits.scheme not in DEFAULT_PORTS or not host:
        return None
    path = bits.path or "/"
    if not path.startswith("/"):
        path = "/" + path
    path = path.rstrip("/") or "/"
    return (bits.scheme, "loopback" if loopback_host(host) else host,
            port or DEFAULT_PORTS[bits.scheme], path)


def same_board_page(url, board):
    """True when that URL is this board's page under the rule above. Another
    port on the same loopback is a different board and does not match."""
    here = page_identity(board)
    there = page_identity(url)
    return here is not None and here == there


def board_page_open(cfg):
    """True when Chrome is already showing this board, False when it is
    certainly showing it nowhere, None when Chrome could not be asked. A
    refusal is never read as absence: reading it that way is exactly how a
    second window gets opened on top of the first."""
    urls = chrome_page_urls()
    if urls is None:
        return None
    board = window_url(cfg)
    return any(same_board_page(url, board) for url in urls)


# --- stop: closing the board's own window ------------------------------------
# Chrome is one process, so one window can only be closed through its own
# scripting. The id and the pages the window must still show go in as
# arguments, never as script text.
CLOSE_WINDOW_SCRIPT = "\n".join([
    'on run argv',
    '  if (count of argv) < 2 then return "BADARGS"',
    '  set wanted to (item 1 of argv) as integer',
    '  set expected to rest of argv',
    '  tell application "System Events"',
    '    if not (exists process "Google Chrome") then return "GONE"',
    '  end tell',
    '  tell application "Google Chrome"',
    '    set candidates to (every window whose id is wanted)',
    '    if (count of candidates) is not 1 then return "GONE"',
    '    set win to item 1 of candidates',
    '    set seen to {}',
    '    repeat with t in every tab of win',
    '      set end of seen to (URL of t as text)',
    '    end repeat',
    '    set agreed to false',
    '    considering case',
    '      set agreed to (seen = expected)',
    '    end considering',
    '    if not agreed then return "CHANGED"',
    '    close win',
    '  end tell',
    '  return "CLOSED"',
    'end run',
])


def chrome_windows():
    """Every Chrome window as (id, [tab URLs]), or None when that could not be
    established. An empty list is a real absence: Chrome is not running, which
    System Events is asked first so that Chrome is never started to find out.
    A refusal (no automation permission) is None, an unknown and not an
    absence. This only reads; nothing is activated, navigated or closed."""
    osascript = shutil.which("osascript")
    if not osascript:
        return None
    script = "\n".join([
        'tell application "System Events"',
        '  if not (exists process "Google Chrome") then return "NOTRUNNING"',
        'end tell',
        # inside Chrome's block the bare word tab means Chrome's tab class, so
        # the separator is made out here
        'set sep to character id 9',
        'set listed to {}',
        'tell application "Google Chrome"',
        '  repeat with w in every window',
        '    set entry to ((id of w) as text)',
        '    repeat with t in every tab of w',
        '      set entry to entry & sep & (URL of t as text)',
        '    end repeat',
        '    set end of listed to entry',
        '  end repeat',
        'end tell',
        "set AppleScript's text item delimiters to linefeed",
        'return listed as text',
    ])
    try:
        seen = subprocess.run([osascript, "-e", script],
                              capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    if seen.returncode != 0:
        return None
    out = seen.stdout.strip()
    if out == "NOTRUNNING":
        return []
    windows = []
    for line in out.splitlines():
        first, *urls = line.strip("\r\n").split("\t")
        if first.strip().isdigit():
            windows.append((int(first), [u.strip() for u in urls]))
    return windows


def close_chrome_window(wid, urls):
    """Ask Chrome to close one window by its id: "CLOSED" when it did, "GONE"
    when no such window (or no Chrome) is there any more, "CHANGED" when the
    window no longer shows exactly those pages and was left alone, None when
    Chrome could not be asked. The id and the pages go in as arguments."""
    osascript = shutil.which("osascript")
    if not osascript:
        return None
    try:
        done = subprocess.run([osascript, "-e", CLOSE_WINDOW_SCRIPT, str(wid), *urls],
                              capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    if done.returncode != 0:
        return None
    answer = done.stdout.strip()
    return answer if answer in ("CLOSED", "GONE", "CHANGED") else None


def board_addresses(cfg, port):
    """Every address a window of the board that ran on this port can show: the
    one the window was opened with, and this port on loopback."""
    return [window_url({**cfg, "port": port}), f"http://127.0.0.1:{port}"]


def sort_board_windows(windows, boards):
    """(the windows whose every tab is the board's own page, how many other
    windows hold a board tab among other tabs). A window with no tab at all is
    not the board's: every tab of nothing matching is not a reason to close."""
    only, mixed = [], 0
    for wid, urls in windows:
        hits = [any(same_board_page(url, board) for board in boards) for url in urls]
        if hits and all(hits):
            only.append((wid, urls))
        elif any(hits):
            mixed += 1
    return only, mixed


def close_board_windows(cfg, port):
    """Close the windows that show nothing but the board that ran on this port
    and return the lines to say about it: nothing when Chrome is not running
    or shows no board page, one line for what was closed, and one for each
    thing left for the person to do."""
    windows = chrome_windows()
    if windows is None:
        return ["Could not ask Chrome; close the board window yourself."]
    only, mixed = sort_board_windows(windows, board_addresses(cfg, port))
    closed, refused = 0, False
    for wid, urls in only:
        answer = close_chrome_window(wid, urls)
        if answer == "CLOSED":
            closed += 1
        elif answer is None:
            refused = True
    lines = []
    if closed:
        lines.append("Window closed." if closed == 1 else f"{closed} windows closed.")
    if mixed:
        lines.append("A board tab is still open in a window with other tabs; "
                     "close it yourself.")
    if refused:
        lines.append("Could not ask Chrome; close the board window yourself.")
    return lines


def claude_pane(name):
    """Pane id of the claude running anywhere inside tmux session `name`.
    None = no such session; "" = session exists but no claude pane."""
    if not shutil.which("tmux"):
        return None
    r = subprocess.run(["tmux", "list-panes", "-s", "-t", name,
                        "-F", "#{pane_id} #{pane_current_command}"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None
    for line in r.stdout.splitlines():
        pid, _, cmd = line.partition(" ")
        if cmd.startswith("claude") or cmd == "node":
            return pid
    return ""


def instruct(lane, dry):
    """Type the attach instruction into the claude PANE of the lane's tmux
    session (a session's active pane may be a bare shell; the claude can live
    in any pane). Verifies the text landed before pressing Enter. Never types
    into a shell. Returns (delivered, why); why says what is missing, or None."""
    name, text = lane.get("tmux"), lane_value(lane, "instruction")
    if not name:
        return False, None
    pane = claude_pane(name)
    if pane is None:
        return False, f"tmux session {name} not found"
    if not pane:
        return False, f"no claude pane inside tmux {name}; not typing into shells"
    if dry:
        print(f"listener {lane['owner']}: would send the attach instruction to tmux {name} pane {pane}")
        return True, None
    subprocess.run(["tmux", "send-keys", "-t", pane, "-l", text], check=True)
    time.sleep(1)
    seen = subprocess.run(["tmux", "capture-pane", "-p", "-t", pane],
                          capture_output=True, text=True).stdout
    if text[:40] not in seen:
        print(f"lane {lane['owner']}: instruction did not land in pane {pane}; Enter NOT pressed")
        return False, None
    subprocess.run(["tmux", "send-keys", "-t", pane, "Enter"], check=True)
    print(f"lane {lane['owner']}: instructed the claude in tmux {name} (pane {pane})")
    return True, None


def spawn(lane, dry):
    """Create a FRESH claude session for the lane (only ever on --spawn)."""
    owner = lane["owner"]
    d, prompt = str(Path(lane_value(lane, "dir")).expanduser()), lane_value(lane, "prompt")
    if dry:
        print(f"listener {owner}: would spawn a NEW claude session in {d}")
        return
    if shutil.which("tmux"):
        name = f"facil-{owner}"
        if subprocess.run(["tmux", "has-session", "-t", name], capture_output=True).returncode == 0:
            print(f"lane {owner}: tmux session {name} already exists; attach with: tmux attach -t {name}")
            return
        subprocess.run(["tmux", "new-session", "-d", "-s", name, "-c", d, "claude", prompt], check=True)
        term_cmd = f"tmux attach -t {name}"
        how = f"tmux {name}"
    else:
        term_cmd = f"cd {shlex.quote(d)} && claude {shlex.quote(prompt)}"
        how = "terminal window"
    esc = term_cmd.replace("\\", "\\\\").replace('"', '\\"')
    subprocess.run(["osascript",
                    "-e", f'tell application "Terminal" to do script "{esc}"',
                    "-e", 'tell application "Terminal" to activate'], check=False)
    print(f"lane {owner}: spawned NEW session ({how})")


def cmd_run(args):
    """Server and window only, by default. The CLI never touches tmux unless
    asked: --attach types the instruction into existing lane sessions, --spawn
    creates fresh ones. A real run says the board is up and nothing more, and
    those two options add one line per lane they act on; --dry-run keeps its
    longer account. A board that had to move to a free pair gets one line more
    saying so, and the phone's link is pointed at the new pair with it. On a
    checkout with a phone password the link is then left on, silently when it
    is, and in one line when it cannot be."""
    cfg = load_config()
    check_lanes(cfg)
    dry = "--dry-run" in args
    force = "--force" in args
    do_spawn = "--spawn" in args
    do_attach = "--attach" in args or do_spawn
    port, moved_from = place_board(int(cfg["port"]), dry)
    link_said = False
    if not dry:
        if moved_from is not None:
            linked, problem = repoint_bridge(moved_from, port)
            print(moved_line(moved_from, port, linked, cfg))
            if problem:
                print(problem)
                link_said = True
        print(f"Board up on http://127.0.0.1:{port}")
        print("Facilitator is live!")
    cfg = {**cfg, "port": port}
    open_app(cfg, dry)
    if bridge_set_up():
        if dry:
            print("bridge: would leave the phone link on, as facilitator bridge on does; "
                  "nothing changes when it already is")
        elif not link_said:
            said = follow_bridge("on", port)
            if said:
                print(said)
    st = state(port)
    for lane in cfg["lanes"]:
        ow = lane["owner"]
        if not force and lane_covered(st, ow):
            if dry:
                if st["busy"].get(ow):
                    why = f"mid-claim on box {st['busy'][ow]}"
                elif st["listening"].get(ow):
                    why = "attached right now"
                else:
                    why = f"heard {round(st['listenerGap'].get(ow, 0) / 60)} min ago"
                print(f"listener {ow}: lane covered ({why})")
            continue
        if not do_attach:
            if dry:
                print(f"listener {ow}: not attached. Tell that agent to start listening, or\n"
                      f"  rerun with --attach to type the instruction into its tmux session:\n"
                      f"  {lane_value(lane, 'instruction')}")
            continue
        delivered, why = instruct(lane, dry)
        if delivered:
            continue
        if dry and why:
            print(f"listener {ow}: {why}")
        if do_spawn:
            spawn(lane, dry)
        elif dry:
            print(f"listener {ow}: no reachable session. Paste this into the right claude yourself,\n"
                  f"  or rerun with --spawn to create a fresh session:\n"
                  f"  {lane['instruction']}")
        else:
            print(f"lane {ow}: {why or 'no reachable session'}; paste this into its claude, "
                  f"or rerun with --spawn: {lane['instruction']}")


def cmd_restart(args):
    """Stop this board's server, start it again, and leave the browser as it
    is. Nothing here touches a lane, a tmux session or the bridge: restart is
    about the server and, at most, one new window. Unknown words are refused
    rather than ignored, so a run flag typed here cannot quietly turn into
    attaching, spawning or forcing anything."""
    extra = [a for a in args[1:] if a != "--dry-run"]
    if extra:
        sys.exit("restart takes --dry-run and nothing else; got " + " ".join(extra))
    cfg = load_config()
    port = cfg["port"]
    dry = "--dry-run" in args
    url = window_url(cfg)

    owner, refusal = server_process(port)
    if refusal:
        sys.exit(f"restart: {refusal}")
    # restart keeps the board on its pair and never moves it. A board of this
    # folder's running on a pair the config does not name would refuse the
    # replacement at its lock, so that is said instead of tried
    elsewhere = board_elsewhere(port) if owner is None else None
    if elsewhere is not None:
        sys.exit(f"restart: this board is running on port {elsewhere}, not on {port} from "
                 f"{CONFIG.name}; run facilitator run to bring the two together, then restart")

    if dry:
        if owner is None:
            print(f"restart: nothing is listening on {port}; "
                  f"would start {HERE / 'server.py'}")
        else:
            print(f"restart: would SIGTERM pid {owner[0]} on {port}, wait up to "
                  f"{STOP_WAIT:.0f}s for the port to be free, then start "
                  f"{HERE / 'server.py'} again")
        showing = board_page_open(cfg)
        if showing is None:
            print("window: cannot read Chrome's pages, so a real run would open "
                  f"nothing and say to open or reload {url} by hand")
        elif showing:
            print(f"window: {url} is already open; would leave it alone")
        else:
            print(f"window: nothing is showing {url}; would open one app window")
        return

    def stop_here(sentence):
        # once the old server was signalled the board may be down; say how to start it
        down = owner is not None and board_state(port) is None
        sys.exit(f"restart: {sentence}"
                 + (". The board is down now; start it with: facilitator run" if down else ""))

    if owner is not None:
        refusal = stop_server(owner, port)
        if refusal:
            stop_here(refusal)

    # the last look before starting a second child: whatever the stop thought,
    # the port has to read as free right now, and unknown is not free
    free = port_free(port)
    if free is None:
        stop_here(f"cannot read what is listening on {port}; nothing new was started")
    if not free:
        stop_here(f"port {port} is still held by something; nothing new was started")

    _, refusal = start_and_confirm(port)
    if refusal:
        stop_here(refusal)
    print("Board restarted." if owner is not None else "Board started.")

    # an update the board started opens no window and asks Chrome nothing: the
    # page that said yes reloads itself, and a window opened here would come up
    # on the Mac's screen whoever said yes and wherever
    if FROM_BOARD:
        return
    showing = board_page_open(cfg)
    if showing:
        print("Reload the board (command + R).")
    elif showing is False:
        open_app(cfg, False)


def stop_target(port):
    """(port, owner, refusal) for a stop: the server on the configured port,
    found and read back the way restart does it. When nothing listens there,
    this folder's board may still be running on the pair server.lock names, and
    it counts only when that answer names this folder and the process holding
    the port reads back as this folder's server.py as well. Restart refuses
    that case; stop can act on it because the same identity rule applies."""
    owner, refusal = server_process(port)
    if refusal or owner is not None:
        return port, owner, refusal
    found = board_elsewhere(port)
    if found is None:
        return port, None, None
    owner, refusal = server_process(found)
    return found, owner, refusal


def stop_board(owner, port, force):
    """None once the server is gone and both of its ports are free, a sentence
    when not. The polite stop first; with force, and only after its wait has
    run out, the one firm step."""
    refusal = signal_server(owner, port)
    if refusal:
        return refusal
    if not wait_for_exit(owner[0], port, STOP_WAIT):
        late = stop_timeout_reason(owner, port, STOP_WAIT, restart=False)
        if not force:
            return (f"{late}. Nothing was closed. Try again, or use: "
                    "facilitator stop --force")
        refusal = end_server(owner, port)
        if refusal:
            return f"{refusal}. Nothing was closed"
    # one process holds both ports, so the phone's is checked as well
    phone = port_free(port + 1)
    if phone is True:
        return None
    what = "could not be read" if phone is None else "is still held by something"
    return (f"the board on {port} has stopped, but port {port + 1}, the one above "
            f"it, {what}. Nothing was closed")


def stop_dry_run(cfg, port, owner, force):
    """What a real stop would do, read from the same places and changing
    nothing. Chrome is read, as the window step reads it, and never driven."""
    windows = chrome_windows()
    only, mixed = ([], 0) if windows is None else sort_board_windows(
        windows, board_addresses(cfg, port))
    closing = ("close no window" if not only else "close 1 window" if len(only) == 1
               else f"close {len(only)} windows")
    unknown = "Chrome cannot be asked, so a window may be left open"
    if owner is not None:
        head = f"stop (dry run): would stop the board on port {port} (pid {owner[0]})"
        print(f"{head}; {unknown}." if windows is None else f"{head} and {closing}.")
    else:
        head = f"stop (dry run): the board is not running on port {port}"
        print(f"{head}; {unknown}." if windows is None else f"{head}; would {closing}.")
    if mixed:
        print("stop (dry run): a board tab in a window with other tabs would be left open.")
    if force and owner is not None:
        print("stop (dry run): with --force the server would be ended outright if it "
              f"is still there after {STOP_WAIT:.0f}s.")
    if bridge_set_up():
        print("stop (dry run): once the server is gone, the phone link would be taken off, "
              "as facilitator bridge off does.")


def cmd_stop(args):
    """End this board's server, then close the windows that show nothing but
    the board. The server goes first: if it is refused or will not go, no
    window is touched, and a Chrome permission prompt cannot delay the stop.
    Nothing here touches a lane, a tmux session or a saved file. On a checkout
    with a phone password the phone link is taken off last, once the server is
    gone, and left alone when the stop was refused. Unknown words are refused
    rather than ignored."""
    extra = [a for a in args[1:] if a not in ("--dry-run", "--force")]
    if extra:
        sys.exit("stop takes --dry-run, --force and nothing else; got " + " ".join(extra))
    cfg = load_config()
    port, owner, refusal = stop_target(int(cfg["port"]))
    if refusal:
        sys.exit(f"stop: {refusal}")
    if "--dry-run" in args:
        stop_dry_run(cfg, port, owner, "--force" in args)
        return

    if owner is None:
        print("Board was not running.")
    else:
        refusal = stop_board(owner, port, "--force" in args)
        if refusal:
            sys.exit(f"stop: {refusal}")
        print("Board stopped.")
    for line in close_board_windows(cfg, port):
        print(line)
    # last, because it can be slow, and it must never change the outcome
    if bridge_set_up():
        said = follow_bridge("off", port)
        if said:
            print(said)
    elif owner is not None:
        try:
            note = bridge_note(port)
        except Exception:
            note = None
        if note:
            print(note)


