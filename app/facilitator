def check_python():
    """Stop when the Python running this setup is below the floor this command
    needs, and say nothing otherwise. The board does not run on it: it runs on
    the Python APP_PYTHON in .venv, which uv provides whatever Python runs
    this, so which one runs the setup is not something to print."""
    have = sys.version_info[:3]
    if have < MIN_PYTHON:
        shown = ".".join(str(part) for part in have)
        floor = ".".join(str(part) for part in MIN_PYTHON)
        sys.exit(problem(f"Python {shown} is below the {floor} minimum.",
                         "Install a newer Python, then run ./install.sh again."))


def find_uv():
    """The uv command: PATH first, then the two places uv's own installer puts
    it, so a uv installed here on a past run is found even when it never went
    onto PATH."""
    found = shutil.which("uv")
    if found:
        return found
    for candidate in UV_HOME_BINS:
        path = os.path.expanduser(candidate)
        if os.access(path, os.X_OK):
            return path
    return None


def uv_installer_env(folder):
    """The environment for uv's installer, or None when nothing here can check
    a download. The installer compares each file it fetches with the
    fingerprint it carries only when a sha256sum command exists, and macOS has
    shasum instead, so a sha256sum that calls shasum is put in folder and
    first on PATH."""
    env = {**os.environ, "UV_NO_MODIFY_PATH": "1"}
    if shutil.which("sha256sum"):
        return env
    shasum = shutil.which("shasum")
    if not shasum:
        return None
    shim = Path(folder) / "sha256sum"
    shim.write_text(f"#!/bin/sh\nexec {shlex.quote(shasum)} -a 256 \"$@\"\n")
    shim.chmod(0o755)
    env["PATH"] = folder + os.pathsep + env.get("PATH", "")
    return env


def install_uv():
    """Install uv and return its path, or stop. uv's own installer from
    astral.sh is the only way: locked to UV_PIN and run only when it has the
    expected fingerprint, into the home folder and told not to touch any shell
    profile. Under Rosetta it asks the Mac, not uname, and installs the uv
    built for Apple silicon. uv is required; there is no fallback to a plain
    venv."""
    if not shutil.which("curl"):
        sys.exit(problem("curl is needed to fetch the uv installer.",
                         "Install uv yourself, then run ./install.sh again."))
    global _after_intro
    _after_intro = False
    print("uv is not installed. Installing it with the astral.sh installer")
    print("into your home.")
    with tempfile.TemporaryDirectory() as folder:
        env = uv_installer_env(folder)
        if env is None:
            sys.exit(problem("Cannot check what the uv installer downloads: neither sha256sum nor shasum is here.",
                             "Nothing was run. Install uv yourself, then run ./install.sh again."))
        script = subprocess.run(["curl", "--proto", "=https", "--tlsv1.2", "-LsSf", UV_INSTALL_URL],
                                capture_output=True)
        if script.returncode != 0 or not script.stdout:
            sys.exit(problem("Could not download the uv installer.",
                             *held_lines("curl", script.stderr),
                             "Check the internet connection, then run ./install.sh again."))
        if hashlib.sha256(script.stdout).hexdigest() != UV_INSTALL_SHA256:
            sys.exit(problem("The uv installer from astral.sh is not the one this checkout expects.",
                             "Nothing was run. Install uv yourself, then run ./install.sh again."))
        # its own progress lines are held back and shown only if it fails
        held = subprocess.run(["sh"], input=script.stdout, env=env, capture_output=True)
        if held.returncode != 0:
            sys.exit(problem("The uv installer did not finish.",
                             *held_lines("the uv installer", held.stdout, held.stderr),
                             "Install uv yourself, then run ./install.sh again."))
    uv = find_uv()
    if not uv:
        sys.exit(problem("uv is installed but still not found.",
                         "Open a new shell so it is on PATH, then run ./install.sh again."))
    return uv


def uv_version(uv):
    """What that uv says its version is, as numbers like (0, 9, 0), or None
    when nothing it says reads as one."""
    try:
        said = subprocess.run([uv, "--version"], capture_output=True, text=True, errors="replace")
    except OSError:
        return None
    found = re.match(r"uv (\d+)\.(\d+)\.(\d+)", (said.stdout or "").strip())
    return tuple(int(part) for part in found.groups()) if found else None


def ensure_uv(quiet=False):
    """The uv command, found or installed, and new enough to install Python
    APP_PYTHON. An older one stops the run in one line: it is the tester's own
    tool, so it is theirs to upgrade, and nothing has been changed yet."""
    uv = find_uv()
    installed = not uv
    if installed:
        uv = install_uv()
    have = uv_version(uv)
    if have is None or have < UV_MIN:
        need = ".".join(str(part) for part in UV_MIN)
        which = f"uv {'.'.join(str(part) for part in have)}" if have else f"The uv at {uv}, whose version could not be read,"
        sys.exit(problem(f"{which} is too old to install Python {APP_PYTHON}: upgrade it to {need} or newer "
                         "(uv self update), then run ./install.sh again."))
    # install.sh says so itself when it installed uv to get a Python
    if not quiet and os.environ.get("FACILITATOR_UV_REPORTED") != "1":
        ok("uv installed." if installed else "uv found.")
    return uv


def held_lines(who, *outputs):
    """The output a failed step held back, as next steps for problem(): a line
    naming whose it is, then its last HELD_LINES lines, indented, with colour
    codes, progress redraws and blank lines taken out. Empty when it printed
    nothing. Each output may be text, bytes or None."""
    text = "".join(out.decode("utf-8", "replace") if isinstance(out, bytes) else (out or "")
                   for out in outputs)
    text = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", text)
    lines = [line.rstrip("\r").rsplit("\r", 1)[-1].rstrip() for line in text.split("\n")]
    lines = [line for line in lines if line.strip()][-HELD_LINES:]
    return [f"Last lines from {who}:", *("  " + line for line in lines)] if lines else []


def make_data():
    """data/, made private to this account when it is not there yet; one
    already there keeps its mode."""
    DATA.mkdir(mode=0o700, exist_ok=True)


def run_held(argv, cwd=DATA):
    """Run a command, in data/ by default, holding its output back, so an
    install says what it is doing in its own words and not in uv's or npm's.
    The result comes back for held_lines to show the end of it when it
    failed."""
    return subprocess.run(argv, cwd=str(cwd), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                          text=True, errors="replace")


def env_python():
    """The Python .venv is built on, as "3.14", read from .venv/pyvenv.cfg
    without running anything. None when .venv/bin/python3 cannot be run (no
    file, or a link whose Python was removed) or the file names no version."""
    if not os.access(VENV_PYTHON, os.X_OK):
        return None
    try:
        lines = (VENV / "pyvenv.cfg").read_text().splitlines()
    except (OSError, UnicodeDecodeError):
        return None
    for line in lines:
        key, _, value = line.partition("=")
        if key.strip() in ("version_info", "version"):
            parts = value.strip().split(".")
            if len(parts) >= 2 and parts[0].isdigit() and parts[1].isdigit():
                return f"{int(parts[0])}.{int(parts[1])}"
    return None


# set once ensure_env has stopped this folder's board to rebuild .venv, so a
# step that fails after that can say the board is down
env_stopped_board = False


def board_on_env():
    """The port this folder's board answers on, or None. Asked only where
    server.lock and run.config.json point, and counted only when the board
    there names this folder: another checkout's board on the same port runs on
    its own .venv, and with neither file there is nowhere to ask."""
    ports = [lock_port()]
    if CONFIG.exists():
        ports.append(board_port())
    for port in dict.fromkeys(port for port in ports if port):
        if this_board(board_state(port)):
            return port
    return None


def stop_for_rebuild():
    """Stop this folder's board before its .venv is rebuilt; True when one was
    stopped. It has to go first: once .venv points at the new Python, restart
    can no longer recognise a server still running on the old one, and the
    rebuild would clear the packages from under it. A board that cannot be
    stopped safely stops the run instead, with .venv unchanged."""
    global env_stopped_board
    port = board_on_env()
    if port is None:
        return False
    owner, refusal = server_process(port)
    if refusal is None and owner is not None:
        refusal = stop_server(owner, port)
    if refusal:
        sys.exit(problem(f"The board could not be stopped to rebuild .venv: {refusal}.",
                         "Nothing in .venv was changed. Stop the board, then run ./install.sh again."))
    if owner is None:
        return False
    env_stopped_board = True
    print(f"Stopped the board on port {port}, which was running on the old .venv.")
    return True


def build_env(uv, have, quiet):
    """Build .venv on a Python APP_PYTHON that uv manages itself, replacing
    whatever stands there. uv installs that Python first, the only step that
    downloads, so a failure there leaves .venv and the board as they were. A
    rebuild of a .venv that was there says so even when quiet, since it is
    news. True when the board was stopped for it."""
    venv = VENV
    if venv.is_symlink():
        sys.exit(problem(f".venv is a link, and it is not on Python {APP_PYTHON}.",
                         "Facilitator will not clear what it points to. Remove the link,",
                         "then run ./install.sh again."))
    there = venv.exists()
    if there:
        why = f"it was on Python {have}" if have else "its Python is missing or broken"
        print(f"Rebuilding .venv on Python {APP_PYTHON}: {why}.")
    done = run_held([uv, "python", "install", "--no-bin", APP_PYTHON])
    if done.returncode != 0:
        sys.exit(problem(f"uv could not install Python {APP_PYTHON}.",
                         *held_lines("uv", done.stdout, done.stderr),
                         *(["Nothing in .venv was changed."] if there else []),
                         "See the output above, then run ./install.sh again."))
    stopped = stop_for_rebuild() if there else False
    done = run_held([uv, "venv", "--clear", "--managed-python", "--python", APP_PYTHON, ".venv"])
    if done.returncode != 0:
        sys.exit(problem("uv could not create .venv.",
                         *held_lines("uv", done.stdout, done.stderr),
                         "See the output above, then run ./install.sh again."))
    got = env_python()
    if got != APP_PYTHON:
        made = f"on Python {got}" if got else "but its Python could not be read"
        sys.exit(problem(f"uv made .venv {made}, not on Python {APP_PYTHON}.",
                         "See the output above, then run ./install.sh again."))
    if not quiet:
        ok(f"Python {APP_PYTHON} environment ready.")
    return stopped


def ensure_env(uv, quiet=False):
    """Make .venv stand on Python APP_PYTHON with the pinned packages in it,
    each file checked against the fingerprint requirements.txt gives it, so
    nothing unlisted or changed goes in. A .venv already on it is kept; one that is missing, broken or on any other
    Python is built again, so every checkout runs the Python the board is tested
    on. The sync runs either way because it is idempotent and is how a changed
    requirements file is picked up. quiet prints nothing unless a step fails or
    .venv has to be rebuilt. True when the board was stopped for a rebuild, so
    the caller can start it again. It runs in data/, where .venv is; the
    requirements come from app/."""
    make_data()
    have = env_python()
    stopped = False
    if have == APP_PYTHON:
        if not quiet:
            ok(f"Environment found in .venv (Python {APP_PYTHON}).")
    else:
        stopped = build_env(uv, have, quiet)
    done = run_held([uv, "pip", "sync", "--require-hashes", "--python", ".venv/bin/python",
                     str(HERE / "requirements.txt")])
    if done.returncode != 0:
        sys.exit(problem("uv could not sync requirements.txt.",
                         *held_lines("uv", done.stdout, done.stderr),
                         "See the output above, then run ./install.sh again."))
    if not quiet:
        ok("Packages installed.")
    return stopped


def ensure_config():
    """Write each config file from its example only when it is not already
    there, so a second run and a user's own edits are both left untouched.
    A new run.config.json names the default pair, 8877 and 8878, when nothing
    holds it, and otherwise the next free pair above it; run says which port
    the board is on. Nothing is asked of any port beyond whether it can be
    bound, and Tailscale is not asked at all: install runs before the phone
    client is set up, and run checks the Serve rules when it starts the board.
    The examples are in app/ and the files go into data/."""
    make_data()
    for name, example in (("run.config.json", "run.config.example.json"),
                          ("seed.json", "seed.example.json")):
        target = DATA / name
        if target.exists():
            ok(f"{name} found.")
            continue
        shutil.copyfile(HERE / example, target)
        if name != "run.config.json":
            continue
        port = pick_pair(DEFAULT_PORT, serve=False)
        if port is not None and port != json.loads(target.read_text()).get("port"):
            target.write_text(config_with(target.read_text(), port, None))


def find_node_tools():
    """The npm to use for the test packages, or None when node or npm is missing."""
    npm = shutil.which("npm")
    return npm if shutil.which("node") and npm else None


def ensure_test_packages(npm):
    """Install the packages only the tests need, exactly as tests/package-lock.json
    names them: npm ci, which takes nothing the lockfile does not fix, and
    without any package's install scripts. They are left alone when the version
    tests/package.json pins is already there."""
    pinned = json.loads((TESTS_DIR / "package.json").read_text())["dependencies"]["puppeteer-core"]
    try:
        have = json.loads((TESTS_DIR / "node_modules" / "puppeteer-core" / "package.json").read_text())["version"]
    except (OSError, ValueError, KeyError):
        have = None
    if have == pinned:
        ok("Test packages found.")
        return
    print("Installing the packages the tests need.")
    done = run_held([npm, "ci", "--ignore-scripts", "--no-audit", "--no-fund"], TESTS_DIR)
    if done.returncode != 0:
        sys.exit(problem("npm could not install the test packages.",
                         *held_lines("npm", done.stdout, done.stderr),
                         "See the output above, then run ./install.sh --dev again."))
    ok("Packages for the tests installed.")


def cmd_install(args):
    """Set up a fresh checkout in place, beside this command, in the order the
    steps depend on each other. Every step is idempotent."""
    words = args[1:]
    if any(w in ("-h", "--help") for w in words):
        print(INSTALL_HELP)
        return
    extra = [w for w in words if w != "--dev"]
    if extra:
        sys.exit("install takes only --dev; got " + " ".join(extra) + "\n" + INSTALL_HELP)
    dev = "--dev" in words
    # keep these lines in order with uv's and npm's when the output is a pipe
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(line_buffering=True)
    # install.sh prints this step's intro and its blank line before it gets here
    global _after_intro
    _after_intro = True
    npm = find_node_tools() if dev else None
    if dev and not npm:
        sys.exit(problem("--dev needs node and npm, and they were not found.",
                         "Install Node.js, then run ./install.sh --dev again."))
    make_data()
    previous = read_install_record()
    before = {name: artifact_path(name).exists() for name in INSTALL_ARTIFACTS}
    try:
        uv = ensure_uv()
        check_python()
        ensure_env(uv)
        ensure_config()
        if dev:
            ensure_test_packages(npm)
    except SystemExit as stop:
        if env_stopped_board and isinstance(stop.code, str):
            stop.code += ("\n  The board was stopped to rebuild .venv and is down. Once this is"
                          " fixed, start it with: facilitator run")
        raise
    finally:
        # A failed dependency step can still have created files. Record them so
        # a later uninstall can remove only that partial install's own files.
        owned = previous.copy()
        for name in INSTALL_ARTIFACTS:
            path = artifact_path(name)
            if not before[name] and path.exists():
                owned[name] = file_digest(path) if path.is_file() else "directory"
        INSTALL_RECORD.write_text(json.dumps(owned, indent=2) + "\n")


def board_running(port):
    """True when this board answers on the port right now. The board shape is
    checked, not a bare ping, so another service on the port is not mistaken for
    the board."""
    return board_state(port) is not None


def bridge_note(port):
    """The one line to print when a phone bridge is active, or None. Read only
    and best effort: anything unreadable is treated as no bridge, because the
    note must never fail an uninstall and uninstall must never touch the
    bridge."""
    try:
        ts = find_tailscale()
        if not ts:
            return None
        name = tailnet_name(tailscale_status(ts))
        _, analysis = analyze_bridge(ts, name, port)
        if analysis["active"]:
            return "A phone bridge is active. Turn it off with: facilitator bridge off"
    except SystemExit:
        return None
    except (OSError, ValueError, KeyError, TypeError):
        return None
    return None


def remove_path(path):
    """Remove one file, directory or symlink when it is there; True when
    something went. A directory symlink is unlinked, never followed into its
    target, so a linked .venv is severed and its target left whole."""
    try:
        if path.is_symlink() or path.is_file():
            path.unlink()
            return True
        if path.is_dir():
            shutil.rmtree(path)
            return True
    except OSError as error:
        sys.exit(problem(f"Could not remove {path.name}: {error.strerror or 'error'}.",
                         "Fix that, then run uninstall again."))
    return False


def file_digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def artifact_path(name):
    """Where the thing the install record calls name is: the environment and
    the two config files in data/, the test packages in app/tests, and what an
    install before --dev made at the checkout's top. The names stay what the
    record has always used, so a record the move carried into data/ still
    names what this install made."""
    if name == "tests/node_modules":
        return TESTS_DIR / "node_modules"
    if name in ("node_modules", "package.json", "package-lock.json"):
        return CLONE / name
    return DATA / name


def read_install_record():
    if INSTALL_RECORD.is_symlink():
        sys.exit(problem(f"{INSTALL_RECORD.name} is a symlink.",
                         "Facilitator will not modify it."))
    if not INSTALL_RECORD.exists():
        return {}
    try:
        record = json.loads(INSTALL_RECORD.read_text())
        if not isinstance(record, dict) or any(k not in INSTALL_ARTIFACTS for k in record):
            raise ValueError("invalid install record")
        return record
    except (OSError, ValueError):
        sys.exit(problem(f"{INSTALL_RECORD.name} is invalid.",
                         "Facilitator will not guess which files belong to it."))


def banner(role):
    """The installer's block-letter title with the role under it, coloured only
    on a terminal."""
    tty = sys.stdout.isatty()
    rows = [" ".join(BANNER_GLYPHS[c][n] for c in "FACILITATOR") for n in range(5)]
    for row in rows:
        out = ""
        for i, ch in enumerate(row):
            t = i / max(len(row) - 1, 1)
            r, g, b = int(190 + 55 * t), int(55 + 91 * t), int(30 + 45 * t)
            out += f"\033[38;2;{r};{g};{b}m{ch}" if ch != " " and tty else ch
        print(out + ("\033[0m" if tty else ""))
    print(" " * (len(rows[0]) - len(role)) + role)


def attachment_dirs():
    """The attachment folders that are there, each once."""
    found, seen = [], set()
    for path in ATTACHMENT_DIRS:
        if (path.exists() or path.is_symlink()) and os.path.realpath(path) not in seen:
            seen.add(os.path.realpath(path))
            found.append(path)
    return found


def keep_attachments(answer):
    """True unless the owner clearly says no. A flag answers without a prompt;
    Enter, anything unclear or no terminal to ask on keeps them."""
    if answer is not None:
        return answer
    print()
    if not sys.stdin.isatty():
        skipped("Keeping your card attachments: there is no terminal to ask on.")
        print("Pass --remove-attachments to remove them.")
        return True
    try:
        said = input(ATTACHMENT_QUESTION)
    except EOFError:
        print("")
        return True
    except KeyboardInterrupt:
        print("")
        sys.exit(problem("Stopped at the attachments question.", "Nothing was removed.", blank=True))
    return said.strip().lower() not in ("n", "no")


def remove_attachments(path):
    """Remove one attachment folder and nothing above it. A link is left alone
    rather than followed, and rmtree unlinks any link inside without following
    it, so nothing outside the folder goes."""
    if path.is_symlink():
        skipped(f"Kept card attachments link {path}.")
        print("A link is not followed. Remove it by hand.")
    elif not path.is_dir():
        skipped(f"Kept {path}: it is not a folder.")
    else:
        try:
            shutil.rmtree(path)
        except OSError as error:
            sys.exit(problem(f"Could not remove {path}: {error.strerror or 'error'}.",
                             "Fix that, then run uninstall again."))
        ok(f"Removed card attachments folder {path}.")


def cmd_uninstall(args):
    """Take away exactly what install made, always keeping the board's data.
    Right after the banner, asks whether to keep the card attachments.
    Refuses while the server is up, and never removes this folder."""
    words = args[1:]
    if any(w in ("-h", "--help") for w in words):
        print(UNINSTALL_HELP)
        return
    extra = [w for w in words if w not in ("--keep-attachments", "--remove-attachments")]
    if extra:
        sys.exit(problem("Unknown option: " + " ".join(extra) + ".",
                         "uninstall takes --keep-attachments or --remove-attachments.")
                 + "\n\n" + UNINSTALL_HELP)
    if "--keep-attachments" in words and "--remove-attachments" in words:
        sys.exit(problem("Both --keep-attachments and --remove-attachments were given.",
                         "Give one of them, not both."))
    answer = (True if "--keep-attachments" in words
              else False if "--remove-attachments" in words else None)

    banner("uninstaller")
    port = board_port()
    if board_running(port):
        sys.exit(problem(f"The board is up on port {port}.",
                         "Stop that server first, then run uninstall again."))

    owned = read_install_record()
    attachments = attachment_dirs()
    section("Card attachments")
    print("Uninstall asks about your card attachments first, apart from the")
    print("rest of the board's data. Only a clear no removes them.")
    print()
    if attachments:
        print("Your card attachments are in:")
        for path in attachments:
            print(f"  {path}")
        keep = keep_attachments(answer)
    else:
        print("No card attachments found.")
        keep = True

    print()
    import shell_integration
    removed_before = shell_integration.done
    shell_integration.QUIET = True
    try:
        shell_integration.uninstall()
    finally:
        shell_integration.QUIET = False
    if shell_integration.done > removed_before:
        ok("facilitator command and agent skill removed")

    for label in INSTALL_ARTIFACTS:
        path = artifact_path(label)
        marker = owned.get(label)
        if marker is None:
            if path.exists():
                skipped(f"Kept {label}: it is not recorded as installer-owned.")
        elif marker != "directory" and (not path.is_file() or file_digest(path) != marker):
            skipped(f"Kept {label}: it has changed since install.")
        elif remove_path(path):
            ok(f"Removed {label}.")
    if INSTALL_RECORD.exists():
        INSTALL_RECORD.unlink()

    if not keep:
        for path in attachments:
            remove_attachments(path)

    note = bridge_note(port)
    if note:
        print()
        print(note)

    print()
    print(f"{style('38;2;0;114;0', '✦')} Uninstall finished.")
    print()
    print("This folder was left in place.")


# --- update: pull forward only, then the pulled code runs its own update steps ---
UPDATES_DIR = HERE / "updates"
UPDATE_RECORD = DATA / ".facilitator-updates.json"
UPDATE_RECORD_TMP = DATA / ".facilitator-updates.tmp"
UPDATE_STEP_NAME = re.compile(r"^\d{4}-[A-Za-z0-9._-]+\.(?:py|sh)$")
UPDATE_HELP = """usage: facilitator update

Bring this checkout up to date. Stops, changing nothing, when the checkout has
uncommitted changes, is not on a branch, or has no upstream. Pulls that
upstream forward only (git pull --ff-only), then runs the pulled code's update
steps. On a checkout from before data/, they first move the board's files into
data/, once: everything is backed up into data/backups, copied and checked by
checksum, and the old copies are removed only after the board, started again
on the new code, shows every card it had. The board cannot start until the move
is done; running facilitator update again finishes a move that was cut off.
Then they sync the .venv to requirements.txt, and run each numbered step in
app/updates/ that has not run here yet. A .venv that is missing, broken or not
on Python 3.14 is built again on it first; that needs uv 0.9.0 or newer, and an
older uv stops the update with one line. A board running on the old .venv is
stopped before the rebuild and started again after. Otherwise restarts the
board only when it is running and the pull changed the board's own code (a
Python file in app/ or a requirements file) or update steps ran; when only
pages changed, the board keeps running and a reload shows them."""


def run_git(*args, env=None):
    """One git command in this checkout with its output captured."""
    return subprocess.run(["git", "-C", str(CLONE), *args], capture_output=True,
                          text=True, errors="replace", env=env)


def stage(name):
    """The stage line the board's progress bar reads (downloading, setting-up,
    restarting), on an update the board started; nothing from a terminal."""
    if FROM_BOARD:
        print(f"@stage {name}", flush=True)


# the files a running board has loaded and a reload cannot bring in: its Python
# in app/ and the packages the requirements files install. Pages, scripts and
# styles are read from disk on every request, and the tests, the tools and this
# command are no part of the server
def server_file(path):
    """Whether a file the pull changed, named from the checkout's top, is one
    of the board's own code."""
    if not path.startswith("app/") or path.startswith(("app/tests/", "app/tools/")):
        return False
    name = path.rsplit("/", 1)[-1]
    return name.endswith(".py") or (name.startswith("requirements") and name.endswith(".txt"))


def restart_needed(changed, ran):
    """A restart is due when the pull changed a file of the board's own code,
    when update steps ran (they change what the board runs with), and when
    what the pull changed cannot be read (changed is None)."""
    return changed is None or bool(ran) or any(server_file(path) for path in changed)


def changed_files(before):
    """The files changed between that commit and HEAD, named from the
    checkout's top, or None when they cannot be read."""
    if not before:
        return None
    diff = run_git("diff", "--name-only", "-z", before, "HEAD")
    if diff.returncode != 0:
        return None
    return [name for name in diff.stdout.split("\0") if name]


def board_version():
    """The version label shown on the board, read from index.html."""
    try:
        text = (HERE / "index.html").read_text(encoding="utf-8", errors="replace")
    except OSError:
        return "unknown"
    found = re.search(r'id="npversion">([^<]*)<', text)
    return found.group(1).strip() if found else "unknown"


def check_checkout():
    """Stop unless this is a clean git checkout on a branch with an upstream; return (remote, upstream branch)."""
    top = run_git("rev-parse", "--show-toplevel")
    if top.returncode != 0 or os.path.realpath(top.stdout.strip()) != os.path.realpath(CLONE):
        sys.exit(problem("This folder is not a git checkout, so it cannot be updated.",
                         "Clone Facilitator again with git, then run ./install.sh there."))
    status = run_git("--no-optional-locks", "status", "--porcelain", "--untracked-files=no")
    if status.returncode != 0:
        sys.exit(problem("git could not read this checkout.", *status.stderr.strip().splitlines()[-3:],
                         "Nothing was changed."))
    changed = status.stdout.splitlines()
    if changed:
        shown = [line.strip() for line in changed[:8]]
        if len(changed) > 8:
            shown.append(f"and {len(changed) - 8} more")
        sys.exit(problem("This checkout has uncommitted changes.", *shown,
                         "Commit or discard them, then run facilitator update again.",
                         "Nothing was changed."))
    ok("No uncommitted changes.")
    branch = run_git("symbolic-ref", "--short", "-q", "HEAD").stdout.strip()
    if not branch:
        sys.exit(problem("This checkout is not on a branch, so there is nothing to follow.",
                         "Switch back to a branch, then run facilitator update again.",
                         "Nothing was changed."))
    remote = run_git("config", "--get", f"branch.{branch}.remote").stdout.strip()
    merge = run_git("config", "--get", f"branch.{branch}.merge").stdout.strip()
    if not remote or not merge:
        where = "origin" if "origin" in run_git("remote").stdout.split() else "<remote>"
        sys.exit(problem(f"Branch {branch} has no upstream, so there is nothing to pull from.",
                         f"Set one with: git branch --set-upstream-to={where}/{branch}",
                         "Then run facilitator update again. Nothing was changed."))
    upstream = merge.removeprefix("refs/heads/")
    ok(f"Branch {branch} follows {remote}/{upstream}.")
    return remote, upstream


def pull_forward(remote, upstream):
    """Fast-forward only pull of that one branch, no tags; return the commit before and after."""
    before = run_git("rev-parse", "HEAD").stdout.strip()
    result = run_git("pull", "--ff-only", "--no-rebase", "--no-tags", remote, upstream,
                     env={**os.environ, "LC_ALL": "C"})
    after = run_git("rev-parse", "HEAD").stdout.strip()
    if result.returncode != 0:
        output = (result.stdout + result.stderr).strip().splitlines()
        if "fast-forward" in " ".join(output).lower():
            sys.exit(problem("This checkout cannot be moved forward on its own.",
                             "It has changes of its own that the upstream does not have,",
                             "or the upstream's history was rewritten.",
                             "Nothing was changed. Ask whoever looks after this copy before",
                             "going further."))
        sys.exit(problem(f"git could not pull {remote}/{upstream}.", *output[-4:],
                         "Nothing was changed." if after == before else
                         "Check the lines above before going further.",
                         "Fix that, then run facilitator update again."))
    return before, after


def cmd_update(args):
    """Check, pull, then hand over to the pulled code's _update-steps in a new process."""
    words = args[1:]
    if any(w in ("-h", "--help") for w in words):
        print(UPDATE_HELP)
        return
    if words:
        sys.exit(problem("update takes no options; got " + " ".join(words) + ".")
                 + "\n\n" + UPDATE_HELP)
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(line_buffering=True)
    banner("updater")
    stage("downloading")
    if not shutil.which("git"):
        sys.exit(problem("git was not found.", "Install git, then run facilitator update again."))

    section("1. Checkout")
    print("Update first checks that this folder is a git checkout with no\n"
          "uncommitted changes and a branch to follow. It changes nothing.\n")
    old_version = board_version()
    remote, upstream = check_checkout()

    before, after = pull_forward(remote, upstream)
    stage("setting-up")

    # through the launcher at the checkout's top, the one fixed entry: older
    # code hands over the same way, and the pulled code says where it lives.
    # The commit before the pull goes along, so the pulled code can tell what
    # changed and restart the board only when its own code did
    command = [sys.executable, str(CLONE / "facilitator"), "_update-steps",
               "--from-version", old_version]
    if before != after:
        command += ["--pulled", "--from-commit", before]
    sys.stdout.flush()
    sys.exit(subprocess.run(command, cwd=str(CLONE),
                            env={**os.environ, "FACILITATOR_INTERNAL_UPDATE": "1"}).returncode)


def read_update_record():
    """Step name to time for every step that has run here; an unreadable file stops the update."""
    if not UPDATE_RECORD.exists():
        return {}
    try:
        ran = json.loads(UPDATE_RECORD.read_text())["ran"]
        if not isinstance(ran, dict):
            raise ValueError("ran is not an object")
        return ran
    except (OSError, ValueError, KeyError, TypeError):
        sys.exit(problem(f"{UPDATE_RECORD.name} is invalid.",
                         "Facilitator will not guess which update steps already ran.",
                         "Delete it to run every step again, then run facilitator update."))


def record_update_step(ran, name):
    ran[name] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    UPDATE_RECORD_TMP.write_text(json.dumps({"ran": ran}, indent=2) + "\n")
    os.replace(UPDATE_RECORD_TMP, UPDATE_RECORD)


def run_update_step(path):
    """Run one step with no input and return its exit status; .py under the .venv python, .sh under bash."""
    argv = [server_python(), str(path)] if path.suffix == ".py" else ["bash", str(path)]
    try:
        return subprocess.run(argv, cwd=str(CLONE), stdin=subprocess.DEVNULL).returncode
    except OSError as error:
        print(f"Could not start it: {error.strerror or 'error'}.")
        return 1


def run_update_steps():
    """Run the unrecorded numbered steps in name order; the first failure stops and is not recorded.
    Returns the names of the steps that ran."""
    ran = read_update_record()
    names = sorted(path.name for path in UPDATES_DIR.iterdir()
                   if UPDATE_STEP_NAME.match(path.name)) if UPDATES_DIR.is_dir() else []
    pending = [name for name in names if name not in ran]
    if not pending:
        ok("No new update steps.")
        return []
    for name in pending:
        print(f"Running {name}.")
        if run_update_step(UPDATES_DIR / name) != 0:
            sys.exit(problem(f"Update step {name} failed.",
                             "Its output is above. It was not marked as done and runs again next time.",
                             "Fix the cause, then run facilitator update again."))
        record_update_step(ran, name)
        ok(f"{name} done.")
    return pending


# --- the move: an older checkout's board files into data/, once -------------
#
# A checkout from before data/ kept the board's files at its top, and its
# attachments and logs in facilitator-internal/ beside it. The pulled code
# moves them into data/ before anything else, because the .venv the update
# steps run on is one of them. data_folder.py does the files; this stops and
# starts the board around them and checks the board's cards before the old
# copies go.

# set once the move has stopped this folder's board, so a step that fails
# after it can say the board stays down until the move is done
move_stopped_board = False


def human_size(count):
    for unit in ("bytes", "KB", "MB", "GB"):
        if count < 1024 or unit == "GB":
            return f"{count:.0f} {unit}" if unit == "bytes" else f"{count:.1f} {unit}"
        count /= 1024
    return f"{count:.1f} GB"


def refuse_plan(made):
    """Stop the move, with nothing moved, on a clash or a disk without room."""
    import data_folder
    if made["conflicts"]:
        raise data_folder.Refused(
            "These files are in their old place and in data/ both, and they differ:",
            *[f"{c['from']}  and  {DATA / c['to']}" for c in made["conflicts"]],
            "Move one of each pair out of the way, then run facilitator update again.",
            "Nothing was moved.")
    if made["need"] > made["free"]:
        raise data_folder.Refused(
            f"There is not enough free space to back up and copy the board's files: they need "
            f"{human_size(made['need'])} and {human_size(made['free'])} is free.",
            "Free some space, then run facilitator update again. Nothing was moved.")


def stop_old_board():
    """Stop this folder's board, when one is running, before its files are
    moved: True when one was stopped. It is found where the old run.config.json,
    the old server.lock and data/'s config point, counted only when it names
    this checkout, and stopped by the same identity checks restart uses, which
    accept a board still running the code from before data/."""
    import data_folder
    global move_stopped_board
    ports = []
    for config in (CLONE / "run.config.json", CONFIG):
        try:
            ports.append(int(json.loads(config.read_text()).get("port") or 0))
        except (OSError, ValueError, TypeError, AttributeError):
            pass
    try:
        ports.append(int(json.loads((CLONE / "server.lock").read_text()).get("port") or 0))
    except (OSError, ValueError, TypeError, AttributeError):
        pass
    for port in dict.fromkeys(p for p in ports if 1 <= p <= 65534):
        if not this_board(board_state(port)):
            continue
        owner, refusal = server_process(port)
        if refusal is None and owner is not None:
            refusal = stop_server(owner, port)
        if refusal:
            raise data_folder.Refused(f"The board could not be stopped to move its files: {refusal}.",
                                      "Nothing was moved. Stop the board, then run facilitator update again.")
        if owner is not None:
            move_stopped_board = True
            print(f"Stopped the board on port {port} to move its files.")
            return True
    return False


def say_move(kind, *words):
    if kind == "backup":
        name, count, size = words
        ok(f"Backed up {count} files ({human_size(size)}) to data/backups/{name}.")
    elif kind == "backup-kept":
        ok(f"Kept the backup an earlier run made: data/backups/{words[0]}.")
    elif kind == "copied":
        count, size = words
        ok(f"Copied {count} files ({human_size(size)}) into data/ and checked each one.")
    elif kind == "venv":
        ok("Moved .venv into data/.")


def old_statusline_pattern(old):
    """Matches the old script's path as a word of a command, so another
    checkout's path, or a longer file name after it, is not taken for it."""
    return re.compile(r"(?<![\w./~-])" + re.escape(str(old)) + r"(?![\w./-])")


def rewrite_command_literal(raw, old, new):
    """raw, the JSON string literal of a status line command, with only the old
    script's path changed to the new one; None when the command does not run
    the old script. The literal is edited in place when the path is written out
    plainly in it, so everything else in it stays as it was."""
    pattern = old_statusline_pattern(old)
    command = json.loads(raw)
    if not isinstance(command, str) or not pattern.search(command):
        return None
    changed = pattern.sub(lambda found: str(new), command)
    for ascii_only in (True, False):
        spelled_old = json.dumps(str(old), ensure_ascii=ascii_only)[1:-1]
        spelled_new = json.dumps(str(new), ensure_ascii=ascii_only)[1:-1]
        edited = re.sub(r"(?<![\w./~-])" + re.escape(spelled_old) + r"(?![\w./-])",
                        lambda found: spelled_new, raw)
        if edited != raw and json.loads(edited) == changed:
            return edited
    return json.dumps(changed, ensure_ascii=False)


def back_up_settings(settings):
    """A copy of the settings file in data/backups, beside the move's own
    backups, private like them; its name. Nothing reads or removes it."""
    import data_folder
    backups = DATA / data_folder.BACKUPS
    backups.mkdir(mode=0o700, parents=True, exist_ok=True)
    stem = "claude-settings-before-statusline-move-" + time.strftime("%Y%m%d-%H%M%S")
    name, count = stem + ".json", 0
    while (backups / name).exists() or (backups / name).is_symlink():
        count += 1
        name = f"{stem}-{count}.json"
    content = Path(os.path.realpath(settings)).read_bytes()
    descriptor = os.open(backups / name, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "wb") as out:
        out.write(content)
    if (backups / name).read_bytes() != content:
        raise OSError("the backup copy does not match")
    return name


def fix_statusline_file(settings, old, new):
    """Change the old script's path in the status line command of settings to
    the new one, after backing the file up, and say so. Returns "fixed", "none"
    when there is nothing to change, or "hint" when the file names the old path
    and could not be changed, with the file as it was."""
    import shell_integration
    try:
        text = shell_integration.read_settings(settings)
    except (OSError, ValueError):
        # not JSON, or not readable: it is only worth a word if it names the path
        try:
            named = str(old) in settings.read_bytes().decode("utf-8", "replace")
        except OSError:
            named = False
        return "hint" if named else "none"
    if text is None:
        return "none"
    try:
        _, span = shell_integration.statusline_spans(text)
        edited = None if span is None else rewrite_command_literal(text[span[0]:span[1]], old, new)
    except ValueError:
        return "none"
    if edited is None:
        return "none"
    try:
        name = back_up_settings(settings)
        shell_integration.write_settings(settings, text[:span[0]] + edited + text[span[1]:])
    except OSError:
        return "hint"
    ok(f"Changed the status line command in {settings} to run {new}. "
       f"The file before is in data/backups/{name}.")
    return "fixed"


def update_statusline_record(old, new):
    """The status line record, with the old script's path changed to the new
    one wherever it holds it, once the settings file it names shows the new
    entry, so uninstall still finds the entry as install wrote it."""
    import shell_integration
    try:
        record = shell_integration.statusline_record()
        if record is None:
            return
        pattern = old_statusline_pattern(old)
        entry = dict(record["entry"])
        command = entry.get("command")
        if record["script"] != str(old) and not (isinstance(command, str) and pattern.search(command)):
            return
        if isinstance(command, str):
            entry["command"] = pattern.sub(lambda found: str(new), command)
        swapped = dict(record, entry=entry)
        if record["script"] == str(old):
            swapped["script"] = str(new)
        text = shell_integration.read_settings(Path(record["settings"]))
        whole, _ = shell_integration.statusline_spans(text) if text is not None else (None, None)
        if whole is None or json.loads(text[whole[0]:whole[1]]) != entry:
            return
        temporary = shell_integration.STATUSLINE_RECORD.with_suffix(".tmp")
        temporary.write_text(json.dumps(swapped, indent=2) + "\n")
        os.replace(temporary, shell_integration.STATUSLINE_RECORD)
    except (OSError, ValueError):
        return


def statusline_fix():
    """Keep Claude Code's status line running after the script moved into
    app/. A status line command that runs this checkout's old
    <checkout>/claude-statusline.py gets only that path changed, in Claude
    Code's settings and in the file the status line record names; any other
    command is left alone. When a file cannot be changed, say how to by hand."""
    import shell_integration
    root = os.environ.get("CLAUDE_CONFIG_DIR")
    files = [(Path(root).expanduser() if root else Path.home() / ".claude") / "settings.json"]
    try:
        record = shell_integration.statusline_record()
    except (OSError, ValueError):
        record = None
    if record:
        files.insert(0, Path(record["settings"]))
    old, new = CLONE / "claude-statusline.py", HERE / "claude-statusline.py"
    seen = set()
    for settings in files:
        key = os.path.realpath(settings)
        if key in seen:
            continue
        seen.add(key)
        if fix_statusline_file(settings, old, new) == "hint":
            print(f"Claude Code's status line still runs {old}, which is now {new}.")
            print(f"Change it in {settings} so the home page's limits stay current.")
    update_statusline_record(old, new)


def move_data(number):
    """The move, when this checkout still has board files in their old place
    or a move that did not finish, as section number; else nothing at all.
    Returns what the Board step and the finish need to know."""
    import data_folder
    where = data_folder.state(CLONE)
    if where in ("none", "done"):
        return {"shown": False, "finish": False, "stopped": False, "running_before": None}
    section(f"{number}. Board files")
    if where == "pending":
        print("The board's files are in data/. The old copies are removed once the\n"
              "board shows your cards from there.\n")
        statusline_fix()
        return {"shown": True, "finish": True, "stopped": False, "running_before": None}
    print("The board's files move into data/ in this folder, once. Everything is\n"
          "backed up first, every copy is checked, and nothing old is removed\n"
          "until the board shows your cards from data/.\n")
    # a run cut off after it stopped the board says so in its marker, so this
    # one starts the board again at the end as that one would have
    global move_stopped_board
    remembered = bool(data_folder.read_marker(CLONE).get("stopped_board"))
    move_stopped_board = move_stopped_board or remembered
    try:
        refuse_plan(data_folder.plan(CLONE, light=True))
        stopped = stop_old_board() or remembered
        if stopped:
            data_folder.note_stopped_board(CLONE)
        with data_folder.Locks(CLONE):
            made = data_folder.plan(CLONE)
            refuse_plan(made)
            data_folder.move(CLONE, made, say=say_move, stopped_board=stopped)
    except data_folder.Refused as no:
        sys.exit(problem(no.headline, *no.lines))
    except (KeyboardInterrupt, OSError) as error:
        if isinstance(error, KeyboardInterrupt):
            why, then = "it was interrupted", "Run facilitator update again"
        else:
            why = f"{error.strerror or error}" + (f": {error.filename}" if getattr(error, "filename", None) else "")
            then = "Fix that, then run facilitator update again"
        if data_folder.state(CLONE) == "moving":
            sys.exit(problem(f"The move into data/ stopped part way: {why}.", "Nothing old was removed.",
                             f"{then}: it carries on from here."))
        sys.exit(problem(f"The move into data/ did not start: {why}.", f"Nothing was moved. {then}."))
    statusline_fix()
    return {"shown": True, "finish": True, "stopped": stopped, "running_before": stopped}


def new_board_up(port):
    """The identity of the board answering on port when it is this checkout's
    and runs app/server.py, else None."""
    if not this_board(board_state(port)):
        return None
    owner, refusal = server_process(port)
    if refusal or owner is None or len(owner[1][2]) != 2 or owner[1][2][1] != str(HERE / "server.py"):
        return None
    return owner


def finish_move(moved):
    """Remove the old copies once the board, running from app/, shows every
    card the old state.json held. A board the move found stopped is started
    here to check, with no window, and stopped again after. Anything that
    cannot be proved keeps every old copy, and the next update tries again."""
    import data_folder
    if not moved["finish"]:
        return
    record = data_folder.read_record(CLONE)
    if not record or record.get("finished"):
        return
    port = board_port()
    started = None
    kept_why = None
    if new_board_up(port) is None:
        if moved["running_before"]:
            kept_why = "the board did not come back up from app/"
        else:
            started, refusal = start_and_confirm(port)
            if refusal:
                kept_why = f"the board could not be started to check your cards: {refusal}"
            else:
                print(f"Started the board on port {port} to check your cards on the new layout.")
    if kept_why is None:
        ids = record.get("card_ids") or []
        st = board_state(port)
        shown = {str(box.get("id")) for box in (st or {}).get("boxes", []) if isinstance(box, dict)}
        missing = [card for card in ids if card not in shown]
        if not record.get("state_readable", True):
            kept_why = "the old state.json could not be read, so the cards could not be checked"
        elif st is None:
            kept_why = "the board did not answer when its cards were read"
        elif missing:
            kept_why = (f"{len(missing)} of the {len(ids)} cards the old state.json held are not on the board "
                        f"(for example {missing[0]})")
        else:
            ok(f"The board shows all {len(ids)} cards from data/.")
            removed, kept = data_folder.finish(CLONE)
            where = f" The backup stays in data/backups/{record['backup']}." if record.get("backup") else ""
            ok(f"Removed the old copies ({removed} files).{where}")
            for path, why in kept:
                skipped(f"Kept {path}: {why}.")
    if kept_why:
        skipped(f"Kept the old copies: {kept_why}.")
        print("They are removed by the next facilitator update once the board shows your cards.")
    if started is not None:
        refusal = stop_server(started, port)
        if refusal:
            print(f"The board started for the check is still running: {refusal}.")
        else:
            print("Stopped the board again, as it was before the update.")


def restart_board(pulled, stopped=False, why="rebuild .venv", needed=True):
    """Safe restart, only when something was pulled that needs one (needed:
    the board's own code changed, or steps ran) and the board is running, or a
    start when the move or the .venv rebuild stopped it; False if it was
    refused."""
    if stopped:
        print(f"The board was stopped to {why}. Starting it again.\n")
    elif not pulled:
        skipped("Nothing was pulled, so the board was left as it is.")
        return True
    elif not needed:
        skipped("The board's own code did not change, so it was not restarted.")
        return True
    else:
        port = board_port()
        if not board_running(port):
            skipped(f"The board is not running on port {port}, so it was not started.")
            print("Start it with: facilitator run")
            return True
        print("The board is running. Restarting it onto the new code.\n")
    stage("restarting")
    try:
        cmd_restart(["restart"])
    except SystemExit as stop:
        print(problem("The board was not restarted.", str(stop.code),
                      "Restart it yourself with: facilitator restart", blank=True),
              file=sys.stderr)
        return False
    return True


def cmd_update_steps(args):
    """Run by the pulled code: sync the .venv, run pending steps, restart if due, report the versions."""
    words = args[1:]
    pulled = "--pulled" in words
    old_version = words[words.index("--from-version") + 1] if "--from-version" in words[:-1] else None
    # the commit before the pull, from an update that names it; without it
    # (an older update handing over) everything counts as changed
    from_commit = words[words.index("--from-commit") + 1] if "--from-commit" in words[:-1] else None
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(line_buffering=True)

    number = 2
    try:
        # first, before uv or .venv: the .venv may be one of the files that move
        moved = move_data(number)
        number += moved["shown"]
        stopped = ensure_env(ensure_uv(quiet=True), quiet=True)

        section(f"{number}. Update steps")
        print("Numbered steps in the updates folder run once each, in order.\n"
              "A step that fails stops the update and runs again next time.\n")
        ran = run_update_steps()
    except SystemExit as stop:
        import data_folder
        unmoved = data_folder.state(CLONE) in ("unmoved", "moving")
        if isinstance(stop.code, str) and unmoved and move_stopped_board:
            stop.code += ("\n  The board stays down until its files are in data/. Once the update goes through,"
                          " it starts again: run facilitator update.")
        elif unmoved:
            # the move refused before stopping anything: the next update moves
            # the files and restarts the board itself, as the lines above say
            pass
        elif (pulled or env_stopped_board or move_stopped_board) and isinstance(stop.code, str):
            stop.code += ("\n  The board was not restarted. Once the update goes through, run:"
                          " facilitator restart")
        raise

    section(f"{number + 1}. Board")
    if moved["stopped"]:
        restarted = restart_board(pulled, True, "move its files into data/")
    else:
        needed = restart_needed(changed_files(from_commit) if pulled else [], ran)
        restarted = restart_board(pulled, stopped, needed=needed)
    finish_move(moved)

    new_version = board_version()
    green = style("38;2;0;114;0", "✦")
    print()
    if pulled:
        print(f"{green} Facilitator updated.\n")
        print(f"Old version: {old_version or 'unknown'}")
        print(f"New version: {new_version}\n")
        print("Reload the board in your browser and reopen the phone app.\n")
    else:
        print(f"{green} Already up to date ({new_version}).\n")
    if not restarted:
        sys.exit(1)


# Chrome keeps "Use graphics acceleration when available" in the Local State
# file of its user data folder, as hardware_acceleration_mode.enabled; when the
# key is not there it is on. Chrome reads it once at launch and writes its own
# copy back while it runs and as it quits, so it is changed only with Chrome
# fully quit. The board opens in the main Chrome, so that folder is the one.
CHROME_DATA = Path.home() / "Library" / "Application Support" / "Google" / "Chrome"


def chrome_accel_state(local_state):
    """True when the toggle is on (the key true or absent, or no Local State yet),
    False when it is clearly off, None when the file cannot be read, so nothing
    is said or changed."""
    try:
        data = json.loads(local_state.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return True
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict):
        return None
    mode = data.get("hardware_acceleration_mode")
    if not isinstance(mode, dict) or "enabled" not in mode:
        return True
    return mode["enabled"] if isinstance(mode["enabled"], bool) else None


def chrome_pid(folder):
    """The pid of the Chrome running on that user data folder, or None. Chrome
    holds a SingletonLock link there, to host-pid, for as long as it runs; one
    left behind by a crash names a process that is gone."""
    try:
        pid = int(os.readlink(folder / "SingletonLock").rsplit("-", 1)[1])
    except (OSError, ValueError, IndexError):
        return None
    return pid if pid_alive(pid) else None


def pid_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def read_key(valid):
    """One key from the terminal, unechoed, as the installer's other questions
    take it: a key that is not an answer, Enter too, is ignored. None comes back
    when the input ends. The terminal is put back whatever ends it."""
    import termios
    import tty
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        while True:
            key = os.read(fd, 1).decode("utf-8", "replace").lower()
            if not key:
                return None
            if key in valid:
                return key
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)


def ask_accel(choices, valid):
    """The installer's two-option layout, under what was just printed: the
    choices, then "answer: " on one key. None when the input ends."""
    for choice in choices:
        print(f"  {choice}")
    print()
    print("answer: ", end="", flush=True)
    answer = read_key(valid)
    print(answer or "")
    return answer


def write_accel_on(local_state):
    """Back Local State up beside itself as Local State.facilitator-backup, set
    the toggle on, and read it back. On any failure the file is as it was and
    the reason comes back; None means it was written."""
    try:
        original = local_state.read_bytes()
        data = json.loads(original.decode("utf-8"))
        if not isinstance(data, dict):
            return "Local State is not what Chrome writes"
        mode = data.get("hardware_acceleration_mode")
        data["hardware_acceleration_mode"] = dict(mode if isinstance(mode, dict) else {}, enabled=True)
        shutil.copy2(local_state, local_state.with_name(local_state.name + ".facilitator-backup"))
    except (OSError, ValueError) as error:
        return str(error)

    def replace_with(content):
        fd, tmp = tempfile.mkstemp(dir=local_state.parent, prefix=".Local State.")
        try:
            with os.fdopen(fd, "wb") as out:
                out.write(content)
                out.flush()
                os.fsync(out.fileno())
            os.chmod(tmp, local_state.stat().st_mode & 0o7777)
            os.replace(tmp, local_state)
        except BaseException:
            os.unlink(tmp)
            raise

    try:
        replace_with(json.dumps(data, ensure_ascii=False, separators=(",", ":")).encode("utf-8"))
        if json.loads(local_state.read_text(encoding="utf-8")) != data:
            raise ValueError("it did not read back as written")
    except (OSError, ValueError) as error:
        try:
            if local_state.read_bytes() != original:
                replace_with(original)
        except OSError:
            return f"{error}, and Local State could not be put back: copy Local State.facilitator-backup over it"
        return str(error)
    return None


def cmd_chrome_acceleration(folder=CHROME_DATA):
    """Chrome's graphics acceleration, in the main Chrome. On: one line says so.
    Off with Chrome closed: asks to turn it on and does. Off with Chrome open:
    shows where to turn it on in Chrome and asks when that is done. Asks only on
    a terminal; never quits Chrome and never waits for it."""
    local_state = folder / "Local State"
    state = chrome_accel_state(local_state)
    if state is None:
        return
    section("5. Chrome graphics")
    if state:
        ok("Chrome graphics acceleration is on.")
        return
    if not sys.stdin.isatty():
        skipped("Left Chrome's graphics acceleration off: there is no interactive terminal.")
        return
    if chrome_pid(folder):
        print("Turn on graphics acceleration in Chrome:")
        print()
        print('Settings -> System -> turn on "Use graphics acceleration when available"')
        print()
        answer = ask_accel(["y - I turned gpu acceleration on", "l - I will do it later"], "yl")
        if answer == "y":
            print()
            print("Quit and reopen Chrome for graphics acceleration to take place.")
        return
    print("Turn on Chrome graphics acceleration?")
    print()
    answer = ask_accel(["y - yes (recommended)", "n - no"], "yn")
    if answer != "y":
        return
    print()
    failed = write_accel_on(local_state)
    if failed:
        print(f"⚠ Could not turn on graphics acceleration ({failed}). Chrome's settings were left as they were.")
    else:
        ok("Chrome graphics acceleration is on.")


def installer_step(step, *args, **kwargs):
    """Run one step that install.sh hands to this command. Ctrl+C ends it
    quietly with the interrupted exit status, not a traceback; install.sh's own
    Ctrl+C handler prints the line that ends the run."""
    try:
        step(*args, **kwargs)
    except KeyboardInterrupt:
        sys.exit(130)


# The commands that read or write the board's files or start its server. None
# of them runs while those files are part way through moving into data/, or
# still sit in their old place: a board started then would open fresh from
# seed.json beside the real cards. Only update, which does the move, and help
# go ahead.
GUARDED = frozenset({"run", "restart", "stop", "status", "magic", "bridge", "password",
                     "_password-setup", "_install", "uninstall", "remote"})


def refuse_unfinished_move():
    """Stop here, saying what to run, when the board's files are not yet all
    in data/."""
    import data_folder
    held = data_folder.unfinished(CLONE)
    if held:
        sys.exit(problem(*held, blank=False))


def main():
    args = sys.argv[1:]
    cmd = args[0] if args and not args[0].startswith("-") else "run"
    if cmd in GUARDED and not any(word in ("-h", "--help") for word in args[1:]):
        refuse_unfinished_move()
    if cmd == "run":
        cmd_run(args)
    elif cmd == "restart":
        cmd_restart(args)
    elif cmd == "stop":
        cmd_stop(args)
    elif cmd == "status":
        cmd_status()
