def bridge_action(args):
    """Return (on/off/toggle, dry-run), or print bridge help and return None."""
    words = list(args[1:])
    if any(word in ("-h", "--help") for word in words):
        print(BRIDGE_HELP)
        return None
    dry = False
    actions = []
    for word in words:
        if word == "--dry-run":
            dry = True
        elif word in ("on", "off"):
            actions.append(word)
        else:
            sys.exit(f"unknown bridge option: {word}\n{BRIDGE_HELP}")
    if len(actions) > 1:
        sys.exit("choose one bridge action: on or off\n" + BRIDGE_HELP)
    return (actions[0] if actions else "toggle"), dry


def show_qr(url):
    """The address as a code the phone camera reads, block characters two
    module rows per line. On a terminal the modules are painted in the fixed
    256-colour cube's true black (16) on its true white (231), which colour
    themes do not restyle, so the code is black on white whatever the theme;
    piped, the bare characters are printed. The encoded private address is
    never printed."""
    sys.path.insert(0, str(HERE))
    import qr
    lines = qr.render(qr.encode(url))
    tty = sys.stdout.isatty()
    for line in lines:
        # palette black and bright white (30;107) are theme slots that dark
        # themes draw as grey, which phone cameras struggle to read
        body = ("\x1b[38;5;16;48;5;231m" + line + "\x1b[0m") if tty else line
        print("  " + body)


def show_way_in(url):
    """Only the requested code and the two instructions for the phone."""
    show_qr(url)
    print()
    print("Scan the QR code to access facilitator on your phone 🦑")
    print()
    print("Run `facilitator bridge off` to sever the phone session.")


def change_bridge(ts, command, action):
    """Run one bounded Serve mutation without exposing Tailscale's output."""
    try:
        r = subprocess.run(command, capture_output=True, text=True, encoding="utf-8",
                           env=tailscale_env(), timeout=TAILSCALE_CHANGE_TIMEOUT)
    except subprocess.TimeoutExpired:
        sys.exit(f"tailscale: timed out trying to turn the bridge {action}; inspect `tailscale serve status`")
    except (OSError, UnicodeError):
        sys.exit(f"tailscale: could not turn the bridge {action}; inspect `tailscale serve status`")
    if r.returncode != 0:
        sys.exit(f"tailscale: could not turn the bridge {action}; inspect `tailscale serve status`")


def require_bridge_ready(status, name, port):
    """The conditions needed for an enabled bridge to be usable right now."""
    if status.get("BackendState") != "Running":
        sys.exit("tailscale: not connected; no changes made")
    certs = status.get("CertDomains")
    if (not isinstance(certs, list) or
            name not in {domain.rstrip(".").lower() for domain in certs if isinstance(domain, str)}):
        sys.exit("Tailscale HTTPS is off for this tailnet: switch on HTTPS certificates under DNS in the Tailscale admin console, then run facilitator bridge again.")
    if state(port) is None:
        sys.exit(f"server: DOWN (port {port}); run facilitator run first")
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port + 1}/auth/check", timeout=2) as response:
            gate = json.load(response)
    except (OSError, ValueError):
        sys.exit("bridge: password gate is down; restart the updated server before enabling the bridge")
    if not isinstance(gate, dict) or gate.get("configured") is not True:
        sys.exit("bridge: set the app password with `facilitator password set` first")
    local_pids = listener_pids(port)
    guard_pids = listener_pids(port + 1)
    if (local_pids is None or guard_pids is None or len(local_pids) != 1 or
            local_pids != guard_pids):
        sys.exit("bridge: the password gate is not owned by this board server; no changes made")


def bridge_conflict(analysis):
    sys.exit(f"tailscale: {analysis['why']}; no changes made")


def bridge_off_steps(ts, name, raw, port):
    """Take away this command's own root rule for the pair at port: checked
    against an unchanged Serve config first and read back as gone after."""
    latest, latest_analysis = analyze_bridge(ts, name, port)
    if latest != raw or not latest_analysis["removable"]:
        sys.exit("tailscale: serve configuration changed; no changes made, try again")
    change_bridge(ts, [ts, "serve", "--https=443", "--set-path=/", "off"], "off")
    _, after = analyze_bridge(ts, name, port)
    if after["active"]:
        sys.exit("tailscale: the bridge is still on after Tailscale reported success; inspect `tailscale serve status`")


def bridge_on_steps(ts, status, name, port):
    """Put this command's own root rule in for the pair at port, with the
    checks `bridge on` makes before and after: the board up with its gate,
    nothing else on the root, the tailnet unchanged, the rule read back as on."""
    raw, analysis = analyze_bridge(ts, name, port)
    if analysis["active"] or analysis["enable_blocked"]:
        bridge_conflict(analysis)
    require_bridge_ready(status, name, port)
    latest, latest_analysis = analyze_bridge(ts, name, port)
    if latest != raw or latest_analysis["active"] or latest_analysis["enable_blocked"]:
        sys.exit("tailscale: serve configuration changed; no changes made, try again")
    change_bridge(ts, [ts, "serve", "--bg", "--https=443", "--set-path=/",
                       f"http://127.0.0.1:{port + 1}"], "on")
    fresh_status = tailscale_status(ts)
    if tailnet_name(fresh_status) != name:
        sys.exit("tailscale: tailnet identity changed while enabling the bridge; inspect `tailscale serve status`")
    require_bridge_ready(fresh_status, name, port)
    _, after = analyze_bridge(ts, name, port)
    if not after["on"]:
        sys.exit("tailscale: the bridge is not safely on after Tailscale reported success; inspect `tailscale serve status`")


def move_bridge(ts, status, name, raw, old, new):
    """Point this board's own root rule from the old pair's phone port at the
    new pair's: the new board is checked as `bridge on` checks it before
    anything is touched, then the old rule goes and the new one comes, each
    step checked as those commands check it."""
    require_bridge_ready(status, name, new)
    bridge_off_steps(ts, name, raw, old)
    bridge_on_steps(ts, status, name, new)
    bridge_log("sharemoved", port=new, previous=old)


def repoint_bridge(old, new):
    """After run moved the board: (linked, problem). The phone's Tailscale
    Serve rule is pointed at the new pair only when it is exactly the rule
    `bridge on` made for the old pair; any other rule, and no rule, is left
    alone. Anything that stops it is one plain line, run carries on with the
    board up, and the config keeps the old port as moved_from, so `bridge on`
    can finish the move later and `bridge off` can still take the old rule
    away."""
    ts = find_tailscale()
    if ts is None:
        return False, None
    try:
        status = tailscale_status(ts)
        name = tailnet_name(status)
        raw, analysis = analyze_bridge(ts, name, old)
        if not analysis["on"]:
            return False, None
        move_bridge(ts, status, name, raw, old, new)
        return True, None
    except SystemExit as stop:
        write_config_port(new, moved_from=old)
        return False, (f"The phone link was not moved ({stop.code}); if it was on, it still "
                       f"points at port {old + 1}. Run facilitator bridge on to point it at {new + 1}.")


def moved_rule(raw, name, port):
    """The port of the pair the board moved off, when run left this command's
    own rule for that pair behind and nothing serves the board's own pair;
    else None."""
    moved = board_moved_from()
    if moved is None or moved == port:
        return None
    try:
        if bridge_config(raw, name, port)["active"] or not bridge_config(raw, name, moved)["on"]:
            return None
    except (TypeError, ValueError):
        return None
    return moved


def cmd_bridge(args):
    """Toggle, enable, or disable the persistent Tailscale Serve mapping.

    Every decision comes from fresh Tailscale status. Enabling owns one root
    handler; disabling removes only that handler. Both mutations are checked
    against an unchanged precondition and verified from status afterward."""
    if args[1:2] == ["setup"] and not any(word in ("-h", "--help") for word in args[2:]):
        if args[2:]:
            sys.exit("bridge setup takes no other words; got " + " ".join(args[2:]))
        return installer_step(cmd_bridge_setup)
    parsed = bridge_action(args)
    if parsed is None:
        return
    requested, dry = parsed
    switch_bridge(requested, dry, board_port())


def cmd_bridge_setup():
    """`facilitator bridge setup`: the installer's banner and its Mobile app
    step, run by the installer's own code (installer-lib.sh, which install.sh
    sources too) so the two cannot differ. The password step runs on this
    same Python, which hands over to .venv's as it does at install."""
    lib = HERE / "installer-lib.sh"
    bash = shutil.which("bash")
    if bash is None or not lib.is_file():
        sys.exit(problem("Phone setup could not start.",
                         f"{lib.name} or bash is missing; run ./install.sh in {CLONE}."))
    sys.stdout.flush()
    env = {**os.environ, "PY": sys.executable, "REPO": str(HERE)}
    code = subprocess.call([bash, "-c", 'set -euo pipefail; . "$1"; bridge_setup', "bash", str(lib)], env=env)
    if code:
        sys.exit(code)


def switch_bridge(requested, dry, port, quiet=False):
    """The work of `facilitator bridge` for the board's pair at port. Quiet,
    which run and stop use, prints neither the code and its instructions nor
    "Bridge is off."; every check, change and exit is the same."""
    ts = find_tailscale()
    if ts is None:
        sys.exit("tailscale: not found on PATH or at " + TAILSCALE_APP)
    status = tailscale_status(ts)
    name = tailnet_name(status)
    raw, analysis = analyze_bridge(ts, name, port)
    # the rule this command made for the pair the board moved off, when run
    # could not point it at the new pair: still this board's own, so on moves
    # it across and off takes it away
    moved = moved_rule(raw, name, port)
    desired = ("off" if analysis["active"] or moved else "on") if requested == "toggle" else requested
    url = f"https://{name}/m"

    if moved is not None:
        if dry:
            print(f"bridge: would take the phone link off port {moved + 1}"
                  + (f" and point it at {port + 1}" if desired == "on" else ""))
            return
        if desired == "off":
            bridge_off_steps(ts, name, raw, moved)
            write_config_port(port)
            bridge_log("shareoff", port=moved)
            if not quiet:
                print("Bridge is off.")
            return
        move_bridge(ts, status, name, raw, moved, port)
        write_config_port(port)
        if not quiet:
            show_way_in(url)
        return

    if desired == "off":
        if not analysis["active"]:
            if dry:
                print("bridge: already off; no changes would be made")
            elif not quiet:
                print("Bridge is off.")
            return
        if not analysis["removable"]:
            bridge_conflict(analysis)
        command = [ts, "serve", "--https=443", "--set-path=/", "off"]
        if dry:
            print("bridge: would run " + " ".join(shlex.quote(word) for word in command))
            return
        latest, latest_analysis = analyze_bridge(ts, name, port)
        if latest != raw or not latest_analysis["removable"]:
            sys.exit("tailscale: serve configuration changed; no changes made, try again")
        change_bridge(ts, command, "off")
        _, after = analyze_bridge(ts, name, port)
        if after["active"]:
            sys.exit("tailscale: the bridge is still on after Tailscale reported success; inspect `tailscale serve status`")
        bridge_log("shareoff", port=port)
        if not quiet:
            print("Bridge is off.")
        return

    if analysis["legacy"]:
        bridge_conflict(analysis)
    require_bridge_ready(status, name, port)
    if analysis["on"]:
        if dry:
            print("bridge: already on; no changes would be made")
        elif not quiet:
            show_way_in(url)
        return
    if analysis["active"] or analysis["enable_blocked"]:
        bridge_conflict(analysis)
    command = [ts, "serve", "--bg", "--https=443", "--set-path=/",
               f"http://127.0.0.1:{port + 1}"]
    if dry:
        print("bridge: would run " + " ".join(shlex.quote(word) for word in command))
        return
    latest, latest_analysis = analyze_bridge(ts, name, port)
    if latest != raw or latest_analysis["active"] or latest_analysis["enable_blocked"]:
        sys.exit("tailscale: serve configuration changed; no changes made, try again")
    change_bridge(ts, command, "on")
    fresh_status = tailscale_status(ts)
    if tailnet_name(fresh_status) != name:
        sys.exit("tailscale: tailnet identity changed while enabling the bridge; inspect `tailscale serve status`")
    require_bridge_ready(fresh_status, name, port)
    _, after = analyze_bridge(ts, name, port)
    if not after["on"]:
        sys.exit("tailscale: the bridge is not safely on after Tailscale reported success; inspect `tailscale serve status`")
    bridge_log("shareon", port=port)
    if not quiet:
        show_way_in(url)


def bridge_set_up():
    """True when this checkout has a phone password, which is what makes run
    and stop look after the phone link. Nothing is made to find out: a checkout
    with no password file, or with no phone code beside the command, is not
    asked and no lock file appears."""
    if not (HERE / "bridge_auth.py").is_file():
        return False
    try:
        import bridge_auth
        return bridge_auth.AUTH_FILE.exists() and bridge_auth.configured()
    except (ImportError, OSError):
        return False


def follow_bridge(requested, port):
    """What run and stop do about the phone link, through the same code and
    checks as `facilitator bridge on` and `off`, silently. None when it went
    through, else the one plain line saying the link is not as asked and why.
    A stop with no Tailscale at all has no link to take away and says nothing.
    Whatever goes wrong here is a line and never the outcome of the command."""
    if requested == "off" and find_tailscale() is None:
        return None
    try:
        switch_bridge(requested, False, port, quiet=True)
    except SystemExit as stop:
        reason = str(stop.code)
    except Exception as error:
        reason = f"{type(error).__name__} while talking to tailscale"
    else:
        return None
    if requested == "on":
        return f"The phone link is off ({reason}). Run facilitator bridge on when that is fixed."
    return f"The phone link could not be taken off ({reason}). Run facilitator bridge off when that is fixed."


