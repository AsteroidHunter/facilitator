def board_port():
    """The board's port from run.config.json when there is one; the server's
    own default otherwise, so the bridge works on a machine with no lanes
    written down yet."""
    if not CONFIG.exists():
        return DEFAULT_PORT
    try:
        return int(json.loads(CONFIG.read_text()).get("port") or DEFAULT_PORT)
    except (ValueError, TypeError, AttributeError, OSError):
        return DEFAULT_PORT


def board_moved_from():
    """The port of the pair the board moved off when run could not point the
    phone's link at the new pair at the time, or None. Kept in run.config.json
    as moved_from until the bridge command has dealt with the old rule."""
    try:
        moved = json.loads(CONFIG.read_text()).get("moved_from")
    except (ValueError, TypeError, AttributeError, OSError):
        return None
    if isinstance(moved, int) and not isinstance(moved, bool) and 1 <= moved <= 65534:
        return moved
    return None


def find_tailscale():
    """The tailscale command line: PATH first, then inside the Mac app."""
    found = shutil.which("tailscale")
    if found:
        return found
    if os.access(TAILSCALE_APP, os.X_OK):
        return TAILSCALE_APP
    return None


def tailscale_env():
    """The environment each tailscale call runs in. Tailscale's Mac app is also
    its command, and acts as the command only when it sees a terminal's
    variables; run from an app or at login there are none, so TAILSCALE_BE_CLI,
    Tailscale's own switch for this, says it outright."""
    return {**os.environ, "TAILSCALE_BE_CLI": "1"}


def tailscale_json(ts, args, label):
    """One bounded, read-only Tailscale query. Its output stays private even
    on failure because status can contain real machine and tailnet names."""
    try:
        r = subprocess.run([ts, *args], capture_output=True, text=True,
                           encoding="utf-8", env=tailscale_env(), timeout=TAILSCALE_STATUS_TIMEOUT)
    except subprocess.TimeoutExpired:
        sys.exit(f"tailscale: {label} did not answer; no changes made")
    except (OSError, UnicodeError):
        sys.exit(f"tailscale: could not read {label}; no changes made")
    if r.returncode != 0:
        sys.exit(f"tailscale: {label} failed; no changes made")
    try:
        answer = json.loads(r.stdout)
    except (TypeError, ValueError):
        sys.exit(f"tailscale: {label} returned malformed JSON; no changes made")
    if not isinstance(answer, dict):
        sys.exit(f"tailscale: {label} returned malformed JSON; no changes made")
    return answer


def tailscale_status(ts):
    return tailscale_json(ts, ["status", "--json"], "status")


def tailscale_serve_status(ts):
    return tailscale_json(ts, ["serve", "status", "--json"], "serve status")


def tailnet_name(status):
    """The stable DNS name used both by the Serve config and the QR."""
    own = status.get("Self")
    raw = own.get("DNSName") if isinstance(own, dict) else None
    if not isinstance(raw, str) or not raw.rstrip("."):
        sys.exit("tailscale: this Mac has no tailnet name yet; switch on MagicDNS in the Tailscale admin console")
    return raw.rstrip(".").lower()


def host_port(value):
    """A Serve config HostPort as a normalized (host, port) pair."""
    if not isinstance(value, str):
        raise ValueError("host-port is not text")
    parsed = urlparse("//" + value)
    if (parsed.hostname is None or parsed.username is not None or
            parsed.password is not None or parsed.path or parsed.query or
            parsed.fragment):
        raise ValueError("invalid host-port")
    port = parsed.port
    if port is None:
        raise ValueError("host-port has no port")
    return parsed.hostname.rstrip(".").lower(), port


def proxy_targets_board(proxy, port):
    """True only for the IPv4 loopback target facilitator itself creates."""
    if not isinstance(proxy, str):
        return False
    try:
        target = urlparse(proxy)
        return (target.scheme == "http" and target.hostname == "127.0.0.1" and
                target.port == port and target.path in ("", "/") and
                not target.params and not target.query and not target.fragment and
                target.username is None and target.password is None)
    except ValueError:
        return False


def bridge_config(config, name, port):
    """Interpret actual Serve state without a PID or a facilitator-owned flag.

    The one configuration this command owns is the background root handler on
    this node's HTTPS port 443, pointed at the board's IPv4 loopback port. Other
    paths and named Services are compatible and are left alone. A board proxy
    elsewhere, a foreground session, Funnel, or another root owner makes an
    enable unsafe; malformed data stops every mutation."""
    if not isinstance(config, dict):
        raise ValueError("config is not an object")
    foreground = config.get("Foreground", {})
    if not isinstance(foreground, dict):
        raise ValueError("foreground is not an object")
    candidates = [("background", config)]
    for candidate in foreground.values():
        if not isinstance(candidate, dict):
            raise ValueError("foreground config is not an object")
        if "Foreground" in candidate:
            raise ValueError("nested foreground config")
        candidates.append(("foreground", candidate))

    protected_port = port + 1
    exact = 0
    legacy = 0
    board_elsewhere = False
    foreign_root = False
    port_conflict = False
    foreground_443 = False
    funnel_443 = False
    root_entries = 0
    for source, candidate in candidates:
        tcp = candidate.get("TCP", {})
        web = candidate.get("Web", {})
        funnel = candidate.get("AllowFunnel", {})
        if not isinstance(tcp, dict) or not isinstance(web, dict) or not isinstance(funnel, dict):
            raise ValueError("Serve maps are malformed")
        for raw_port, handler in tcp.items():
            if not isinstance(raw_port, str) or not raw_port.isdigit() or not isinstance(handler, dict):
                raise ValueError("TCP entry is malformed")
        tcp_443 = tcp.get("443")
        # This is the exact listener shape made by a plain HTTPS Serve. Extra
        # fields may carry behavior another command owns, so they are a
        # conflict even when HTTPS is also true.
        https_443 = tcp_443 == {"HTTPS": True}
        if tcp_443 is not None:
            modes = sum((https_443, tcp_443.get("HTTP") is True,
                         bool(tcp_443.get("TCPForward"))))
            if modes > 1:
                raise ValueError("TCP mode is ambiguous")
            incompatible = not https_443
            if source == "foreground":
                foreground_443 = True
            elif incompatible:
                port_conflict = True

        for raw_host_port, server in web.items():
            host, public_port = host_port(raw_host_port)
            if not isinstance(server, dict):
                raise ValueError("Web entry is malformed")
            if not isinstance(tcp.get(str(public_port)), dict):
                raise ValueError("Web entry has no TCP listener")
            handlers = server.get("Handlers", {})
            if not isinstance(handlers, dict):
                raise ValueError("handler map is malformed")
            on_our_root = host == name and public_port == 443
            if source == "foreground" and on_our_root:
                foreground_443 = True
            for mount, handler in handlers.items():
                if not isinstance(mount, str) or not isinstance(handler, dict):
                    raise ValueError("handler is malformed")
                proxy = handler.get("Proxy")
                if proxy is not None and not isinstance(proxy, str):
                    raise ValueError("proxy is malformed")
                is_board = proxy_targets_board(proxy, protected_port)
                is_legacy = proxy_targets_board(proxy, port)
                # Accept only what our command writes. A matching Proxy plus
                # another field, such as AcceptAppCaps, belongs to somebody
                # else and must survive both `on` and `off`.
                is_ours = (is_board or is_legacy) and set(handler) == {"Proxy"}
                if source == "background" and on_our_root and mount == "/" and https_443 and is_ours:
                    if is_legacy:
                        legacy += 1
                    else:
                        exact += 1
                elif is_board or is_legacy:
                    board_elsewhere = True
                if source == "background" and on_our_root and mount == "/":
                    root_entries += 1
                    if not is_ours:
                        foreign_root = True

        for raw_host_port, allowed in funnel.items():
            host, public_port = host_port(raw_host_port)
            if not isinstance(allowed, bool):
                raise ValueError("Funnel entry is malformed")
            if allowed and host == name and public_port == 443:
                funnel_443 = True

    if exact + legacy > 1 or root_entries > 1:
        raise ValueError("duplicate root handlers")
    active = exact == 1 or legacy == 1 or board_elsewhere
    # Tailscale's narrow handler removal also clears same-endpoint Funnel when
    # the last web handler goes away, so that state is not safe to remove.
    removable = exact + legacy == 1 and not board_elsewhere and not funnel_443
    if legacy:
        why = "the old unguarded bridge is active; run `facilitator bridge off` before enabling the password-gated bridge"
    elif board_elsewhere:
        why = "this board is served by a configuration facilitator does not own"
    elif foreground_443:
        why = "a foreground Serve session is using HTTPS port 443"
    elif funnel_443:
        why = "Funnel is using HTTPS port 443"
    elif foreign_root:
        why = "another service owns the HTTPS root on port 443"
    elif port_conflict:
        why = "another service owns port 443"
    else:
        why = ""
    on = exact == 1 and removable and not why
    return {"active": active, "removable": removable, "on": on,
            "legacy": bool(legacy), "enable_blocked": bool(why), "why": why}


def analyze_bridge(ts, name, port):
    raw = tailscale_serve_status(ts)
    try:
        return raw, bridge_config(raw, name, port)
    except (TypeError, ValueError):
