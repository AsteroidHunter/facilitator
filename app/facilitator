MAGIC_KINDS = ("text", "markdown", "html", "image", "url")
MAGIC_ACTIONS = ("close", "reopen", "show")
MAGIC_HELP = """usage: facilitator magic CARD KIND (CONTENT | --file PATH | -) [--title TITLE]
       facilitator magic CARD close|reopen|show

Fill a card's magic box on the Mac board and open it, in place of what it
held. KIND is text, markdown, html, image or url. CONTENT is the words, or one
https address for url and image; --file sends a file's contents (a picture's
bytes for image) and - reads standard input. close hides the box and keeps
it, reopen shows it again, show prints what it holds. Prints the board's
answer as one JSON line; exits 1 with the board's words when it refuses."""


def cmd_magic(args):
    """One call to the board's /magic routes, for an agent showing the owner
    something beside a card. The content is read here, on the agent's side,
    so the board is handed bytes and never a path to open."""
    words = args[1:]
    if words in ([], ["-h"], ["--help"]):
        if words:
            print(MAGIC_HELP)
            return
        sys.exit(MAGIC_HELP)
    title, path, rest = None, None, []
    at = 0
    while at < len(words):
        word = words[at]
        if word in ("--title", "--file"):
            if at + 1 == len(words):
                sys.exit(f"magic: {word} needs a value")
            if word == "--title":
                title = words[at + 1]
            else:
                path = words[at + 1]
            at += 2
            continue
        rest.append(word)
        at += 1
    if len(rest) < 2:
        sys.exit(MAGIC_HELP)
    card, what, content = rest[0], rest[1], rest[2:]
    if what in MAGIC_ACTIONS:
        if content or path is not None or title is not None:
            sys.exit(f"magic: {what} takes only the card")
        method, route, body, query = ("GET" if what == "show" else "POST",
                                      "/magic" if what == "show" else "/magic/" + what,
                                      None if what == "show" else b"", {"box": card})
    elif what in MAGIC_KINDS:
        if len(content) + (path is not None) != 1:
            sys.exit("magic: give the content once: as one argument, as --file PATH, or as - to read standard input")
        if path is not None:
            try:
                body = Path(path).expanduser().read_bytes()
            except OSError as error:
                sys.exit(f"magic: {path} cannot be read: {error.strerror or error}")
        elif content[0] == "-":
            body = sys.stdin.buffer.read()
        else:
            body = content[0].encode("utf-8")
        method, route, query = "POST", "/magic", {"box": card, "kind": what}
        if title is not None:
            query["title"] = title
    else:
        sys.exit(f"magic: {what} is not one of {', '.join(MAGIC_KINDS)}, {', '.join(MAGIC_ACTIONS)}")
    port = board_port()
    request = urllib.request.Request(f"http://127.0.0.1:{port}{route}?{urlencode(query)}",
                                     data=body, method=method)
    try:
        # a website or a web picture is fetched by the board before it answers,
        # within its own 15 seconds, so this waits a little longer than that
        with urllib.request.urlopen(request, timeout=60) as response:
            answer = json.load(response)
    except urllib.error.HTTPError as refused:
        try:
            said = json.load(refused).get("error")
        except (ValueError, AttributeError, OSError):
            said = None
        sys.exit(f"magic: {said or f'the board answered {refused.code}'}")
    except (OSError, ValueError):
        sys.exit(f"server: DOWN (port {port})")
    print(json.dumps(answer, ensure_ascii=False))


REMOTE_HELP = """usage: facilitator remote pair [--name NAME]
       facilitator remote list
       facilitator remote remove NAME

Connect one of your own servers to this board, so an agent running there can
work a project's cards. Nothing logs in to the server: the server connects out
to the board over Tailscale. pair prints one line to run on the server, logged
in there yourself, and the pairing code it asks for. list shows each server and
whether it is connected; remove forgets a server on this Mac."""


def board_call(method, route, timeout=5):
    """One local call to the board's own port: (status, answer), or (None,
    None) when nothing answers there."""
    request = urllib.request.Request(f"http://127.0.0.1:{board_port()}{route}",
                                     data=b"" if method == "POST" else None, method=method)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return response.status, json.load(response)
    except urllib.error.HTTPError as refused:
        try:
            return refused.code, json.load(refused)
        except (ValueError, OSError):
            return refused.code, None
    except (OSError, ValueError, http.client.HTTPException):
        return None, None


def remote_pair(words):
    name = None
    if words:
        if len(words) != 2 or words[0] != "--name" or not words[1].strip():
            sys.exit(REMOTE_HELP)
        name = words[1].strip()
    status, said = board_call("POST", "/remote/pair/new" + ("?" + urlencode({"name": name}) if name else ""))
    if status is None:
        sys.exit(problem("The board is not running.",
                         "Start it with facilitator run, then pair again: the server connects to the running board.",
                         blank=False))
    if status == 404:
        sys.exit(problem("The running board predates pairing.",
                         "Restart it with facilitator restart, then pair again.", blank=False))
    if status != 200 or not isinstance(said, dict) or not isinstance(said.get("code"), str):
        sys.exit(problem(f"The board gave no pairing code: {(said or {}).get('error', status)}.", blank=False))
    addresses = [a for a in said.get("addresses") or [] if isinstance(a, str)]
    if not addresses:
        sys.exit(problem("The board is not listening on the tailnet yet.",
                         "Turn Tailscale on on this Mac and give the board half a minute to see it, then pair again.",
                         "If macOS asked whether Python may accept incoming connections, allow it.", blank=False))
    v4 = [a for a in addresses if ":" not in a]
    url = f"http://{v4[0] if v4 else '[' + addresses[0] + ']'}:{said['port']}"
    print("On the server, logged in there yourself, run this line and paste the code when it asks:")
    print()
    print(f"  curl -fsS --noproxy '*' {url}/remote/setup | python3 - {url}")
    print()
    print(f"Pairing code: {said['code']}   (works once, for {said.get('minutes', 10)} minutes)")
    print()
    print("It puts the facilitator skill in ~/.facilitator on the server and starts the server's")
    print("link, which connects out to this board over Tailscale. Nothing logs in to the server.")


def heard_words(heard):
    if not isinstance(heard, (int, float)):
        return "not heard from since the board started"
    ago = max(0, round(time.time() - heard))
    if ago < 120:
        return f"last heard {ago} seconds ago"
    if ago < 7200:
        return f"last heard {ago // 60} minutes ago"
    return f"last heard {ago // 3600} hours ago"


def remote_list():
    import remote_link
    status, said = board_call("GET", "/remote/servers")
    running = status == 200 and isinstance(said, dict)
    if running:
        servers, door = said.get("servers", []), said.get("door")
    else:
        # the board is down, or older than pairing and in need of a restart
        servers, door = [{"name": s["name"]} for s in remote_link.Store(DATA).servers()], None
    if not servers:
        print("No servers. Pair one with: facilitator remote pair")
    for s in servers:
        if not running:
            state = "not connected (" + ("board not running" if status is None else "restart the board") + ")"
        elif s.get("up"):
            state = "connected"
        else:
            state = "not connected, " + heard_words(s.get("heard"))
        print(f"{s['name']}  {state}")
    if running and isinstance(door, dict) and not door.get("open"):
        print("⚠ The board is not listening on the tailnet, so no server can reach it: is Tailscale on?")


def remote_remove(named):
    import remote_link
    store = remote_link.Store(DATA)
    servers = store.servers()
    folded = named.casefold()
    hit = next((s for s in servers if s["id"] == named or s["name"].casefold() == folded), None)
    if hit is None:
        sys.exit(problem(f"No server named {named}.", "facilitator remote list shows the servers.", blank=False))
    status, said = board_call("POST", "/remote/forget?" + urlencode({"server": hit["id"]}))
    if status is None:
        # the board is down, so the file is the only record, and the board
        # drops that server's keys when it starts
        store.save_servers([s for s in servers if s is not hit])
        ok(f"Forgot {hit['name']} on this Mac; its projects' keys no longer work.")
        skipped("The board is not running; it starts without that server.")
    elif status == 200:
        ok(f"Forgot {hit['name']} on this Mac; its link and its projects' keys no longer work.")
    else:
        sys.exit(problem(f"The board did not forget {hit['name']}: {(said or {}).get('error', status)}.", blank=False))
    print(f"On {hit['name']} itself the link stops at its next try. ~/{REMOTE_TOP} and the skill's links")
    print("in ~/.agents/skills and ~/.claude/skills there can be deleted by hand.")


