def check_python():
    """Stop when the Python running this setup is below the floor this command
    needs, and say nothing otherwise. The board does not run on it: it runs on
    the Python APP_PYTHON in .venv, which uv provides whatever Python runs
    this, so which one runs the setup is not something to print."""
    have = sys.version_info[:3]
    if have < MIN_PYTHON:
        shown = ".".join(str(part) for part in have)
        floor = ".".join(str(part) for part in MIN_PYTHON)
        sys.exit(problem(f"Python {shown} is below the {floor} minimum.",
                         "Install a newer Python, then run ./install.sh again."))


def find_uv():
    """The uv command: PATH first, then the two places uv's own installer puts
    it, so a uv installed here on a past run is found even when it never went
    onto PATH."""
    found = shutil.which("uv")
    if found:
        return found
    for candidate in UV_HOME_BINS:
        path = os.path.expanduser(candidate)
        if os.access(path, os.X_OK):
            return path
    return None


def uv_installer_env(folder):
    """The environment for uv's installer, or None when nothing here can check
    a download. The installer compares each file it fetches with the
    fingerprint it carries only when a sha256sum command exists, and macOS has
    shasum instead, so a sha256sum that calls shasum is put in folder and
    first on PATH."""
    env = {**os.environ, "INSTALLER_NO_MODIFY_PATH": "1"}
    if shutil.which("sha256sum"):
        return env
    shasum = shutil.which("shasum")
    if not shasum:
        return None
    shim = Path(folder) / "sha256sum"
    shim.write_text(f"#!/bin/sh\nexec {shlex.quote(shasum)} -a 256 \"$@\"\n")
    shim.chmod(0o755)
    env["PATH"] = folder + os.pathsep + env.get("PATH", "")
    return env


def install_uv():
    """Install uv and return its path, or stop. Homebrew when it is there,
    otherwise uv's own installer, locked to UV_PIN and run only when it has
    the expected fingerprint, into the home folder and told not to touch any
    shell profile. uv is required; there is no fallback to a plain venv."""
    brew = shutil.which("brew")
    if brew:
        print("uv is not installed. Installing it with Homebrew.")
        if subprocess.run([brew, "install", "uv"]).returncode != 0:
            sys.exit(problem("Homebrew could not install uv.",
                             "Install uv yourself, then run ./install.sh again."))
    else:
        if not shutil.which("curl"):
            sys.exit(problem("curl is needed to fetch the uv installer.",
                             "Install uv yourself, then run ./install.sh again."))
        print("uv is not installed. Installing it with the astral.sh installer")
        print("into your home.")
        with tempfile.TemporaryDirectory() as folder:
            env = uv_installer_env(folder)
            if env is None:
                sys.exit(problem("Cannot check what the uv installer downloads: neither sha256sum nor shasum is here.",
                                 "Nothing was run. Install uv yourself, then run ./install.sh again."))
            script = subprocess.run(["curl", "--proto", "=https", "--tlsv1.2", "-LsSf", UV_INSTALL_URL],
                                    capture_output=True)
            if script.returncode != 0 or not script.stdout:
                sys.exit(problem("Could not download the uv installer.",
                                 "Install uv yourself, then run ./install.sh again."))
            if hashlib.sha256(script.stdout).hexdigest() != UV_INSTALL_SHA256:
                sys.exit(problem("The uv installer from astral.sh is not the one this checkout expects.",
                                 "Nothing was run. Install uv yourself, then run ./install.sh again."))
            # its own progress lines are held back and shown only if it fails
            held = subprocess.run(["sh"], input=script.stdout, env=env, capture_output=True)
            if held.returncode != 0:
                show_held(held)
                sys.exit(problem("The uv installer did not finish.",
                                 "Install uv yourself, then run ./install.sh again.", blank=True))
    uv = find_uv()
    if not uv:
        sys.exit(problem("uv is installed but still not found.",
                         "Open a new shell so it is on PATH, then run ./install.sh again."))
    return uv


def uv_version(uv):
    """What that uv says its version is, as numbers like (0, 9, 0), or None
    when nothing it says reads as one."""
    try:
        said = subprocess.run([uv, "--version"], capture_output=True, text=True, errors="replace")
    except OSError:
        return None
    found = re.match(r"uv (\d+)\.(\d+)\.(\d+)", (said.stdout or "").strip())
    return tuple(int(part) for part in found.groups()) if found else None


def ensure_uv(quiet=False):
    """The uv command, found or installed, and new enough to install Python
    APP_PYTHON. An older one stops the run in one line: it is the tester's own
    tool, so it is theirs to upgrade, and nothing has been changed yet."""
    uv = find_uv()
    installed = not uv
    if installed:
        uv = install_uv()
    have = uv_version(uv)
    if have is None or have < UV_MIN:
        need = ".".join(str(part) for part in UV_MIN)
        which = f"uv {'.'.join(str(part) for part in have)}" if have else f"The uv at {uv}, whose version could not be read,"
        sys.exit(problem(f"{which} is too old to install Python {APP_PYTHON}: upgrade it to {need} or newer "
                         "(brew upgrade uv, or uv self update), then run ./install.sh again."))
    if not quiet:
        ok("uv installed." if installed else "uv found.")
    return uv


def show_held(result):
    """Print the output of a run that was held back, as text or as bytes."""
    for stream, text in ((sys.stdout, result.stdout), (sys.stderr, result.stderr)):
        stream.write(text.decode("utf-8", "replace") if isinstance(text, bytes) else text)
        stream.flush()


def run_held(argv, cwd=HERE):
    """Run a command, here by default, holding its output back and showing it
    only on failure, so an install says what it is doing in its own words and
    not in uv's or npm's."""
    result = subprocess.run(argv, cwd=str(cwd), capture_output=True, text=True, errors="replace")
    if result.returncode != 0:
        show_held(result)
    return result.returncode


def env_python():
    """The Python .venv is built on, as "3.14", read from .venv/pyvenv.cfg
    without running anything. None when .venv/bin/python3 cannot be run (no
    file, or a link whose Python was removed) or the file names no version."""
    if not os.access(VENV_PYTHON, os.X_OK):
        return None
    try:
        lines = (HERE / ".venv" / "pyvenv.cfg").read_text().splitlines()
    except (OSError, UnicodeDecodeError):
        return None
    for line in lines:
        key, _, value = line.partition("=")
        if key.strip() in ("version_info", "version"):
            parts = value.strip().split(".")
            if len(parts) >= 2 and parts[0].isdigit() and parts[1].isdigit():
                return f"{int(parts[0])}.{int(parts[1])}"
    return None


# set once ensure_env has stopped this folder's board to rebuild .venv, so a
# step that fails after that can say the board is down
env_stopped_board = False


def board_on_env():
    """The port this folder's board answers on, or None. Asked only where
    server.lock and run.config.json point, and counted only when the board
    there names this folder: another checkout's board on the same port runs on
    its own .venv, and with neither file there is nowhere to ask."""
    ports = [lock_port()]
    if CONFIG.exists():
        ports.append(board_port())
    for port in dict.fromkeys(port for port in ports if port):
        if this_board(board_state(port)):
            return port
    return None


def stop_for_rebuild():
    """Stop this folder's board before its .venv is rebuilt; True when one was
    stopped. It has to go first: once .venv points at the new Python, restart
    can no longer recognise a server still running on the old one, and the
    rebuild would clear the packages from under it. A board that cannot be
    stopped safely stops the run instead, with .venv unchanged."""
    global env_stopped_board
    port = board_on_env()
    if port is None:
        return False
    owner, refusal = server_process(port)
    if refusal is None and owner is not None:
        refusal = stop_server(owner, port)
    if refusal:
        sys.exit(problem(f"The board could not be stopped to rebuild .venv: {refusal}.",
                         "Nothing in .venv was changed. Stop the board, then run ./install.sh again."))
    if owner is None:
        return False
    env_stopped_board = True
    print(f"Stopped the board on port {port}, which was running on the old .venv.")
    return True


def build_env(uv, have, quiet):
    """Build .venv on a Python APP_PYTHON that uv manages itself, replacing
    whatever stands there. uv installs that Python first, the only step that
    downloads, so a failure there leaves .venv and the board as they were. A
    rebuild of a .venv that was there says so even when quiet, since it is
    news. True when the board was stopped for it."""
    venv = HERE / ".venv"
    if venv.is_symlink():
        sys.exit(problem(f".venv is a link, and it is not on Python {APP_PYTHON}.",
                         "Facilitator will not clear what it points to. Remove the link,",
                         "then run ./install.sh again."))
    there = venv.exists()
    if there:
        why = f"it was on Python {have}" if have else "its Python is missing or broken"
        print(f"Rebuilding .venv on Python {APP_PYTHON}: {why}.")
    elif not quiet:
        print(f"Setting up the Python {APP_PYTHON} environment.")
    if run_held([uv, "python", "install", "--no-bin", APP_PYTHON]) != 0:
        sys.exit(problem(f"uv could not install Python {APP_PYTHON}.",
                         *(["Nothing in .venv was changed."] if there else []),
                         "See the output above, then run ./install.sh again."))
    stopped = stop_for_rebuild() if there else False
    if run_held([uv, "venv", "--clear", "--managed-python", "--python", APP_PYTHON, ".venv"]) != 0:
        sys.exit(problem("uv could not create .venv.",
                         "See the output above, then run ./install.sh again."))
    got = env_python()
    if got != APP_PYTHON:
        made = f"on Python {got}" if got else "but its Python could not be read"
        sys.exit(problem(f"uv made .venv {made}, not on Python {APP_PYTHON}.",
                         "See the output above, then run ./install.sh again."))
    if not quiet:
        ok(f"Python {APP_PYTHON} environment ready.")
    return stopped


def ensure_env(uv, quiet=False):
    """Make .venv stand on Python APP_PYTHON with the pinned packages in it,
    each file checked against the fingerprint requirements.txt gives it, so
    nothing unlisted or changed goes in. A .venv already on it is kept; one that is missing, broken or on any other
    Python is built again, so every checkout runs the Python the board is tested
    on. The sync runs either way because it is idempotent and is how a changed
    requirements file is picked up. quiet prints nothing unless a step fails or
    .venv has to be rebuilt. True when the board was stopped for a rebuild, so
    the caller can start it again."""
    have = env_python()
    stopped = False
    if have == APP_PYTHON:
        if not quiet:
            ok(f"Environment found in .venv (Python {APP_PYTHON}).")
    else:
        stopped = build_env(uv, have, quiet)
    if not quiet:
        print("Installing the packages Facilitator needs.")
    if run_held([uv, "pip", "sync", "--require-hashes", "--python", ".venv/bin/python", "requirements.txt"]) != 0:
        sys.exit(problem("uv could not sync requirements.txt.",
                         "See the output above, then run ./install.sh again."))
    if not quiet:
        ok("Packages installed.")
    return stopped


def ensure_config():
    """Write each config file from its example only when it is not already
    there, so a second run and a user's own edits are both left untouched.
    A new run.config.json names the default pair, 8877 and 8878, when nothing
    holds it, and otherwise the next free pair above it; run says which port
    the board is on. Nothing is asked of any port beyond whether it can be
    bound, and Tailscale is not asked at all: install runs before the phone
    client is set up, and run checks the Serve rules when it starts the board."""
    for name, example, made in (("run.config.json", "run.config.example.json", "Board settings"),
                                ("seed.json", "seed.example.json", "Starting board")):
        target = HERE / name
        if target.exists():
            ok(f"{name} found.")
            continue
        shutil.copyfile(HERE / example, target)
        ok(f"{made} created.")
        if name != "run.config.json":
            continue
        port = pick_pair(DEFAULT_PORT, serve=False)
        if port is not None and port != json.loads(target.read_text()).get("port"):
            target.write_text(config_with(target.read_text(), port, None))


def find_node_tools():
    """The npm to use for the test packages, or None when node or npm is missing."""
    npm = shutil.which("npm")
    return npm if shutil.which("node") and npm else None


def ensure_test_packages(npm):
    """Install the packages only the tests need, exactly as tests/package-lock.json
    names them: npm ci, which takes nothing the lockfile does not fix, and
    without any package's install scripts. They are left alone when the version
    tests/package.json pins is already there."""
    pinned = json.loads((TESTS_DIR / "package.json").read_text())["dependencies"]["puppeteer-core"]
    try:
        have = json.loads((TESTS_DIR / "node_modules" / "puppeteer-core" / "package.json").read_text())["version"]
    except (OSError, ValueError, KeyError):
        have = None
    if have == pinned:
        ok("Test packages found.")
        return
    print("Installing the packages the tests need.")
    if run_held([npm, "ci", "--ignore-scripts", "--no-audit", "--no-fund"], TESTS_DIR) != 0:
        sys.exit(problem("npm could not install the test packages.",
                         "See the output above, then run ./install.sh --dev again."))
    ok("Packages for the tests installed.")


def cmd_install(args):
    """Set up a fresh checkout in place, beside this command, in the order the
    steps depend on each other. Every step is idempotent."""
    words = args[1:]
    if any(w in ("-h", "--help") for w in words):
        print(INSTALL_HELP)
        return
    extra = [w for w in words if w != "--dev"]
    if extra:
        sys.exit("install takes only --dev; got " + " ".join(extra) + "\n" + INSTALL_HELP)
    dev = "--dev" in words
    # keep these lines in order with uv's and npm's when the output is a pipe
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(line_buffering=True)
    # install.sh prints this step's intro and its blank line before it gets here
    global _after_intro
    _after_intro = True
    npm = find_node_tools() if dev else None
    if dev and not npm:
        sys.exit(problem("--dev needs node and npm, and they were not found.",
                         "Install Node.js, then run ./install.sh --dev again."))
    previous = read_install_record()
    before = {name: (HERE / name).exists() for name in INSTALL_ARTIFACTS}
    try:
        uv = ensure_uv()
        check_python()
        ensure_env(uv)
        ensure_config()
        if dev:
            ensure_test_packages(npm)
    except SystemExit as stop:
        if env_stopped_board and isinstance(stop.code, str):
            stop.code += ("\n  The board was stopped to rebuild .venv and is down. Once this is"
                          " fixed, start it with: facilitator run")
        raise
    finally:
        # A failed dependency step can still have created files. Record them so
        # a later uninstall can remove only that partial install's own files.
        owned = previous.copy()
        for name in INSTALL_ARTIFACTS:
            path = HERE / name
            if not before[name] and path.exists():
                owned[name] = file_digest(path) if path.is_file() else "directory"
        INSTALL_RECORD.write_text(json.dumps(owned, indent=2) + "\n")


def board_running(port):
    """True when this board answers on the port right now. The board shape is
    checked, not a bare ping, so another service on the port is not mistaken for
    the board."""
    return board_state(port) is not None


def bridge_note(port):
    """The one line to print when a phone bridge is active, or None. Read only
    and best effort: anything unreadable is treated as no bridge, because the
    note must never fail an uninstall and uninstall must never touch the
    bridge."""
    try:
        ts = find_tailscale()
        if not ts:
            return None
        name = tailnet_name(tailscale_status(ts))
        _, analysis = analyze_bridge(ts, name, port)
        if analysis["active"]:
            return "A phone bridge is active. Turn it off with: facilitator bridge off"
    except SystemExit:
        return None
    except (OSError, ValueError, KeyError, TypeError):
        return None
    return None


def remove_path(path):
    """Remove one file, directory or symlink when it is there; True when
    something went. A directory symlink is unlinked, never followed into its
    target, so a linked .venv is severed and its target left whole."""
    try:
        if path.is_symlink() or path.is_file():
            path.unlink()
            return True
        if path.is_dir():
            shutil.rmtree(path)
            return True
    except OSError as error:
        sys.exit(problem(f"Could not remove {path.name}: {error.strerror or 'error'}.",
                         "Fix that, then run uninstall again."))
    return False


def file_digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def read_install_record():
    if INSTALL_RECORD.is_symlink():
        sys.exit(problem(f"{INSTALL_RECORD.name} is a symlink.",
                         "Facilitator will not modify it."))
    if not INSTALL_RECORD.exists():
        return {}
    try:
        record = json.loads(INSTALL_RECORD.read_text())
        if not isinstance(record, dict) or any(k not in INSTALL_ARTIFACTS for k in record):
            raise ValueError("invalid install record")
        return record
    except (OSError, ValueError):
        sys.exit(problem(f"{INSTALL_RECORD.name} is invalid.",
                         "Facilitator will not guess which files belong to it."))


def banner(role):
    """The installer's block-letter title with the role under it, coloured only
    on a terminal."""
    tty = sys.stdout.isatty()
    rows = [" ".join(BANNER_GLYPHS[c][n] for c in "FACILITATOR") for n in range(5)]
    for row in rows:
        out = ""
        for i, ch in enumerate(row):
            t = i / max(len(row) - 1, 1)
            r, g, b = int(190 + 55 * t), int(55 + 91 * t), int(30 + 45 * t)
            out += f"\033[38;2;{r};{g};{b}m{ch}" if ch != " " and tty else ch
        print(out + ("\033[0m" if tty else ""))
    print(" " * (len(rows[0]) - len(role)) + role)


def attachment_dirs():
    """The attachment folders that are there, each once."""
    found, seen = [], set()
    for path in ATTACHMENT_DIRS:
        if (path.exists() or path.is_symlink()) and os.path.realpath(path) not in seen:
            seen.add(os.path.realpath(path))
            found.append(path)
    return found


def keep_attachments(answer):
    """True unless the owner clearly says no. A flag answers without a prompt;
    Enter, anything unclear or no terminal to ask on keeps them."""
    if answer is not None:
        return answer
    print()
    if not sys.stdin.isatty():
        skipped("Keeping your card attachments: there is no terminal to ask on.")
        print("Pass --remove-attachments to remove them.")
        return True
    try:
        said = input(ATTACHMENT_QUESTION)
    except EOFError:
        print("")
        return True
    except KeyboardInterrupt:
        print("")
        sys.exit(problem("Stopped at the attachments question.", "Nothing was removed.", blank=True))
    return said.strip().lower() not in ("n", "no")


def other_copies():
    """Names of the other copies of the board in this folder's parent. Each
    reads the same attachments folder beside it, so what is saved there is
    theirs as much as this copy's."""
    names = []
    try:
        for child in sorted(HERE.parent.iterdir()):
            if (child.is_symlink() or not child.is_dir()
                    or os.path.realpath(child) == os.path.realpath(HERE)):
                continue
            if (child / "server.py").is_file() and (child / "facilitator").is_file():
                names.append(child.name)
    except OSError:
        pass
    return names


def keep_shared_attachments(path, copies):
    """True unless the owner clearly says yes. The folder at path is read by
    other copies of the board, so removing it takes their attachments too:
    a flag does not answer for them, and no terminal keeps it."""
    who = (f"Another copy of the board uses {path}: " if len(copies) == 1
           else f"Other copies of the board use {path}: ") + ", ".join(copies) + "."
    print()
    print(who)
    if not sys.stdin.isatty():
        skipped(f"Keeping {path} for the other copies: there is no terminal to ask on.")
        print("Remove it by hand when no other copy needs it.")
        return True
    try:
        said = input(SHARED_QUESTION)
    except EOFError:
        print("")
        said = ""
    except KeyboardInterrupt:
        print("")
        sys.exit(problem("Stopped at the attachments question.", "Nothing was removed.", blank=True))
    if said.strip().lower() in ("y", "yes"):
        return False
    skipped(f"Keeping {path} for the other copies.")
    return True


def remove_attachments(path):
    """Remove one attachment folder and nothing above it. A link is left alone
    rather than followed, and rmtree unlinks any link inside without following
    it, so nothing outside the folder goes."""
    if path.is_symlink():
        skipped(f"Kept card attachments link {path}.")
        print("A link is not followed. Remove it by hand.")
    elif not path.is_dir():
        skipped(f"Kept {path}: it is not a folder.")
    else:
        try:
            shutil.rmtree(path)
        except OSError as error:
            sys.exit(problem(f"Could not remove {path}: {error.strerror or 'error'}.",
                             "Fix that, then run uninstall again."))
        ok(f"Removed card attachments folder {path}.")


def cmd_uninstall(args):
    """Take away exactly what install made, always keeping the board's data.
    Right after the banner, asks whether to keep the card attachments.
    Refuses while the server is up, and never removes this folder."""
    words = args[1:]
    if any(w in ("-h", "--help") for w in words):
        print(UNINSTALL_HELP)
        return
    extra = [w for w in words if w not in ("--keep-attachments", "--remove-attachments")]
    if extra:
        sys.exit(problem("Unknown option: " + " ".join(extra) + ".",
                         "uninstall takes --keep-attachments or --remove-attachments.")
                 + "\n\n" + UNINSTALL_HELP)
    if "--keep-attachments" in words and "--remove-attachments" in words:
        sys.exit(problem("Both --keep-attachments and --remove-attachments were given.",
                         "Give one of them, not both."))
    answer = (True if "--keep-attachments" in words
              else False if "--remove-attachments" in words else None)

    banner("uninstaller")
    port = board_port()
    if board_running(port):
        sys.exit(problem(f"The board is up on port {port}.",
                         "Stop that server first, then run uninstall again."))

    owned = read_install_record()
    attachments = attachment_dirs()
    section("Card attachments")
    print("Uninstall asks about your card attachments first, apart from the")
    print("rest of the board's data. Only a clear no removes them.")
    print()
    copies, keep_shared = [], True
    if attachments:
        print("Your card attachments are in:")
        for path in attachments:
            print(f"  {path}")
        keep = keep_attachments(answer)
        if SHARED_ATTACHMENTS in attachments:
            copies = other_copies()
        if not keep and copies:
            keep_shared = keep_shared_attachments(SHARED_ATTACHMENTS, copies)
    else:
        print("No card attachments found.")
        keep = True

    print()
    import shell_integration
    removed_before = shell_integration.done
    shell_integration.QUIET = True
    try:
        shell_integration.uninstall()
    finally:
        shell_integration.QUIET = False
    if shell_integration.done > removed_before:
        ok("facilitator command and agent skill removed")

    made = [(".venv", HERE / ".venv"),
            ("tests/node_modules", TESTS_DIR / "node_modules"),
            ("node_modules", HERE / "node_modules"),
            ("package.json", HERE / "package.json"),
            ("package-lock.json", HERE / "package-lock.json"),
            ("run.config.json", HERE / "run.config.json"),
            ("seed.json", HERE / "seed.json")]

    for label, path in made:
        marker = owned.get(label)
        if marker is None:
            if path.exists():
                skipped(f"Kept {label}: it is not recorded as installer-owned.")
        elif marker != "directory" and (not path.is_file() or file_digest(path) != marker):
            skipped(f"Kept {label}: it has changed since install.")
        elif remove_path(path):
            ok(f"Removed {label}.")
    if INSTALL_RECORD.exists():
        INSTALL_RECORD.unlink()

    if not keep:
        for path in attachments:
            if copies and path == SHARED_ATTACHMENTS and keep_shared:
                continue
            remove_attachments(path)

    note = bridge_note(port)
    if note:
        print()
        print(note)

    print()
    print(f"{style('38;2;0;114;0', '✦')} Uninstall finished.")
    print()
    print("This folder was left in place.")


# --- update: pull forward only, then the pulled code runs its own update steps ---
UPDATES_DIR = HERE / "updates"
UPDATE_RECORD = HERE / ".facilitator-updates.json"
UPDATE_RECORD_TMP = HERE / ".facilitator-updates.tmp"
UPDATE_STEP_NAME = re.compile(r"^\d{4}-[A-Za-z0-9._-]+\.(?:py|sh)$")
UPDATE_HELP = """usage: facilitator update

Bring this checkout up to date. Stops, changing nothing, when the checkout has
uncommitted changes, is not on a branch, or has no upstream. Pulls that
upstream forward only (git pull --ff-only), then runs the pulled code's update
steps: sync the .venv to requirements.txt, then run each numbered step in
updates/ that has not run here yet. A .venv that is missing, broken or not on
Python 3.14 is built again on it first; that needs uv 0.9.0 or newer, and an
older uv stops the update with one line. A board running on the old .venv is
stopped before the rebuild and started again after. Otherwise restarts the
board only when it is running and something was pulled."""


def run_git(*args, env=None):
    """One git command in this checkout with its output captured."""
    return subprocess.run(["git", "-C", str(HERE), *args], capture_output=True,
                          text=True, errors="replace", env=env)


def board_version():
    """The version label shown on the board, read from index.html."""
    try:
        text = (HERE / "index.html").read_text(encoding="utf-8", errors="replace")
    except OSError:
        return "unknown"
    found = re.search(r'id="npversion">([^<]*)<', text)
    return found.group(1).strip() if found else "unknown"


def check_checkout():
    """Stop unless this is a clean git checkout on a branch with an upstream; return (remote, upstream branch)."""
    top = run_git("rev-parse", "--show-toplevel")
    if top.returncode != 0 or os.path.realpath(top.stdout.strip()) != os.path.realpath(HERE):
        sys.exit(problem("This folder is not a git checkout, so it cannot be updated.",
                         "Clone Facilitator again with git, then run ./install.sh there."))
    status = run_git("--no-optional-locks", "status", "--porcelain", "--untracked-files=no")
    if status.returncode != 0:
        sys.exit(problem("git could not read this checkout.", *status.stderr.strip().splitlines()[-3:],
                         "Nothing was changed."))
    changed = status.stdout.splitlines()
    if changed:
        shown = [line.strip() for line in changed[:8]]
        if len(changed) > 8:
            shown.append(f"and {len(changed) - 8} more")
        sys.exit(problem("This checkout has uncommitted changes.", *shown,
                         "Commit or discard them, then run facilitator update again.",
                         "Nothing was changed."))
    ok("No uncommitted changes.")
    branch = run_git("symbolic-ref", "--short", "-q", "HEAD").stdout.strip()
    if not branch:
        sys.exit(problem("This checkout is not on a branch, so there is nothing to follow.",
                         "Switch back to a branch, then run facilitator update again.",
                         "Nothing was changed."))
    remote = run_git("config", "--get", f"branch.{branch}.remote").stdout.strip()
    merge = run_git("config", "--get", f"branch.{branch}.merge").stdout.strip()
    if not remote or not merge:
        where = "origin" if "origin" in run_git("remote").stdout.split() else "<remote>"
        sys.exit(problem(f"Branch {branch} has no upstream, so there is nothing to pull from.",
                         f"Set one with: git branch --set-upstream-to={where}/{branch}",
                         "Then run facilitator update again. Nothing was changed."))
    upstream = merge.removeprefix("refs/heads/")
    ok(f"Branch {branch} follows {remote}/{upstream}.")
    return remote, upstream


def pull_forward(remote, upstream):
    """Fast-forward only pull of that one branch, no tags; return the commit before and after."""
    before = run_git("rev-parse", "HEAD").stdout.strip()
    result = run_git("pull", "--ff-only", "--no-rebase", "--no-tags", remote, upstream,
                     env={**os.environ, "LC_ALL": "C"})
    after = run_git("rev-parse", "HEAD").stdout.strip()
    if result.returncode != 0:
        output = (result.stdout + result.stderr).strip().splitlines()
        if "fast-forward" in " ".join(output).lower():
            sys.exit(problem("This checkout cannot be moved forward on its own.",
                             "It has changes of its own that the upstream does not have,",
                             "or the upstream's history was rewritten.",
                             "Nothing was changed. Ask whoever looks after this copy before",
                             "going further."))
        sys.exit(problem(f"git could not pull {remote}/{upstream}.", *output[-4:],
                         "Nothing was changed." if after == before else
                         "Check the lines above before going further.",
                         "Fix that, then run facilitator update again."))
    return before, after


def cmd_update(args):
    """Check, pull, then hand over to the pulled code's _update-steps in a new process."""
    words = args[1:]
    if any(w in ("-h", "--help") for w in words):
        print(UPDATE_HELP)
        return
    if words:
        sys.exit(problem("update takes no options; got " + " ".join(words) + ".")
                 + "\n\n" + UPDATE_HELP)
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(line_buffering=True)
    banner("updater")
    if not shutil.which("git"):
        sys.exit(problem("git was not found.", "Install git, then run facilitator update again."))

    section("1. Checkout")
    print("Update first checks that this folder is a git checkout with no\n"
          "uncommitted changes and a branch to follow. It changes nothing.\n")
    old_version = board_version()
    remote, upstream = check_checkout()

    before, after = pull_forward(remote, upstream)

    command = [sys.executable, str(HERE / "facilitator"), "_update-steps",
               "--from-version", old_version]
    if before != after:
        command.append("--pulled")
    sys.stdout.flush()
    sys.exit(subprocess.run(command, cwd=str(HERE),
                            env={**os.environ, "FACILITATOR_INTERNAL_UPDATE": "1"}).returncode)


def read_update_record():
    """Step name to time for every step that has run here; an unreadable file stops the update."""
    if not UPDATE_RECORD.exists():
        return {}
    try:
        ran = json.loads(UPDATE_RECORD.read_text())["ran"]
        if not isinstance(ran, dict):
            raise ValueError("ran is not an object")
        return ran
    except (OSError, ValueError, KeyError, TypeError):
        sys.exit(problem(f"{UPDATE_RECORD.name} is invalid.",
                         "Facilitator will not guess which update steps already ran.",
                         "Delete it to run every step again, then run facilitator update."))


def record_update_step(ran, name):
    ran[name] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    UPDATE_RECORD_TMP.write_text(json.dumps({"ran": ran}, indent=2) + "\n")
    os.replace(UPDATE_RECORD_TMP, UPDATE_RECORD)


def run_update_step(path):
    """Run one step with no input and return its exit status; .py under the .venv python, .sh under bash."""
    argv = [server_python(), str(path)] if path.suffix == ".py" else ["bash", str(path)]
    try:
        return subprocess.run(argv, cwd=str(HERE), stdin=subprocess.DEVNULL).returncode
    except OSError as error:
        print(f"Could not start it: {error.strerror or 'error'}.")
        return 1


def run_update_steps():
    """Run the unrecorded numbered steps in name order; the first failure stops and is not recorded."""
    ran = read_update_record()
    names = sorted(path.name for path in UPDATES_DIR.iterdir()
                   if UPDATE_STEP_NAME.match(path.name)) if UPDATES_DIR.is_dir() else []
    pending = [name for name in names if name not in ran]
    if not pending:
        ok("No new update steps.")
        return
    for name in pending:
        print(f"Running {name}.")
        if run_update_step(UPDATES_DIR / name) != 0:
            sys.exit(problem(f"Update step {name} failed.",
                             "Its output is above. It was not marked as done and runs again next time.",
                             "Fix the cause, then run facilitator update again."))
        record_update_step(ran, name)
        ok(f"{name} done.")


def restart_board(pulled, stopped=False):
    """Safe restart, only when something was pulled and the board is running,
    or a start when the .venv rebuild stopped it; False if it was refused."""
    if stopped:
        print("The board was stopped to rebuild .venv. Starting it again.\n")
    elif not pulled:
        skipped("Nothing was pulled, so the board was left as it is.")
        return True
    else:
        port = board_port()
        if not board_running(port):
            skipped(f"The board is not running on port {port}, so it was not started.")
            print("Start it with: facilitator run")
            return True
        print("The board is running. Restarting it onto the new code.\n")
    try:
        cmd_restart(["restart"])
    except SystemExit as stop:
        print(problem("The board was not restarted.", str(stop.code),
                      "Restart it yourself with: facilitator restart", blank=True),
              file=sys.stderr)
        return False
    return True


def cmd_update_steps(args):
    """Run by the pulled code: sync the .venv, run pending steps, restart if due, report the versions."""
    words = args[1:]
    pulled = "--pulled" in words
    old_version = words[words.index("--from-version") + 1] if "--from-version" in words[:-1] else None
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(line_buffering=True)

    try:
        stopped = ensure_env(ensure_uv(quiet=True), quiet=True)

        section("2. Update steps")
        print("Numbered steps in the updates folder run once each, in order.\n"
              "A step that fails stops the update and runs again next time.\n")
        run_update_steps()
    except SystemExit as stop:
        if (pulled or env_stopped_board) and isinstance(stop.code, str):
            stop.code += ("\n  The board was not restarted. Once the update goes through, run:"
                          " facilitator restart")
        raise

    section("3. Board")
    restarted = restart_board(pulled, stopped)

    new_version = board_version()
    green = style("38;2;0;114;0", "✦")
    print()
    if pulled:
        print(f"{green} Facilitator updated.\n")
        print(f"Old version: {old_version or 'unknown'}")
        print(f"New version: {new_version}\n")
        print("Reload the board in your browser and reopen the phone app.\n")
    else:
        print(f"{green} Already up to date ({new_version}).\n")
    if not restarted:
        sys.exit(1)


def main():
    args = sys.argv[1:]
    cmd = args[0] if args and not args[0].startswith("-") else "run"
    if cmd == "run":
        cmd_run(args)
    elif cmd == "restart":
        cmd_restart(args)
    elif cmd == "stop":
        cmd_stop(args)
    elif cmd == "status":
        cmd_status()
    elif cmd == "bridge":
        cmd_bridge(args)
    elif cmd == "password":
        if args == ["password", "set"]:
            on_app_env()
        cmd_password(args)
    elif cmd == "_password-setup" and os.environ.get("FACILITATOR_INTERNAL_INSTALL") == "1":
        on_app_env()
        cmd_password(args, installer=True)
    elif cmd == "_install" and os.environ.get("FACILITATOR_INTERNAL_INSTALL") == "1":
        cmd_install(args)
    elif cmd == "uninstall":
        cmd_uninstall(args)
    elif cmd == "update":
        cmd_update(args)
    elif cmd == "_update-steps" and os.environ.get("FACILITATOR_INTERNAL_UPDATE") == "1":
        cmd_update_steps(args)
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main()
