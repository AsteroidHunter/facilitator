#!/usr/bin/env python3
"""facilitator: board CLI.

  facilitator run [--attach] [--spawn] [--force] [--dry-run]
      start the server and the app window. That is all it touches by default:
      uncovered lanes are only REPORTED, with the attach instruction printed
      for pasting. --attach types that instruction into the lane's existing
      tmux claude (send-keys); --spawn additionally creates a fresh session
      for lanes with no reachable one. --force ignores the lane-covered guard.
  facilitator status
      one-line board state
  facilitator bridge [--dry-run]
      publish the board on this Mac's Tailscale name over HTTPS, through
      Tailscale Serve, print a QR code that opens the phone page (/m), and
      keep the terminal open: Ctrl-C, or the terminal closing, switches the
      sharing off again, and every run first clears what an earlier one left.
      The server keeps listening on 127.0.0.1 only; Tailscale does the
      proxying, and being on the tailnet is the whole of the access control.
      Needs HTTPS certificates switched on once for the tailnet, in the
      Tailscale admin console; says so and stops when they are off.
      --dry-run prints the commands instead of running them

Reads run.config.json beside this script: machine-local and gitignored, since
lanes name real directories and tmux sessions; copy run.config.example.json
and fill it in. This script is Python stdlib only. The server needs uvicorn
and starlette, installed once into a .venv beside it:

    python3 -m venv .venv && .venv/bin/pip install -r requirements.txt

run starts the server with that .venv's python when the folder is there, and
with its own interpreter otherwise.
"""

import json
import os
import shlex
import shutil
import signal
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
CONFIG = HERE / "run.config.json"
RETIRED_OWNERS = frozenset({"triage"})
# the Mac app keeps its command line inside the bundle and off PATH
TAILSCALE_APP = "/Applications/Tailscale.app/Contents/MacOS/Tailscale"
# What ends the bridge: Ctrl-C, a plain kill, the terminal closing, and Ctrl-Z.
# Ctrl-Z is here because its default is worse than useless on this command: it
# suspends the process with the tailnet share still on, and nothing is left to
# switch it off. Held like the rest, it becomes a clean stop.
STOP_SIGNALS = frozenset({signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGTSTP})
# the bridge's own dated file, beside the server's, worked out from this script's
# place the way the server works out its own; the variable moves the folder
LOG_DIR = Path(os.environ.get("FACILITATOR_LOG_DIR")
               or (HERE.parent / "facilitator-internal" / "logs"))
LOG_KEEP = 30   # dated bridge files kept, oldest deleted


def bridge_log(kind, level="info", **fields):
    """One line about the share going up or coming down, in the same shape the
    server writes: a UTC stamp with the date in it, a level, a kind, then that
    kind's own fields. Written here rather than through the server's logger
    because the bridge is its own process and importing the server would open
    the server's file as a side effect. It never raises: the sharing is the job
    and the note about it is not worth failing over.

    The tailnet name is deliberately not among the fields. It is on the terminal
    and in the code the phone scans, where it is the point; in a file that
    outlives the run it is a machine's name and nothing needs it."""
    try:
        LOG_DIR.mkdir(parents=True, exist_ok=True)
        now = time.time()
        line = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(now))
                      + f".{int(now % 1 * 1000):03d}Z",
                "level": level, "kind": kind}
        line.update({name: value for name, value in fields.items() if value is not None})
        with (LOG_DIR / f"bridge-{time.strftime('%Y%m%d')}.log").open("a") as f:
            f.write(json.dumps(line) + "\n")
        for old in sorted(LOG_DIR.glob("bridge-*.log"))[:-LOG_KEEP]:
            old.unlink(missing_ok=True)
    except OSError:
        pass


def load_config():
    if not CONFIG.exists():
        sys.exit(f"no {CONFIG.name} beside the script; copy run.config.example.json and fill in real lanes")
    cfg = json.loads(CONFIG.read_text())
    retired = sorted({lane.get("owner") for lane in cfg.get("lanes", [])
                      if isinstance(lane, dict) and lane.get("owner") in RETIRED_OWNERS})
    if retired:
        names = ", ".join(repr(owner) for owner in retired)
        sys.exit(f"{CONFIG.name} requires owner migration: retired owner {names} is not allowed")
    return cfg


def state(port, timeout=2):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/state", timeout=timeout) as f:
            return json.load(f)
    except OSError:
        return None


def server_python():
    """The interpreter the server runs under: the .venv beside this script,
    which is where requirements.txt is installed, or this process's own when
    there is no such folder (a machine whose interpreter already has the
    server's libraries)."""
    venv = HERE / ".venv" / "bin" / "python3"
    return str(venv) if os.access(venv, os.X_OK) else sys.executable


def ensure_server(port, dry):
    """Start the server, with its output going nowhere.

    The server writes its own dated file and that file is the only place its
    output lands; a copy of the same events caught here would be the same log
    twice, in two shapes, in two places. The one thing the file cannot hold is
    a start that dies before the logger exists, since nothing is open to write
    it: a child that is gone this early gets one sentence saying so and how to
    see it, which is running the server by hand where the terminal shows it."""
    if state(port):
        print(f"server: already up on {port}")
        return
    if dry:
        print(f"server: would start {HERE / 'server.py'}")
        return
    started = subprocess.Popen([server_python(), str(HERE / "server.py")],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                               start_new_session=True)
    for _ in range(40):
        if state(port):
            print(f"server: started on {port}")
            return
        if started.poll() is not None:
            sys.exit(f"the server did not start; run python3 {HERE / 'server.py'} "
                     "by hand to see why")
        time.sleep(0.25)
    sys.exit(f"server failed to come up on {port}; see the day's server file in {LOG_DIR}")


def open_app(cfg, dry):
    url = cfg.get("app_url") or f"http://127.0.0.1:{cfg['port']}"
    if dry:
        print(f"window: would open {url} as a chromeless app window")
        return
    subprocess.run(["open", "-na", "Google Chrome", "--args", f"--app={url}"], check=False)
    print("window: opened")


def lane_covered(st, owner):
    """True when some agent has this lane: attached right now, mid-claim, or
    heard from within 30 min (between long-poll cycles listening reads false)."""
    if st is None:
        return False
    if st["listening"].get(owner) or st["busy"].get(owner):
        return True
    return st["listenerGap"].get(owner, 9e9) < 1800


def claude_pane(name):
    """Pane id of the claude running anywhere inside tmux session `name`.
    None = no such session; "" = session exists but no claude pane."""
    if not shutil.which("tmux"):
        return None
    r = subprocess.run(["tmux", "list-panes", "-s", "-t", name,
                        "-F", "#{pane_id} #{pane_current_command}"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None
    for line in r.stdout.splitlines():
        pid, _, cmd = line.partition(" ")
        if cmd.startswith("claude") or cmd == "node":
            return pid
    return ""


def instruct(lane, dry):
    """Type the attach instruction into the claude PANE of the lane's tmux
    session (a session's active pane may be a bare shell; the claude can live
    in any pane). Verifies the text landed before pressing Enter. Returns True
    if delivered. Never types into a shell."""
    name, text = lane.get("tmux"), lane["instruction"]
    if not name:
        return False
    pane = claude_pane(name)
    if pane is None:
        print(f"listener {lane['owner']}: tmux session {name} not found")
        return False
    if not pane:
        print(f"listener {lane['owner']}: no claude pane inside tmux {name}; not typing into shells")
        return False
    if dry:
        print(f"listener {lane['owner']}: would send the attach instruction to tmux {name} pane {pane}")
        return True
    subprocess.run(["tmux", "send-keys", "-t", pane, "-l", text], check=True)
    time.sleep(1)
    seen = subprocess.run(["tmux", "capture-pane", "-p", "-t", pane],
                          capture_output=True, text=True).stdout
    if text[:40] not in seen:
        print(f"listener {lane['owner']}: instruction did not land in pane {pane}; Enter NOT pressed")
        return False
    subprocess.run(["tmux", "send-keys", "-t", pane, "Enter"], check=True)
    print(f"listener {lane['owner']}: instructed the claude in tmux {name} (pane {pane})")
    return True


def spawn(lane, dry):
    """Create a FRESH claude session for the lane (only ever on --spawn)."""
    owner, d, prompt = lane["owner"], str(Path(lane["dir"]).expanduser()), lane["prompt"]
    if dry:
        print(f"listener {owner}: would spawn a NEW claude session in {d}")
        return
    if shutil.which("tmux"):
        name = f"facil-{owner}"
        if subprocess.run(["tmux", "has-session", "-t", name], capture_output=True).returncode == 0:
            print(f"listener {owner}: tmux session {name} already exists; attach with: tmux attach -t {name}")
            return
        subprocess.run(["tmux", "new-session", "-d", "-s", name, "-c", d, "claude", prompt], check=True)
        term_cmd = f"tmux attach -t {name}"
        how = f"tmux {name}"
    else:
        term_cmd = f"cd {shlex.quote(d)} && claude {shlex.quote(prompt)}"
        how = "terminal window"
    esc = term_cmd.replace("\\", "\\\\").replace('"', '\\"')
    subprocess.run(["osascript",
                    "-e", f'tell application "Terminal" to do script "{esc}"',
                    "-e", 'tell application "Terminal" to activate'], check=False)
    print(f"listener {owner}: spawned NEW session ({how})")


def cmd_run(args):
    """Server and window only, by default. The CLI never touches tmux unless
    asked: --attach types the instruction into existing lane sessions, --spawn
    creates fresh ones. Without either it just reports each lane's state."""
    cfg = load_config()
    dry = "--dry-run" in args
    force = "--force" in args
    do_spawn = "--spawn" in args
    do_attach = "--attach" in args or do_spawn
    ensure_server(cfg["port"], dry)
    open_app(cfg, dry)
    st = state(cfg["port"])
    for lane in cfg["lanes"]:
        ow = lane["owner"]
        if not force and lane_covered(st, ow):
            if st["busy"].get(ow):
                why = f"mid-claim on box {st['busy'][ow]}"
            elif st["listening"].get(ow):
                why = "attached right now"
            else:
                why = f"heard {round(st['listenerGap'].get(ow, 0) / 60)} min ago"
            print(f"listener {ow}: lane covered ({why})")
            continue
        if not do_attach:
            print(f"listener {ow}: not attached. Tell that agent to start listening, or\n"
                  f"  rerun with --attach to type the instruction into its tmux session:\n"
                  f"  {lane['instruction']}")
            continue
        if instruct(lane, dry):
            continue
        if do_spawn:
            spawn(lane, dry)
        else:
            print(f"listener {ow}: no reachable session. Paste this into the right claude yourself,\n"
                  f"  or rerun with --spawn to create a fresh session:\n"
                  f"  {lane['instruction']}")


def cmd_status():
    cfg = load_config()
    st = state(cfg["port"])
    if st is None:
        sys.exit(f"server: DOWN (port {cfg['port']})")
    lanes = ", ".join(
        f"{ow}: " + ("attached" if st["listening"][ow]
                     else f"last heard {round(st['listenerGap'][ow] / 60)}m ago")
        for ow in st["listening"])
    print(f"server up, {len(st['boxes'])} boxes, {st['queued']} queued"
          + (", PAUSED" if st.get("paused") else "") + f" | {lanes}")


def board_port():
    """The board's port from run.config.json when there is one; the server's
    own default otherwise, so the bridge works on a machine with no lanes
    written down yet."""
    if not CONFIG.exists():
        return 8877
    try:
        return int(json.loads(CONFIG.read_text()).get("port") or 8877)
    except (ValueError, TypeError, OSError):
        return 8877


def find_tailscale():
    """The tailscale command line: PATH first, then inside the Mac app."""
    found = shutil.which("tailscale")
    if found:
        return found
    if os.access(TAILSCALE_APP, os.X_OK):
        return TAILSCALE_APP
    return None


def tailscale_status(ts):
    """tailscale status as a dict, read only; exits with one line on any
    failure to get it."""
    try:
        r = subprocess.run([ts, "status", "--json"], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        sys.exit(f"tailscale: could not run status ({e})")
    if r.returncode != 0:
        sys.exit("tailscale: status failed: " + (r.stderr or r.stdout).strip())
    try:
        return json.loads(r.stdout)
    except ValueError:
        sys.exit("tailscale: status did not answer with json")


def show_qr(url):
    """The address as a code the phone camera reads, block characters two
    module rows per line, with the address itself printed on its own line
    under it: beside a row it ran past a narrow terminal's width, and the
    wrapped tail was drawn inside the code as an extra row. On a terminal
    the modules are painted black on white whatever the theme, so the code
    is never inverted; piped, the bare characters are printed."""
    sys.path.insert(0, str(HERE))
    import qr
    lines = qr.render(qr.encode(url))
    tty = sys.stdout.isatty()
    for line in lines:
        body = ("\x1b[30;107m" + line + "\x1b[0m") if tty else line
        print("  " + body)
    print("  " + url)


def show_way_in(url):
    """The phone page's address, its code, and what to do with it."""
    print(f"phone page: {url}")
    print()
    show_qr(url)
    print()
    print("scan it with the phone camera; add the page to the home screen and use its Notifications button for pushes")


def serve_reset(ts):
    """Switch the Tailscale sharing off. Returns why it could not, or an
    empty string when it did."""
    try:
        r = subprocess.run([ts, "serve", "reset"], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        return str(e)
    if r.returncode == 0:
        return ""
    return (r.stderr or r.stdout).strip() or f"exit code {r.returncode}"


def cmd_bridge(args):
    """Publish the board through Tailscale Serve, print the way in, and keep
    the terminal open until Ctrl-C (or a kill, or the terminal closing)
    switches the sharing off again. The server keeps binding 127.0.0.1;
    Tailscale terminates HTTPS on the Mac's tailnet name and proxies to it,
    and nothing outside the tailnet can reach either. HTTPS is what lets a
    phone install the page and receive pushes, and Tailscale only issues
    certificates once HTTPS is switched on for the tailnet, which is a one
    time change in its admin console."""
    dry = "--dry-run" in args
    port = board_port()
    if state(port) is None:
        sys.exit(f"server: DOWN (port {port}); run facilitator run first")
    ts = find_tailscale()
    if ts is None:
        sys.exit("tailscale: not found on PATH or at " + TAILSCALE_APP)
    st = tailscale_status(ts)
    if st.get("BackendState") != "Running":
        sys.exit(f"tailscale: not connected (state {st.get('BackendState')})")
    name = ((st.get("Self") or {}).get("DNSName") or "").rstrip(".")
    if not name:
        sys.exit("tailscale: this Mac has no tailnet name yet; switch on MagicDNS in the Tailscale admin console")
    if not st.get("CertDomains"):
        sys.exit("Tailscale HTTPS is off for this tailnet: switch on HTTPS certificates under DNS in the Tailscale admin console, then run facilitator bridge again.")
    cmd = [ts, "serve", "--bg", "--https=443", f"http://127.0.0.1:{port}"]
    shown = " ".join(shlex.quote(c) for c in cmd)
    shown_reset = f"{shlex.quote(ts)} serve reset"
    url = f"https://{name}/m"
    if dry:
        print(f"serve: would run {shown_reset}")
        print(f"serve: would run {shown}")
        show_way_in(url)
        print(f"would then wait for Ctrl-C and run {shown_reset}")
        return
    # From here on Ctrl-C, a kill, and the terminal closing are held back and
    # picked up by the wait below, so none of them can end the process with
    # the sharing left on. The tailscale calls inherit the hold, so a second
    # Ctrl-C cannot cut the reset short either; it is simply dropped. A signal
    # set to be ignored is dropped instead of held, and a shell starts its
    # background jobs with Ctrl-C ignored, so each one gets its default back.
    signal.pthread_sigmask(signal.SIG_BLOCK, STOP_SIGNALS)
    for s in STOP_SIGNALS:
        signal.signal(s, signal.SIG_DFL)
    stop = None
    try:
        why = serve_reset(ts)  # whatever an earlier run left on
        if why:
            sys.exit("tailscale serve reset failed: " + why)
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
        except (OSError, subprocess.TimeoutExpired) as e:
            sys.exit(f"tailscale serve failed to run ({e})")
        if r.returncode != 0:
            sys.exit("tailscale serve failed: " + (r.stderr or r.stdout).strip())
        print(f"serve: ran {shown}")
        bridge_log("shareon", port=port)
        for line in (r.stdout or "").strip().splitlines():
            print("  " + line)
        show_way_in(url)
        print("press Ctrl-C to stop sharing")
        sys.stdout.flush()
        stop = signal.sigwait(STOP_SIGNALS)
    finally:
        why = serve_reset(ts)  # the one reset after the serve, on every way out
        bridge_log("shareoff", level="error" if why else "info",
                   reason=signal.Signals(stop).name if stop else "ended",
                   failed=why or None)
    try:
        if stop == signal.SIGINT:
            print()  # the terminal echoed ^C on the current line
        if why:
            sys.exit(f"sharing may still be on: tailscale serve reset failed: {why}; run {shown_reset} yourself")
        print("sharing off")
    except OSError:
        pass  # the terminal is gone (SIGHUP); nobody is reading


def main():
    args = sys.argv[1:]
    cmd = args[0] if args and not args[0].startswith("-") else "run"
    if cmd == "run":
        cmd_run(args)
    elif cmd == "status":
        cmd_status()
    elif cmd == "bridge":
        cmd_bridge(args)
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main()
