#!/usr/bin/env python3
"""facilitator: board CLI.

  facilitator run [--attach] [--spawn] [--force] [--dry-run]
      start the server and the app window. That is all it touches by default:
      uncovered lanes are only REPORTED, with the attach instruction printed
      for pasting. --attach types that instruction into the lane's existing
      tmux claude (send-keys); --spawn additionally creates a fresh session
      for lanes with no reachable one. --force ignores the lane-covered guard.
  facilitator status
      one-line board state

Reads run.config.json beside this script: machine-local and gitignored, since
lanes name real directories and tmux sessions; copy run.config.example.json
and fill it in. Python stdlib only, like the server.
"""

import json
import shlex
import shutil
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
CONFIG = HERE / "run.config.json"
LOG = "/tmp/facilitator-8877.log"
RETIRED_OWNERS = frozenset({"triage"})


def load_config():
    if not CONFIG.exists():
        sys.exit(f"no {CONFIG.name} beside the script; copy run.config.example.json and fill in real lanes")
    cfg = json.loads(CONFIG.read_text())
    retired = sorted({lane.get("owner") for lane in cfg.get("lanes", [])
                      if isinstance(lane, dict) and lane.get("owner") in RETIRED_OWNERS})
    if retired:
        names = ", ".join(repr(owner) for owner in retired)
        sys.exit(f"{CONFIG.name} requires owner migration: retired owner {names} is not allowed")
    return cfg


def state(port, timeout=2):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/state", timeout=timeout) as f:
            return json.load(f)
    except OSError:
        return None


def ensure_server(port, dry):
    if state(port):
        print(f"server: already up on {port}")
        return
    if dry:
        print(f"server: would start {HERE / 'server.py'}")
        return
    subprocess.Popen([sys.executable, str(HERE / "server.py")],
                     stdout=open(LOG, "ab"), stderr=subprocess.STDOUT,
                     start_new_session=True)
    for _ in range(40):
        if state(port):
            print(f"server: started on {port} (log: {LOG})")
            return
        time.sleep(0.25)
    sys.exit(f"server failed to come up; see {LOG}")


def open_app(cfg, dry):
    url = cfg.get("app_url") or f"http://127.0.0.1:{cfg['port']}"
    if dry:
        print(f"window: would open {url} as a chromeless app window")
        return
    subprocess.run(["open", "-na", "Google Chrome", "--args", f"--app={url}"], check=False)
    print("window: opened")


def lane_covered(st, owner):
    """True when some agent has this lane: attached right now, mid-claim, or
    heard from within 30 min (between long-poll cycles listening reads false)."""
    if st is None:
        return False
    if st["listening"].get(owner) or st["busy"].get(owner):
        return True
    return st["listenerGap"].get(owner, 9e9) < 1800


def claude_pane(name):
    """Pane id of the claude running anywhere inside tmux session `name`.
    None = no such session; "" = session exists but no claude pane."""
    if not shutil.which("tmux"):
        return None
    r = subprocess.run(["tmux", "list-panes", "-s", "-t", name,
                        "-F", "#{pane_id} #{pane_current_command}"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None
    for line in r.stdout.splitlines():
        pid, _, cmd = line.partition(" ")
        if cmd.startswith("claude") or cmd == "node":
            return pid
    return ""


def instruct(lane, dry):
    """Type the attach instruction into the claude PANE of the lane's tmux
    session (a session's active pane may be a bare shell; the claude can live
    in any pane). Verifies the text landed before pressing Enter. Returns True
    if delivered. Never types into a shell."""
    name, text = lane.get("tmux"), lane["instruction"]
    if not name:
        return False
    pane = claude_pane(name)
    if pane is None:
        print(f"listener {lane['owner']}: tmux session {name} not found")
        return False
    if not pane:
        print(f"listener {lane['owner']}: no claude pane inside tmux {name}; not typing into shells")
        return False
    if dry:
        print(f"listener {lane['owner']}: would send the attach instruction to tmux {name} pane {pane}")
        return True
    subprocess.run(["tmux", "send-keys", "-t", pane, "-l", text], check=True)
    time.sleep(1)
    seen = subprocess.run(["tmux", "capture-pane", "-p", "-t", pane],
                          capture_output=True, text=True).stdout
    if text[:40] not in seen:
        print(f"listener {lane['owner']}: instruction did not land in pane {pane}; Enter NOT pressed")
        return False
    subprocess.run(["tmux", "send-keys", "-t", pane, "Enter"], check=True)
    print(f"listener {lane['owner']}: instructed the claude in tmux {name} (pane {pane})")
    return True


def spawn(lane, dry):
    """Create a FRESH claude session for the lane (only ever on --spawn)."""
    owner, d, prompt = lane["owner"], str(Path(lane["dir"]).expanduser()), lane["prompt"]
    if dry:
        print(f"listener {owner}: would spawn a NEW claude session in {d}")
        return
    if shutil.which("tmux"):
        name = f"facil-{owner}"
        if subprocess.run(["tmux", "has-session", "-t", name], capture_output=True).returncode == 0:
            print(f"listener {owner}: tmux session {name} already exists; attach with: tmux attach -t {name}")
            return
        subprocess.run(["tmux", "new-session", "-d", "-s", name, "-c", d, "claude", prompt], check=True)
        term_cmd = f"tmux attach -t {name}"
        how = f"tmux {name}"
    else:
        term_cmd = f"cd {shlex.quote(d)} && claude {shlex.quote(prompt)}"
        how = "terminal window"
    esc = term_cmd.replace("\\", "\\\\").replace('"', '\\"')
    subprocess.run(["osascript",
                    "-e", f'tell application "Terminal" to do script "{esc}"',
                    "-e", 'tell application "Terminal" to activate'], check=False)
    print(f"listener {owner}: spawned NEW session ({how})")


def cmd_run(args):
    """Server and window only, by default. The CLI never touches tmux unless
    asked: --attach types the instruction into existing lane sessions, --spawn
    creates fresh ones. Without either it just reports each lane's state."""
    cfg = load_config()
    dry = "--dry-run" in args
    force = "--force" in args
    do_spawn = "--spawn" in args
    do_attach = "--attach" in args or do_spawn
    ensure_server(cfg["port"], dry)
    open_app(cfg, dry)
    st = state(cfg["port"])
    for lane in cfg["lanes"]:
        ow = lane["owner"]
        if not force and lane_covered(st, ow):
            if st["busy"].get(ow):
                why = f"mid-claim on box {st['busy'][ow]}"
            elif st["listening"].get(ow):
                why = "attached right now"
            else:
                why = f"heard {round(st['listenerGap'].get(ow, 0) / 60)} min ago"
            print(f"listener {ow}: lane covered ({why})")
            continue
        if not do_attach:
            print(f"listener {ow}: not attached. Tell that agent to start listening, or\n"
                  f"  rerun with --attach to type the instruction into its tmux session:\n"
                  f"  {lane['instruction']}")
            continue
        if instruct(lane, dry):
            continue
        if do_spawn:
            spawn(lane, dry)
        else:
            print(f"listener {ow}: no reachable session. Paste this into the right claude yourself,\n"
                  f"  or rerun with --spawn to create a fresh session:\n"
                  f"  {lane['instruction']}")


def cmd_status():
    cfg = load_config()
    st = state(cfg["port"])
    if st is None:
        sys.exit(f"server: DOWN (port {cfg['port']})")
    lanes = ", ".join(
        f"{ow}: " + ("attached" if st["listening"][ow]
                     else f"last heard {round(st['listenerGap'][ow] / 60)}m ago")
        for ow in st["listening"])
    print(f"server up, {len(st['boxes'])} boxes, {st['queued']} queued"
          + (", PAUSED" if st.get("paused") else "") + f" | {lanes}")


def main():
    args = sys.argv[1:]
    cmd = args[0] if args and not args[0].startswith("-") else "run"
    if cmd == "run":
        cmd_run(args)
    elif cmd == "status":
        cmd_status()
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main()
