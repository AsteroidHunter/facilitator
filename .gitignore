# runtime discussion data: the owner's live board, not source
/state.json
/state.json.bak-*
/state.tmp
/transcript.jsonl
# held by the running server: one per folder, naming its pid and port
/server.lock
# the desktop pages' settings and the Spotify sign-in, kept beside state.json
/settings.json
/settings.json.tmp
/settings.json.bad-*

# the phone page's push signing key pair: made by openssl on first need, private
/vapid-key.pem
/bridge-auth.json
/bridge-auth.lock

# machine-local lane config: names real project directories
/run.config.json

# the home page's token counts, per log file, made by tokens.py on first need
/tokens-cache.json
/tokens-cache.json.tmp

# Claude Code's plan limits for the home page, written by claude-statusline.py
/claude-limits.json
/claude-limits.json.tmp

# real seed content: private discussion topics, never committed
/seed.json

# dropped images: runtime discussion content, never committed
/uploads/

# probe tooling deps, if ever installed beside probe3.js
/node_modules/
/package.json
/package-lock.json

# the server's libraries, installed beside it from requirements.txt
/.venv/
/.facilitator-install.json
/.facilitator-skills.json
/.facilitator-skills.tmp
/.facilitator-statusline.json
/.facilitator-statusline.tmp

# which numbered update steps have run in this checkout, written by facilitator update
/.facilitator-updates.json
/.facilitator-updates.tmp

.DS_Store
__pycache__/
