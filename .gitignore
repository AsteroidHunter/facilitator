# everything the board writes, in one folder at the top of the checkout:
# cards, history, settings, profile, run.config.json, seed.json, attachments,
# logs, magic boxes, the push key, phone sign-in, caches, records, the lock,
# backups and the server's .venv. Never source, never committed
/data/

# the packages only the tests need, installed by ./install.sh --dev
/app/tests/node_modules/

# a lane whose folder is this checkout keeps its panel and navigator notes here
/facilitator-internal/
/facilitator-wiki/

# probe tooling deps, if ever installed at the top
/node_modules/
/package.json
/package-lock.json

.DS_Store
__pycache__/

# Where the board kept its files before they moved into data/. A checkout that
# has pulled but not yet run facilitator update still has them at its top, and
# they must never show up as new files there.
/state.json
/state.json.bak-*
/state.tmp
/transcript.jsonl
/server.lock
/settings.json
/settings.json.tmp
/settings.json.bad-*
/vapid-key.pem
/bridge-auth.json
/bridge-auth.lock
/.bridge-auth-*
/run.config.json
/run.config.json.tmp
/tokens-cache.json
/tokens-cache.json.tmp
/claude-limits.json
/claude-limits.json.tmp
/usage-counts.json
/usage-counts.json.tmp
/usage-install.json
/usage-install.json.tmp
/profile.json
/profile.json.tmp
/seed.json
/uploads/
/magic-boxes/
/tests/node_modules/
/.venv/
/.facilitator-install.json
/.facilitator-skills.json
/.facilitator-skills.tmp
/.facilitator-statusline.json
/.facilitator-statusline.tmp
/.facilitator-updates.json
/.facilitator-updates.tmp
